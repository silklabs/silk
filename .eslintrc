{
  "parser": "babel-eslint",
  "globals": {
    "suite": true,
    "test": true,
    "setup": true,
    "teardown": true,
    "suiteSetup": true,
    "suiteTeardown": true,
    "it": true,
    "describe": true,
  },
  "extends": "eslint:recommended",
  "rules": {
    // Turn off 1.0 rules we are violating for now...
    "no-extra-semi": 0,
    "no-console": 0,
    // Our extra rules...
    "semi": 1,
    "brace-style": 2,
    "no-debugger": 1,
    "default-case": 2,
    "comma-dangle": 0,
    "indent": [
      2,
      2
    ],
    "no-underscore-dangle": 0,
    "strict": 1,
    "quotes": [
      2,
      "single",
      "avoid-escape"
    ],
    "yoda": 0
  },
  "env": {
    "node": true,
    "es6": true
  },
  "ecmaFeatures": {
    // We need to explicitly enable modules...
    modules: true
  }
}

