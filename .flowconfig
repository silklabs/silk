[include]
flow-interface/
node_modules/
pub/node_modules/
pub/sdk/interface/
pub/bsp-gonk/vendor/silk/
device/vendor/silk/ext/

[libs]
flow-lib/
node_modules/react-native/Libraries/react-native/react-native-interface.js
node_modules/fbjs/flow/lib/

[ignore]
# Ignore test files in dependencies that trip up the Flow parser
.*/node_modules/config-chain/test/.*
.*/node_modules/json5/test/.*
.*/node_modules/read-package-tree/test/.*
.*/node_modules/node-inspector/.*
.*/node_modules/protobufjs/.*

# Ignore all sorts of dev dependencies that our code never imports
# and doesn't need to get type checked against.
.*/node_modules/babel.*
.*/node_modules/bower.*
.*/node_modules/.*browserify.*
.*/node_modules/eslint.*
.*/node_modules/gulp.*
.*/node_modules/npm.*

# Ignore build artifacts
.*/dist/.*
.*/device/out/.*
.*/device/external/.*
.*/pub/docs/build/.*

# Ignore browserify reimplementations of core node modules.
.*/node_modules/events/.*

.*/server/tmp/.*

# Prefer JS implementations over their interface files. We do need to
# use interface files, however, when modules are implemented in native.
# TODO: investigate moving e.g. silk-alog.js.flow to silk-alog/index.js.flow
.*/pub/bsp-gonk/vendor/silk/silk-alog/.*
.*/pub/bsp-gonk/vendor/silk/silk-properties/.*
.*/pub/bsp-gonk/vendor/silk/silk-movie/.*
.*/pub/sdk/interface/silk-wifi.js.flow
.*/pub/sdk/interface/silk-sysutils.js.flow

# For some reason Flow doesn't recognize the 'mp4box' module, so we
# provide an interface definition for it in flow-interface/. Just to
# be on the safe side, we'll also ignore the installed module here.
.*/node_modules/mp4box/.*

# For some reason we can't just let Flow look at node_modules/react-native.
# It spews hundreds of errors related to module imports, likely due to Haste
# vs. node modules. So we tell Flow to ignore node_modules/react-native and
# provide a minimal declaration in flow-lib/react-native.js.flow.
.*/node_modules/react-native/.*

# Ignore the native modules whose interface files are present in top
# level flow-interfaces.
.*/device/vendor/propsilk/silk-caffe/.*
.*/device/vendor/propsilk/silk-cv/.*
.*/node_modules/ws/.*

# Ignore huge projects with minimal or no JS.
.*/node-webrtc/build-staging/.*
.*/svm/models/.*

[options]
unsafe.enable_getters_and_setters=true
module.system=haste
module.use_strict=true
module.file_ext=.js
module.file_ext=.json
module.file_ext=.ios.js
module.name_mapper.extension='png' -> '<PROJECT_ROOT>/app/src/image_stub.js.flow'
esproposal.class_instance_fields=ignore
esproposal.class_static_fields=ignore
suppress_type=$FlowIssue
suppress_type=$FlowFixMe
suppress_comment= \\(.\\|\n\\)*\\$FlowFixMe

[version]
0.32.0
