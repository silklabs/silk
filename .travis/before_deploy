#!/bin/bash

if [[ $TRAVIS_PULL_REQUEST != false ]] && [[ $GONK != mako ]]; then
  echo Nothing to do. If Travis CI PRs could have a different matrix than
  echo builds then you would not be reading this message.
  exit 0
fi

set -ex
source build/envsetup.sh
rm -rf $ANDROID_PRODUCT_OUT/obj/ # Reclaim some disk space or Travis will error out
./gonk/archive.sh $TRAVIS_BRANCH $GONK dist

if [[ $GONK != qemu ]]; then
  mv -v $ANDROID_PRODUCT_OUT/*ota*.zip dist/
  ./gonk/ota_manifest.sh $TRAVIS_BRANCH $ANDROID_PRODUCT_OUT/system/build.prop dist
fi
