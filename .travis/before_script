#!/bin/bash

set -ex
ccache -s
git --version

case $GONK in
base)
  # No initialization needed for "base" builds.
  ;;
*)
  time make init.$GONK
  ;;
esac

time make sync
cp -v $(which ccache) prebuilts/misc/linux-x86/ccache/ccache
time CI_PATCHTREE_FORCE=force make nothing # Applies patches as a side effect of doing nothing...

# Reduce the disk space usage to avoid failures later on during full
# builds
if [[ $GONK != base ]]; then
  if [[ -n $UPDATE_LOCKED_NODE_MODULES ]]; then
    mv .repo/project-objects/silk-device-locked-node-modules.git .repo/
    mv .repo/projects/vendor/silk/locked_node_modules/node_modules.git .repo/
  fi

  rm -rf \
    .repo/project-objects \
    .repo/projects \

  rm -rf \
    frameworks/base/core \
    frameworks/base/data/fonts \
    frameworks/base/data/sounds \
    frameworks/base/data/videos \
    frameworks/base/docs \
    frameworks/base/media/java \
    frameworks/base/media/mca \
    frameworks/base/media/tests \
    frameworks/base/packages \
    frameworks/base/tests \
    prebuilts/android-emulator/windows \
    prebuilts/qemu-kernel/{mips,x86,x86_64} \
    prebuilts/misc/{android-mips,android-mips64,android-x86,android-x86_64,darwin-x86,windows} \

  find prebuilts/ndk -type d -name arch-mips -o -name arch-mips64 -o -name arch-x86 -o -name arch-x86_64 | xargs rm -rf

  if [[ -n $UPDATE_LOCKED_NODE_MODULES ]]; then
    mkdir -p .repo/project-objects .repo/projects/vendor/silk/locked_node_modules
    mv .repo/silk-device-locked-node-modules.git .repo/project-objects/
    mv .repo/node_modules.git .repo/projects/vendor/silk/locked_node_modules/
  fi
fi

df -h
du -hs * .repo
du -hs .
