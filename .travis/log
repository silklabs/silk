#! /bin/bash

LOGFILE=.artifacts/build-$GONK.log

# Helper to print dots to stdout so travis does not hate us...
function keep_alive {
   while true; do
      echo -n "."
      sleep 10
   done
}

keep_alive &
keep_alive_pid=$!
/bin/bash -c "$@" > $LOGFILE 2>&1
exit_code=$?
kill $keep_alive_pid
wait $keep_alive_pid 2>/dev/null

if [[ $exit_code -ne 0 ]]; then
  echo
  echo Error $exit_code: Build failed
  echo
  ( set -x; tail -n 2000 $LOGFILE )
fi

exit $exit_code
