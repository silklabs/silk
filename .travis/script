#!/bin/bash -ex

# Update locked_node_modules if needed before starting the build
./repo start $TRAVIS_BRANCH vendor/silk/locked_node_modules/node_modules
vendor/silk/locked_node_modules/update.sh

# With locked_node_modules primed there should be no npm registry activity
# during the build.
export NPM_CONFIG_REGISTRY=http://0.42.42.42.24/no/registry/for/you

# Only enable ccache logging for PR builds (base build) to help keep Travis disk
# usage down for full device builds.
if [[ $TRAVIS_PULL_REQUEST != false ]]; then
  export CCACHE_LOGFILE=$PWD/.artifacts/ccache-$GONK.log
fi

if [[ $GONK != base ]]; then
  if [[ $GONK == qemu ]]; then
    make -j2

    echo "******************************************************************"
    echo Emulator tests
    echo "******************************************************************"
    source build/envsetup.sh
    rm -rf $ANDROID_PRODUCT_OUT/obj/ # Reclaim some disk space or Travis will probably fail
    test/start_emulator -r run_tests

  else
    make -j2 otapackage
  fi
else
  make -j2

  source build/envsetup.sh
  rm -rf $ANDROID_PRODUCT_OUT/obj/ # Reclaim some disk space or Travis will probably fail

  if [[ $TRAVIS_OS_NAME == linux ]]; then
    echo "******************************************************************"
    echo Emulator tests
    echo "******************************************************************"
    make update.qemu # Fetch the emulator

    # Fetch host adb since it's not built as a part of the base build
    wget --retry-connrefused https://dl-ssl.google.com/android/repository/platform-tools_r23-linux.zip
    unzip platform-tools_r23-linux.zip
    export PATH=$PATH:$(readlink -f platform-tools)
    which adb

    test/start_emulator -r run_tests
  else
    echo Warning: Skipping emulator boot check on OS X for now
  fi

  if [[ $TRAVIS_OS_NAME == linux ]]; then  # We only support building Mako on Linux
    echo "******************************************************************"
    echo Validating Mako manifest
    echo "******************************************************************"
    make init.mako
  fi
fi

echo "******************************************************************"
echo Unit tests
echo "******************************************************************"
test/unit


# Only update locked_node_modules for one build in the entire OS/GONK
# build matrix.  It doesn't matter which one, "mako" seems nice
if [[ $TRAVIS_PULL_REQUEST == false ]] &&
   [[ $TRAVIS_OS_NAME == linux ]] &&
   [[ $GONK_SPEC == mako ]] ; then
  echo "******************************************************************"
  echo Update locked_node_modules
  echo "******************************************************************"
  push_branch=false
  if [[ $TRAVIS_PULL_REQUEST == false ]]; then
    for branch in master next chemspill; do
      if [ "$TRAVIS_BRANCH" = "$branch" ]; then
        push_branch=true
        break
      fi
    done
  fi

  if $push_branch; then
    pushd vendor/silk/locked_node_modules/node_modules
    git push silk $TRAVIS_BRANCH
    popd
  else
    echo "Will not push locked_node_modules for branch $TRAVIS_BRANCH"
  fi
fi

exit 0
