#!/bin/bash

if [[ $TRAVIS_PULL_REQUEST != false ]] && [[ $GONK != qemu ]]; then
  echo Nothing to do. If Travis CI PRs could have a different matrix than
  echo builds then you would not be reading this message.
  exit 0
fi

set -e
if [[ $TRAVIS_PULL_REQUEST == false ]]; then
  if [[ $GONK == qemu ]]; then
    make -j2

    echo "******************************************************************"
    echo Does the emulator even boot?
    echo "******************************************************************"
    source build/envsetup.sh
    rm -rf $ANDROID_PRODUCT_OUT/obj/ # Reclaim some disk space or Travis will probably fail
    test/emulator_boottest

  else
    make -j2 otapackage
  fi
else
  echo "******************************************************************"
  echo Build the PR with the "base" build
  echo "******************************************************************"
  make -j2

  echo "******************************************************************"
  echo Check if the PR boots on the emulator
  echo "******************************************************************"
  source build/envsetup.sh
  rm -rf $ANDROID_PRODUCT_OUT/obj/ # Reclaim some disk space or Travis will probably fail
  make update.qemu # Fetch the emulator

  # Fetch host adb since it's not built as a part of the base build
  wget https://dl-ssl.google.com/android/repository/platform-tools_r23-linux.zip
  unzip platform-tools_r23-linux.zip
  export PATH=$PATH:$(readlink -f platform-tools)
  which adb

  test/emulator_boottest

  echo "******************************************************************"
  echo Validating Mako manifest
  echo "******************************************************************"
  make init.mako
fi
