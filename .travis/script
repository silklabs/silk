#!/bin/bash

if [ "$TEST_TYPE" = lint ]; then
  npm run-script lint

elif [ "$TEST_TYPE" = objc-test ]; then
  xctool \
    -project $PROJECT.xcodeproj \
    -scheme $PROJECT \
    -sdk iphonesimulator \
    -destination 'platform=iOS Simulator,name=iPhone 5,OS=8.4' \
    test

elif [ "$TEST_TYPE" = build-dist ]; then
    export NODE_DEBUG=http

    mkdir build
    xctool \
      -project $PROJECT.xcodeproj \
      -scheme $PROJECT \
      -sdk iphoneos \
      archive -archivePath build/$PROJECT.xcarchive \
      CODE_SIGN_IDENTITY="$DEVELOPER_NAME" \
      PROVISIONING_PROFILE="$PROFILE_UUID"

    mkdir dist
    xcodebuild \
      -exportArchive \
      -archivePath build/$PROJECT.xcarchive \
      -exportPath dist/$PROJECT.ipa \
      -exportFormat ipa \
      -exportProvisioningProfile "$PROFILE_NAME"

else
  echo "Unknown test type: $TEST_TYPE"
  exit 1
fi
