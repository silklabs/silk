SHELL=/bin/bash

ENVSETUP=source build/envsetup.sh $(1) && test "$$SILK_ENVSETUP" == "1"

.PHONY: all
all: | .repo/.repo_fetchtimes.json
	$(ENVSETUP) && time $(MAKE) -f build/core/main.mk

.PHONY: install
install: | .repo/.repo_fetchtimes.json
	$(ENVSETUP) && \
  adb root && \
  adb wait-for-device && \
  adb remount && \
  adb sync

.PHONY: clean
clean:
	rm -rf out

# Kills "99.99%" of bugs.
# (Be very careful!)
.PHONY: purell
purell:
	rm -rf * && git reset --hard HEAD && ./repo sync -l

# https://youtu.be/1r_2fNiYkyE
# (Be certain!)
.PHONY: zest
zest:
	git reset --hard HEAD && git clean -dx -f -f

.PHONY: sync
sync: | .repo/manifest.xml
	./repo sync -j4 --current-branch --no-tags --force-sync --quiet

.PHONY: emu
emu:
	$(ENVSETUP) && \
  emulator -verbose -show-kernel $(EXTRA_EMULATOR_OPTS)
.PHONY: qemu
qemu: emu

.PHONY: update
update:
	mkdir -p out
	cd out/ && rm -rf mako.tgz aosp_mako
	cd out/ && wget https://s3-us-west-2.amazonaws.com/silk-device/master/latest/mako.tgz
	cd out/ && tar zxf mako.tgz
	out/aosp_mako/$(or $(FLASH_SCRIPT),flash.sh)

.PHONY: fut
fut: FLASH_SCRIPT=flash_fut.sh
fut: update

.PHONY: dist
dist: | .repo/manifest.xml
	$(call ENVSETUP,clean) # <-- drop all local patches before archiving
	$(call ENVSETUP,np) && ./gonk/archive.sh $(TARGET_PRODUCT)-$(shell date +%F_%H%M%S) dist

# Manipulate the silk service on device:
#
#  make silk-start
#  make silk-stop
#  make silk-restart
silk_service_targets := $(addprefix silk-, start stop restart)
.PHONY: $(silk_service_targets)
$(silk_service_targets):
	$(ENVSETUP) && \
  adb root && \
  adb wait-for-device && \
  adb shell setprop ctl.$(subst silk-,,$@) silk


# Set the device time
.PHONY: time
time:
	@echo Setting device time to match host
	$(ENVSETUP) && \
  adb root && \
  adb wait-for-device && \
  adb shell "toolbox date $(shell date +%s) || toolbox date -s $(shell date +%Y%m%d.%H%M%S)"

#
# Initialize the workspace with gonk/manifest/<gonk>.xml instead of the default
# gonk with:
#
#   $ make init.<gonk>
#
define __init_rules

.PHONY: init.$(1)
init.$(1): GONK=$(1)
init.$(1):
	rm -rf .repo/manifest* .repo/.repo_fetchtimes.json out/repo_fetchtimes.P
	@+$(MAKE) --no-print-directory .repo/manifest.xml GONK=$(1)
endef

$(eval \
  $(foreach manifest,$(subst /,,$(subst gonk/,,$(notdir $(basename $(wildcard gonk/manifest/*.xml))))),\
    $(call __init_rules,$(manifest))) \
)

init.%:
	@echo Error: gonk/manifest/$(subst init.,,$@).xml does not exist
	@false


#
# Gonk manifest management (internal)
#

REPO_INIT_HOST:=$(shell uname | tr A-Z a-z)

.repo/.repo_fetchtimes.json: .repo/manifest.xml
	./repo sync -j4 --current-branch --no-tags --force-sync --quiet

-include out/repo_fetchtimes.P  # Generated by vendor/silk/gonk/vendorsetup.sh

.repo/manifest.xml: GONK=base# default gonk manifest
.repo/manifest.xml: | .repo/manifest_upstream
	./repo init -u $(PWD)/.repo/manifest_upstream \
    -m $(GONK).xml $(REPO_INIT_ARGS) \
    -g all,-notdefault,-x86,-mips,-linux,-darwin,-flo,-flounder,-fugu,-grouper,-hammerhead,-manta,$(REPO_INIT_HOST)
	@if [[ -n "$(REPOCACHE_$(GONK))" ]]; then \
    if [[ ! -d .repo/projects ]]; then \
      echo Seeding .repo projects from $(REPOCACHE_$(GONK)); \
      ( set -x; curl "$(REPOCACHE_$(GONK))" | tar zx ); \
    else \
      echo ======================================================; \
      echo Notice: Unable to use repo cache to speed up your sync; \
      echo ======================================================; \
    fi; \
  fi

.repo/manifest_upstream:
# Construct a faux 'upstream' manifest project to keep repo content.  Its
# manifest .xml files redirect out to gonk/manifest/* so that edits directly
# made in gonk/manifest/* will be picked up immediately by a |repo sync|
	@echo Forging upstream repo manifest for gonk: $(GONK)
	@{ \
    set -e ; \
    mkdir -p .repo/manifest_upstream ; \
    cd .repo/manifest_upstream ; \
    git init --quiet . ; \
    for f in gonk/manifest/*; do ln -sf ../../$$f .; done; \
    git add *; \
    git commit -q -m '301 Moved Permanently' ; \
  }


# |make repocache.<gonk>| constructs a tarball of the .repo projects for the
# given Gonk.
#
#            DANGER: YOUR WORKSPACE CONTENTS WILL BE DESTROYED!!!
#
# The repocache tarball is used to speed up the initial sync of a device
# workspace, while improving reliability (due to less network connections), by
# first populating the .repo/ projects from the tarball. A normal |repo sync|
# then follows to retrieve any additional commits that were added since the
# creation of the tarball.
#
# Example usage:
#   $ make repocache.base
#
# Upload the resulting repocache-<gonk>.tgz to S3 or some other cloud storage.
# Make the URL accessible without any authentication (TODO: fix!) and add it to
# the corresponding REPOCACHE_<gonk> macro below.
#
# Periodically the repo cache may need to be re-created as the gonk manifest
# changes to maintain quicker sync times. A slightly stale repo cache should not
# cause any correctness issues, the user will just be downloading some
# unnecessary bits. (TODO: Wrap automation around updating the repo cache.)
#
REPOCACHE_base := https://silk-device.s3.amazonaws.com/repocache/repocache-$(REPO_INIT_HOST)-base.tgz
ifeq ($(REPO_INIT_HOST),linux)
REPOCACHE_mako := https://silk-device.s3.amazonaws.com/repocache/repocache-$(REPO_INIT_HOST)-mako.tgz
endif

define __repocache_rules

.PHONY: repocache.$(1)
repocache.$(1):
	$(MAKE) zest
	export REPOCACHE_$(1)="" ; \
  export REPO_INIT_ARGS="--depth=1" ; \
  $(MAKE) init.$(1)
	$(MAKE) sync
	tar zcf repocache-$(REPO_INIT_HOST)-$(1).tgz .repo/project-objects .repo/projects/
	@ls -l repocache-$(REPO_INIT_HOST)-$(1).tgz
	@echo Please upload to:
	@echo "  $(REPOCACHE_$(1))"
endef

$(eval \
  $(foreach gonk,$(subst REPOCACHE_,,$(filter REPOCACHE_%,$(.VARIABLES))),\
    $(call __repocache_rules,$(gonk))) \
)

# Catch-all, redirect to gonk build system
%: | .repo/manifest.xml
	$(ENVSETUP) && time $(MAKE) -f build/core/main.mk $@

# Disable implicit rules for '-include'-ed makefiles to avoid a redirect to the
# gonk build system
GNUmakefile: ;
out/repo_fetchtimes.P: ;
