SHELL=/bin/bash

-include .branch
BRANCH ?= unknown
export BRANCH

ENVSETUP=source build/envsetup.sh $(1) && test "$$SILK_ENVSETUP" == "1"

.PHONY: all
all: | .repo/.repo_fetchtimes.json
	$(ENVSETUP) && time $(MAKE) -f build/core/main.mk

.PHONY: install
install: | .repo/.repo_fetchtimes.json
	$(ENVSETUP) && \
  adb root && \
  adb wait-for-device && \
  adb remount && \
  adb sync && \
  adb shell sync

.PHONY: clean
clean:
	rm -rf out

# Kills "99.99%" of bugs.
# (Be very careful!)
.PHONY: purell
purell:
	rm -rf * && git reset --hard HEAD && ./repo sync -l
	touch .repo/.repo_fetchtimes.json

# https://youtu.be/1r_2fNiYkyE
# (Be certain!)
.PHONY: zest
zest:
	git reset --hard HEAD && git clean -dx -f -f

.PHONY: sync
sync: | .repo/manifest.xml
	./repo sync -j4 --current-branch --no-tags --quiet
	date +%s > .repo/.repo_fetchtimes.json
	rm -rf out/lastpatch.md5sum

# Update the currently attached Mako device with the latest prebuilt dev build
.PHONY: update
update:
	rm -rf out/prebuilt/mako
	$(MAKE) update.mako
	out/prebuilt/mako/aosp_mako/$(or $(FLASH_SCRIPT),flash.sh)

# Update the currently attached Mako device with the latest prebuilt FUT build
.PHONY: fut
fut: FLASH_SCRIPT=flash_fut.sh
fut: update

# Update the currently attached Mako device with the latest prebuilt demo build
.PHONY: demo
demo: FLASH_SCRIPT=flash_demo.sh
demo: update

# Run the emulator
EMULATOR=emulator -verbose -show-kernel $(EXTRA_EMULATOR_OPTS)
.PHONY: qemu
qemu:
# The 'qemu' gonk represents a full emulator build and it usable directly. \
# However for all other gonks, the latest emulator build is downloaded from \
# storage.
	@$(ENVSETUP); \
  if [[ $$GONK != qemu ]]; then \
    $(MAKE) --no-print-directory update.qemu; \
    export ANDROID_PRODUCT_OUT=out/prebuilt/qemu/aosp_arm; \
  fi; \
  if [[ ! -f $$ANDROID_PRODUCT_OUT/system-qemu.img ]]; then \
    echo "(Without system-qemu.img, changes to /system will not persist)"; \
    cp -v $$ANDROID_PRODUCT_OUT/system{,-qemu}.img; \
  fi; \
  exec $(EMULATOR)

.PHONY: emu
emu: qemu

# Fetch the latest prebuilt mako distribution
update.mako: | out/prebuilt/mako ;
out/prebuilt/mako:
	mkdir -p out/prebuilt/mako
	cd out/prebuilt/mako && wget https://s3-us-west-2.amazonaws.com/silk-device/$(BRANCH)/latest/mako.tgz
	cd out/prebuilt/mako && tar zxf mako.tgz

# Fetch the latest prebuilt qemu distribution
update.qemu: | out/prebuilt/qemu ;
out/prebuilt/qemu:
	mkdir -p out/prebuilt/qemu
	cd out/prebuilt/qemu && wget https://s3-us-west-2.amazonaws.com/silk-device/$(BRANCH)/latest/qemu.tgz
	cd out/prebuilt/qemu && tar zxf qemu.tgz


# Builds a distribution archive from the current build products
.PHONY: dist
dist: | .repo/manifest.xml
	$(call ENVSETUP,clean) # <-- drop all local patches before archiving
	$(call ENVSETUP,np) && ./gonk/archive.sh $(TARGET_PRODUCT)-$(shell date +%F_%H%M%S) dist

# Manipulate the silk service on device:
#
#  make silk-start
#  make silk-stop
#  make silk-restart
silk_service_targets := $(addprefix silk-, start stop restart)
.PHONY: $(silk_service_targets)
$(silk_service_targets):
	$(ENVSETUP) && \
  adb root && \
  adb wait-for-device && \
  adb shell setprop ctl.$(subst silk-,,$@) silk


# Set the device time
.PHONY: time
time:
	@+$(ENVSETUP) ; \
  set -ex ; \
  adb root ; \
  adb wait-for-device ; \
  adb shell setprop persist.sys.timezone $(shell date +%Z%:::z|tr +- -+) ; \
  adb shell time_genoff $(shell date +%s)000 ; \
  set +x ; \
  echo "(sleep 2s while time updates)" ; sleep 2s ; \
  echo "Host time:   $(shell date)" ; \
  echo "Device time: $(shell adb shell date)" ; \


#
# Initialize the workspace with gonk/<gonk>/<gonk>.xml instead of the default
# gonk with:
#
#   $ make init.<gonk>
#
define __init_rules

.PHONY: init.$(1)
init.$(1): GONK=$(1)
init.$(1):
	rm -rf .repo/manifest* .repo/.repo_fetchtimes.json out/repo_fetchtimes.P
	+$(MAKE) --no-print-directory .repo/manifest.xml GONK=$(1)
endef

$(eval \
  $(foreach manifest,$(subst /,,$(subst gonk/,,$(notdir $(basename $(wildcard gonk/*/*.xml))))),\
    $(call __init_rules,$(manifest))) \
)

init.%:
	@echo Error: gonk/*/$(subst init.,,$@).xml does not exist
	@false


#
# Gonk manifest management (internal)
#

REPO_INIT_HOST:=$(shell uname | tr A-Z a-z)

.repo/.repo_fetchtimes.json: .repo/manifest.xml
	./repo sync -j4 --current-branch --no-tags --quiet
	date +%s > .repo/.repo_fetchtimes.json
	rm -rf out/lastpatch.md5sum


-include out/repo_fetchtimes.P  # Generated by vendor/silk/gonk/vendorsetup.sh

REPO_VERSION=--repo-url=git://codeaurora.org/tools/repo.git --repo-branch=caf-stable

.repo/manifest.xml: GONK=base# default gonk manifest
.repo/manifest.xml: | .repo/manifest_upstream
	./repo init -u $(PWD)/.repo/manifest_upstream \
    -m $(GONK).xml -b $(BRANCH) $(REPO_INIT_ARGS) \
    -g all,-notdefault,-x86,-mips,-linux,-darwin,-flo,-flounder,-fugu,-grouper,-manta,$(REPO_INIT_HOST) \
    $(REPO_VERSION) --quiet
	@if [[ -n "$(REPOCACHE_$(GONK))" ]]; then \
    if [[ ! -d .repo/projects ]]; then \
      echo Seeding .repo projects from $(REPOCACHE_$(GONK)); \
      ( set -x; curl -L "$(REPOCACHE_$(GONK))" | tar zx ); \
    else \
      echo ======================================================; \
      echo Notice: Unable to use repo cache to speed up your sync; \
      echo ======================================================; \
    fi; \
  fi

.repo/manifest_upstream:
# Construct a faux 'upstream' manifest project to keep repo content.  Its
# manifest .xml files redirect out to gonk/*/*.xml so that edits directly
# made in gonk/*/manifest/* will be picked up immediately by a |repo sync|
	@echo Forging upstream repo manifest for gonk: $(GONK)
	@{ \
    set -e ; \
    mkdir -p .repo/manifest_upstream ; \
    cd .repo/manifest_upstream ; \
    git init --quiet . ; \
    for f in gonk/*/*.xml; do ln -sf ../../$$f .; done; \
    git add *; \
    git commit -q -m '301 Moved Permanently'; \
    test $(BRANCH) = master || git branch $(BRANCH); \
  }


# |make repocache.<gonk>| constructs a tarball of the .repo projects for the
# given Gonk.
#
#            DANGER: YOUR WORKSPACE CONTENTS WILL BE DESTROYED!!!
#
# The repocache tarball is used to speed up the initial sync of a device
# workspace, while improving reliability (due to less network connections), by
# first populating the .repo/ projects from the tarball. A normal |repo sync|
# then follows to retrieve any additional commits that were added since the
# creation of the tarball.
#
# Example usage:
#   $ make repocache.base
#
# Upload the resulting repocache-<gonk>.tgz to S3 or some other cloud storage.
# Make the URL accessible without any authentication (TODO: fix!) and add it to
# the corresponding REPOCACHE_<gonk> macro below.
#


ifndef NO_REPOCACHE
REPOCACHE_URLPREFIX := https://silk-releng-us-east-1.s3-external-1.amazonaws.com/master/repocache/repocache-

REPOCACHE_base := $(REPOCACHE_URLPREFIX)$(REPO_INIT_HOST)-base.tgz
ifeq ($(REPO_INIT_HOST),linux)
REPOCACHE_mako := $(REPOCACHE_URLPREFIX)$(REPO_INIT_HOST)-mako.tgz
REPOCACHE_qemu := $(REPOCACHE_URLPREFIX)$(REPO_INIT_HOST)-qemu.tgz
endif
endif # NO_REPOCACHE

define __repocache_rules

.PHONY: repocache.$(1)
repocache.$(1):
	$(MAKE) zest
	export NO_REPOCACHE=1 ; \
  export REPO_INIT_ARGS="--depth=1" ; \
  $(MAKE) init.$(1)
	$(MAKE) sync
	tar zcf repocache-$(REPO_INIT_HOST)-$(1).tgz .repo/project-objects .repo/projects/
	@ls -l repocache-$(REPO_INIT_HOST)-$(1).tgz
	@echo Please upload to:
	@echo "  $(REPOCACHE_$(1))"
endef

$(eval \
  $(foreach gonk,$(subst REPOCACHE_,,$(filter REPOCACHE_%,$(.VARIABLES))),\
    $(call __repocache_rules,$(gonk))) \
)

# Catch-all, redirect to gonk build system
%: | .repo/manifest.xml
	$(ENVSETUP) && time $(MAKE) -f build/core/main.mk $@

# Disable implicit rules for '-include'-ed makefiles to avoid a redirect to the
# gonk build system
GNUmakefile: ;
out/repo_fetchtimes.P: ;
.branch: ;
