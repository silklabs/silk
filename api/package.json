    "jsonwebtoken": "/jsonwebtoken"
  },
  "dependencies": {
    "babel": "5.8.35",
    "babel-plugin-transform-runtime": "6.4.3",
    "babel-runtime": "5.8.35",
    "babelify": "6.4.0",
    "base64url": "1.0.5",
    "elliptic": "5.2.1",
    "hash.js": "1.0.3",
    "localStorage": "1.0.3",
    "mkdirp": "0.5.1",
    "msgpack-lite": "0.1.13",
    "node-fetch": "1.3.3",
    "pbkdf2": "3.0.4",
    "promise": "6.1.0",
    "uuid": "2.0.1"
