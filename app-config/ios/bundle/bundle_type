#! /usr/bin/env node
/**
 * This is a little hack program to read config.local.json to decide if xcode
 * should run react-native bundle or not.
 */

var type = 'bundle';
var config;
try {
  config = require('../../../config.local.json')
} catch(e) {
  // Ignore.
}
if (config && config['react-native'] && config['react-native'].type) {
  type = config['react-native'].type;
}
process.stdout.write(type);
