#! /usr/bin/env node

var fs = require('fs');
var http = require('http');
var path = require('path');
var url = require('url');

var config = require('../../../config.local.json');

var rn = config['react-native'];
var entryFile = process.argv[2];
var bundleFile = process.argv[3];

if (!rn || rn.type !== 'local') {
  throw new Error('Invalid "react-native" section for local bundle in config.local.json');
}

var rnUrl = url.format({
  protocol: 'http',
  hostname: rn.host || 'localhost',
  port: rn.port || '8081',
  pathname: entryFile + '.bundle',
  query: {
    platform: 'ios',
    dev: 'true',
  },
});

console.log('Writing %s to %s', rnUrl, bundleFile);
var dest = fs.createWriteStream(bundleFile);
http.get(rnUrl, function(res) {
  res.pipe(dest);
  dest.on('finish', function() {
    console.log('Done');
  });
});
