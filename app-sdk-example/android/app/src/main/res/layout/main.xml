<?xml version="1.0" encoding="utf-8"?>
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="5dp"
        android:clickable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/network_status"
            android:id="@+id/networkStatusTextView"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/networkStatusResultView"
            android:layout_toRightOf="@+id/networkStatusTextView"
            android:singleLine="true"
            android:layout_alignParentRight="true"
            android:paddingLeft="5dp" />

        <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:ems="10"
            android:id="@+id/emailText"
            android:layout_below="@+id/networkStatusTextView"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"
            android:hint="@string/email"
            android:layout_marginTop="10dp" />

        <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:ems="10"
            android:id="@+id/passwordText"
            android:layout_below="@+id/emailText"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"
            android:hint="@string/password" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login"
            android:id="@+id/loginButton"
            android:layout_below="@id/passwordText"
            android:layout_alignParentLeft="true" />

        <com.google.android.gms.common.SignInButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/googlelogin"
            android:id="@+id/googleLoginButton"
            android:layout_toRightOf="@+id/loginButton"
            android:layout_below="@+id/passwordText" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/authStatusResultView"
            android:layout_below="@id/passwordText"
            android:layout_toRightOf="@+id/googleLoginButton"
            android:singleLine="true"
            android:layout_alignParentRight="true"
            android:paddingLeft="5dp"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/googleAuthStatusResultView"
            android:layout_toRightOf="@+id/googleLoginButton"
            android:singleLine="true"
            android:layout_alignParentRight="true"
            android:paddingLeft="5dp"
            android:layout_below="@+id/authStatusResultView"
            android:layout_marginTop="2dp" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/logout"
            android:id="@+id/logoutButton"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="10dp"
            android:layout_alignRight="@+id/authStatusResultView"
            android:layout_alignEnd="@+id/authStatusResultView" />

        <Spinner
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/deviceList"
            android:layout_below="@+id/googleLoginButton"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"
            android:spinnerMode="dialog"
            android:paddingTop="5dp"/>

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/configure"
            android:id="@+id/configureButton"
            android:layout_below="@+id/deviceList"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/send_echo_message"
            android:id="@+id/sendEchoMessageButton"
            android:layout_below="@+id/deviceList"
            android:layout_toRightOf="@+id/configureButton" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/authorize"
            android:id="@+id/authorizeButton"
            android:layout_below="@+id/deviceList"
            android:layout_toRightOf="@+id/sendEchoMessageButton" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remove_device"
            android:id="@+id/removeButton"
            android:layout_below="@+id/configureButton"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_status"
            android:id="@+id/deviceStatusLabel"
            android:layout_below="@+id/removeButton"
            android:singleLine="true"
            android:paddingTop="5dp" />

        <ScrollView
            android:id="@+id/deviceStatusScrollView"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/deviceStatusLabel"
            android:scrollbars="vertical"
            android:fillViewport="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/deviceStatusTextView"
                android:nestedScrollingEnabled="false"
                android:layout_weight="1.0" />
        </ScrollView>

</RelativeLayout>
