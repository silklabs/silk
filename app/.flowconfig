[ignore]
.*/node_modules/react-native/Libraries/.*
.*/node_modules/react-native/node_modules/.*
.*/node_modules/react-native/local-cli/.*
.*/node_modules/babel.*
.*/node_modules/fbjs/.*
.*/node_modules/yargs/.*
.*/node_modules/bower/.*
.*/node_modules/webpack.*
.*/node_modules/read-package-tree/.*
.*/node_modules/npm.*
.*/node_modules/config-chain/.*
.*/node_modules/registry-url/.*
.*/node_modules/bower-json/.*

.*/server/test/.*
.*/server/src/server/.*
.*/server/src/socketio/.*
.*/server/src/signaling/.*
.*/api/test/.*
.*/rtc/test/.*
.*/streams/test/.*
.*/azure-storage/test/.*
.*/device/vendor/propsilk/silk-cv/.*
.*/pub/bsp-gonk/vendor/silk/.*
.*/device/vendor/silk/core/.*

[include]
src/
../node_modules/
../pub/node_modules/

[libs]
interface/
node_modules/react-native/Libraries/react-native/react-native-interface.js

[options]
module.system=node
unsafe.enable_getters_and_setters=true
esproposal.class_instance_fields=ignore
esproposal.class_static_fields=ignore
suppress_comment= \\(.\\|\n\\)*\\$FlowFixMe

[version]
0.26.0
