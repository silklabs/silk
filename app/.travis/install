#!/bin/bash

source .travis/determine_files_changed.sh

install_xctool()
{
  brew uninstall xctool && brew install --HEAD xctool
}

install_npm()
{
  brew reinstall npm nvm watchman
  export NVM_DIR="$PWD/.nvm"
  source $(brew --prefix nvm)/nvm.sh
  nvm install 4.2

  npm config set spin=false
  npm install
}

if [[ "$TEST_TYPE" = lint ]]; then
  if [[ -z "$JS_CHANGES" ]]; then
    echo "No JS changes detected, aborting $TEST_TYPE."
    exit 0
  fi
  install_npm

elif [[ "$TEST_TYPE" = objc-test ]]; then
  if [[ -z "$NON_JS_CHANGES" ]]; then
    echo "Only JS changes detected, aborting Objective-C tests."
    exit 0
  fi
  install_xctool
  install_npm
  # Speed up React Native packager startup by starting watchman manually now.
  watchman watch .

elif [[ "$TEST_TYPE" = build-dist ]]; then
  if [[ -z "$NON_JS_CHANGES" && "$TRAVIS_PULL_REQUEST" != "false"  ]]; then
    echo "Pull Request with only JS changes detected, aborting build."
    exit 0
  fi
  install_xctool
  install_npm
  # Speed up React Native packager startup by starting watchman manually now.
  watchman watch .

else
  echo "Unknown test type: $TEST_TYPE"
  exit 1
fi
