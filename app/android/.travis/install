#!/bin/bash -ex

curl -o- https://raw.githubusercontent.com/creationix/nvm/v0.30.2/install.sh | bash
source ~/.nvm/nvm.sh
nvm install 4.2

node --version
npm --version

npm config set spin=false
./install.internal.sh

# We need the webapp for the Android webview, but we can't list it as
# a symlinkDependecy in package.json because it trips up Flow on Linux
# somehow. Plus, that would mean longer iOS build times for no good reason.
pushd ../webapp
./install.sh
popd
