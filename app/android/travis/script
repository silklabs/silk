#!/bin/bash -e

source ~/.nvm/nvm.sh
nvm use 6.2
set -x

node --version
npm --version

# Ensure we don't run out of file watches.
echo fs.inotify.max_user_watches=524288 | sudo tee -a /etc/sysctl.conf && sudo sysctl -p

export ANDROID_HOME=$PWD/android-sdk-linux

cd android
../../gradle/gradlew assembleRelease --info --console=plain
