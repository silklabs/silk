#! /usr/bin/env node

var config = require('../../../config.local.json');
var http = require('http');
var fs = require('fs');
var path = require('path');

var rn = config['react-native'];
var bundleFile = process.argv[2];

if (!rn || rn.type !== 'local' || !rn.url) {
  throw new Error('Invalid "react-native" section for local bundle in config.local.json');
}

console.log('Writing %s to %s', rn.url, bundleFile);
var dest = fs.createWriteStream(bundleFile);
http.get(rn.url, function(res) {
  res.pipe(dest);
  dest.on('finish', function() {
    console.log('Done');
  });
});

