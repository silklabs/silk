#!/bin/bash -ex

if [[ "$TRAVIS_PULL_REQUEST" = "false" ]]; then
  if [[ "$TEST_TYPE" = "build-dist" ]]; then
    ../s3-artifacts/bin/upload \
        silk-app \
        $TRAVIS_BRANCH/latest \
        $(pwd)/dist/ \
        --credentials temporary_artifacts \
        --noindex \
        --lossy
  fi
fi

