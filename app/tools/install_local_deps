#!/usr/bin/env node
'use strict';

const npm = require('npm/lib/npm');
const packageJSON = require(process.cwd() + '/package.json');

npm.load({}, (err) => {
  if (err) {
    console.error(err);
    process.exit(1);
  }

  const npmInstallArgs = [];
  const localDeps = packageJSON.localDependencies;
  for (let dep in localDeps) {
    const version = localDeps[dep];
    npmInstallArgs.push(`${dep}@${version}`);
  }

  npm.commands.install(this.root, npmInstallArgs, (err) => {
    if (err) {
      console.error(err);
      process.exit(1);
    }
  });
});
