    "table",
    "service",
    "azure",
    "browser"
  ],
  "silkDependencies": {
    "silk-log": "/log",
    "silk-utils": "/utils",
    "silk-http": "/http",
    "eslint-config-silk": "/eslint",
    "silk-flow-bin": "/flow-bin"
  },
  "devDependencies": {
    "babel-eslint": "5.0.0",
    "eslint": "1.10.3",
    "mocha": "^2.4.5",
    "uuid": "^2.0.1"
  },
  "dependencies": {
    "babel-runtime": "^6.6.1",
    "node-fetch": "^1.3.3"
  }
}
