{
  "name": "azure-table",
  "version": "0.17.1",
  "description": "Simplified azure table service client for node and the browser.",
  "main": "node.js",
  "repository": {
    "type": "git",
    "url": "git://github.com/lightsofapollo/azure-table.git"
  },
  "scripts": {
    "preinstall": "../npm_preinstall",
    "postinstall": "../npm_postinstall",
    "lint": "eslint test src",
    "mocha": "mocha $(find test -name '*_test.js')",
    "test": "npm run lint && npm run mocha"
  },
  "keywords": [
    "azure",
    "azure",
    "table",
    "service",
    "azure",
    "browser"
  ],
  "symlinkDependencies": {
    "silk-log": "/pub/log",
    "silk-utils": "/utils",
    "silk-http": "/http",
    "eslint-config-silk": "/pub/eslint-config"
  },
  "devDependencies": {
    "babel-eslint": "6.0.4",
    "eslint": "1.10.3",
    "mocha": "2.4.5",
    "uuid": "2.0.1"
  },
  "dependencies": {
    "babel-runtime": "6.9.0",
    "node-fetch": "1.3.3"
  }
}
