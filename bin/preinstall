#!/bin/bash
#
# Heroku needs help fetching private Silk Labs projects.
#

# The HEROKU environment variable must be explicitly defined for each affected
# dyno
[[ -n $HEROKU ]] || exit 0

echo Heroku environment detected.

if [[ -d ~/.ssh ]]; then
  echo "Failsafe! ~/.ssh is not expected to exist in the Heroku environment."
  exit 1
fi

set -e
mkdir -p ~/.ssh

# This private key was created by running |ssh-keygen -f id_rsa| (empty
# passphrase), and the matching public key was then added as a Deploy Key into:
#   * https://github.com/silklabs/silk-api-react-native/settings/keys
#
# Therefore this key ONLY has read-only access to:
#   * silklabs/silk-api-react-native
# and if you are reading this file then odds are very good that so do you.

