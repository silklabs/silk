#!/bin/bash -ex
 
if [[ -z $BOB_BUILD_HOST ]]; then
  echo BOB_BUILD_HOST enviroment variable unset
  exit 1
fi
if [[ -z $BOB_BUILD_COMMAND ]]; then
  echo BOB_BUILD_COMMAND enviroment variable unset
  exit 1
fi
if [[ -z $BOB_BUILD_HOST_PORT ]]; then
  BOB_BUILD_HOST_PORT=22
fi

BOB_ROOT=bob
BOB_BUILD_ROOT=$BOB_ROOT/$TRAVIS_BUILD_ID-$TRAVIS_JOB_ID
BOB_MAX_BUILD_HISTORY=3
BOB_USER=stooge
      
SSH="ssh -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -l $BOB_USER -p $BOB_BUILD_HOST_PORT"

# Remove older builds to conserve disk space
time $SSH $BOB_BUILD_HOST " \
  cd $BOB_ROOT; \
  rm -rf $BOB_BUILD_ROOT; \
  ls -t | tail -n +$BOB_MAX_BUILD_HISTORY | xargs rm -rf \
"

# Transfer this workspace from Travis to the real build host
time rsync -azr -e "$SSH" .  $BOB_BUILD_HOST:$BOB_BUILD_ROOT

# Run the build command with an interactive shell to pick up usual rc files
$SSH $BOB_BUILD_HOST "bash -i -c '\
  cd $BOB_BUILD_ROOT; \
  export CI=true; \
  export TRAVIS_BRANCH=$TRAVIS_BRANCH; \
  export TRAVIS_BUILD_ID=$TRAVIS_BUILD_ID; \
  export TRAVIS_COMMIT=$TRAVIS_COMMIT; \
  export TRAVIS_JOB_ID=$TRAVIS_JOB_ID; \
  export TRAVIS_OS_NAME=$TRAVIS_OS_NAME; \
  export TRAVIS_PULL_REQUEST=$TRAVIS_PULL_REQUEST; \
  export TRAVIS_REPO_SLUG=$TRAVIS_REPO_SLUG; \
  $BOB_BUILD_COMMAND \
'"
