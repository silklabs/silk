[include]
src/

[ignore]
.*/node_modules/react.*
.*/node_modules/babel.*

.*/server/test/.*
.*/server/src/server/.*
.*/server/src/socketio/.*
.*/api/test/.*

[version]
0.23.0

[options]
module.system=node
unsafe.enable_getters_and_setters=true
esproposal.class_instance_fields=ignore
esproposal.class_static_fields=ignore
