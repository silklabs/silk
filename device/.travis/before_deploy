#!/bin/bash -e

source build/envsetup.sh

set -x

if [[ -n $TRAVIS ]]; then
  rm -rf $ANDROID_PRODUCT_OUT/obj/ # Reclaim some disk space because $250 per month is not enough
fi

./gonk/archive.sh $GONK dist

ls -l $ANDROID_PRODUCT_OUT/*.zip

if [ -f $ANDROID_PRODUCT_OUT/*-ota-*.zip ]; then # [ not [[, due to pathname expansion
  # Full OTA package not available for all gonks
  mv -v $ANDROID_PRODUCT_OUT/*-ota-*.zip dist/
fi
mv -v $ANDROID_PRODUCT_OUT/*-silkota-*.zip dist/

./gonk/ota_manifest.sh ${TRAVIS_BRANCH:-master} $GONK $ANDROID_PRODUCT_OUT/system dist

exit 0
