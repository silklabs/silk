#!/bin/bash -ex

make="make -j2"

lock_build_fingerprint() {
  local buildprop=$ANDROID_PRODUCT_OUT/system/build.prop
  export BUILD_FINGERPRINT=`sed -ne 's/^ro.build.fingerprint=\(.*\)$/\1/p' $buildprop`
  if [[ -z "$BUILD_FINGERPRINT" ]]; then
    echo Error: ro.build.fingerprint not found in $buildprop >&2
    exit 1
  fi
  echo BUILD_FINGERPRINT=$BUILD_FINGERPRINT
}

case $GONK in
qemu)
  $make
  source build/envsetup.sh
  lock_build_fingerprint
  $make silkota

  echo "******************************************************************"
  echo Emulator tests
  echo "******************************************************************"
  rm -rf $ANDROID_PRODUCT_OUT/obj/ # Reclaim some disk space or Travis gets borked
  test/start_emulator -r run_tests
  ;;
base)
  # Only enable ccache logging for the base gonk because Travis has a little disk
  # and doesn't like to talk about it
  export CCACHE_LOGFILE=$PWD/.artifacts/ccache-$GONK.log

  $make
  source build/envsetup.sh
  # No |lock_build_fingerprint| here since base build doesn't generate build.prop
  $make silkota

  rm -rf $ANDROID_PRODUCT_OUT/obj/ # Reclaim some disk space or Travis falls down

  if [[ $TRAVIS_OS_NAME == linux ]]; then
    echo "******************************************************************"
    echo Emulator tests
    echo "******************************************************************"
    $make update.qemu # Fetch the emulator

    if ! which adb; then
      # Fetch an adb since it's not built as a part of the base build nor
      # installed by Travis (https://github.com/travis-ci/apt-package-whitelist/issues/1410)
      for i in {1..10}; do
        wget --retry-connrefused https://dl-ssl.google.com/android/repository/platform-tools_r23-linux.zip || true
        test -f platform-tools_r23-linux.zip && break
        sleep 10s # The Googles will fail us sometimes.  Be strong
      done

      unzip platform-tools_r23-linux.zip
      export PATH=$PATH:$(readlink -f platform-tools)
      which adb
    fi

    test/start_emulator -r run_tests
  else
    echo Warning: Skipping emulator boot check on OS X for now
  fi

  if [[ $TRAVIS_OS_NAME == linux ]]; then  # We only support building Mako on Linux
    echo "******************************************************************"
    echo Validating Mako manifest
    echo "******************************************************************"
    $make init.mako
  fi
  ;;
mako)
  $make
  source build/envsetup.sh
  lock_build_fingerprint
  $make otapackage
  $make silkota
  ;;
base.msm8916)
base.msm8956)
  $make
  source build/envsetup.sh
  # No |lock_build_fingerprint| here since base.msm8916 build doesn't generate build.prop
  $make silkota
  ;;
*)
  $make
  source build/envsetup.sh
  lock_build_fingerprint
  $make silkota
  ;;
esac

echo "******************************************************************"
echo Unit tests
echo "******************************************************************"
test/unit

# Clear more space for Travis builds
rm -rf vendor/silk/locked_node_modules/node_modules/modules

exit 0
