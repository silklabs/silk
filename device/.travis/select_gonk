# |source| me

echo GONK_SPEC=$GONK_SPEC

if [[ -z $GONK_SPEC ]]; then
  if [[ $TRAVIS_PULL_REQUEST == false ]]; then
    # Branch build.  Select the primary development device.  Secondary devices
    # are built nightly by Releng.
    export GONK=mako
  else
    # Pull request.  Build a quick "base" build.
    export GONK=base
  fi
else
  export GONK=$GONK_SPEC
fi

echo GONK=$GONK
