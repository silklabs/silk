# |source| me

if [[ $TRAVIS_PULL_REQUEST == false ]]; then
    export GONK=$GONK_SPEC
else
    # Pull request.  Force a "base" build for only one of the entries in the
    # Travis build matrix
    case $GONK_SPEC in
    qemu)
        export GONK=base
        ;;
    *)
        # "base" builds aren't target specific, so skip for everything
        # else since we're already doing them for qemu.
        export GONK=nop
        ;;
    esac
fi
