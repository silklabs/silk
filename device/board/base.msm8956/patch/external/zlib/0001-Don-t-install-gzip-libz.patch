From 08264fcffc90fd9094591efba4443d078ffd5a80 Mon Sep 17 00:00:00 2001
From: Anshul Jain <anshul@silklabs.com>
Date: Wed, 27 Apr 2016 21:36:26 -0700
Subject: [PATCH] Don't install gzip/libz

---
 Android.mk | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/Android.mk b/Android.mk
index c8cf0b1..879bb99 100644
--- a/Android.mk
+++ b/Android.mk
@@ -36,6 +36,7 @@ ifeq ($(TARGET_ARCH),arm)
 endif
 endif
 LOCAL_EXPORT_C_INCLUDE_DIRS := $(LOCAL_PATH)
+LOCAL_UNINSTALLABLE_MODULE := true
 include $(BUILD_SHARED_LIBRARY)
 
 include $(CLEAR_VARS)
@@ -83,7 +84,7 @@ LOCAL_SRC_FILES:=        \
 LOCAL_MODULE:= gzip
 
 LOCAL_SHARED_LIBRARIES := libz
-
+LOCAL_UNINSTALLABLE_MODULE := true
 include $(BUILD_EXECUTABLE)
 
 include $(CLEAR_VARS)
-- 
2.7.0

