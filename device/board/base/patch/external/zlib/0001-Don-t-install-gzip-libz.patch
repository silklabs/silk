From 26e35cf74b0f8582e4ca931506045449b647a398 Mon Sep 17 00:00:00 2001
From: Michael Vines <mvines@silklabs.com>
Date: Mon, 25 Apr 2016 14:39:17 -0700
Subject: [PATCH] Don't install gzip/libz

---
 Android.mk | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/Android.mk b/Android.mk
index aff52fb..055443f 100644
--- a/Android.mk
+++ b/Android.mk
@@ -29,6 +29,7 @@ LOCAL_SRC_FILES := $(zlib_files)
 ifeq ($(TARGET_ARCH),arm)
   LOCAL_SDK_VERSION := 9
 endif
+LOCAL_UNINSTALLABLE_MODULE := true
 include $(BUILD_SHARED_LIBRARY)
 
 include $(CLEAR_VARS)
@@ -97,7 +98,7 @@ LOCAL_SRC_FILES:=        \
 LOCAL_MODULE:= gzip
 
 LOCAL_SHARED_LIBRARIES := libz
-
+LOCAL_UNINSTALLABLE_MODULE := true
 include $(BUILD_EXECUTABLE)
 
 include $(CLEAR_VARS)
-- 
2.6.4 (Apple Git-63)

