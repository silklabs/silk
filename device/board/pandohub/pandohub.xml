<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <include name="caf.pandohub.xml"/>
  <remove-project name="platform/hardware/qcom/gps" />
  <remove-project name="platform/vendor/qcom-opensource/location" />

  <!--
     This comment is a trick to include patches from board/msm8909-la121/...
      <include name="msm8909-la121.xml"/>
  -->
  <project name="pandohub-nhlos"
           path="board/pandohub/nhlos"
           remote="silkssh"
           revision="master"/>

  <!--
    Inline msm8909-la121.xml.
    If you modify anything below consider updating msm8909-la121.xml too.
  -->
  <remote name="silkssh"
          fetch="ssh://git@github.com/silklabs/"
          revision="Always invalid.  Contact releng for more details"
          sync-j="4"/>
  <project name="pandohub-blobs"
           path="vendor/qcom/blobs"
           remote="silkssh"
           revision="master"/>
</manifest>
