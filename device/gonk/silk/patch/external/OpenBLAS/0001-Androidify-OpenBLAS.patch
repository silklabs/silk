From 325c6c096e0a46b3bc8074d0795c103070b1bef7 Mon Sep 17 00:00:00 2001
From: Travis CI <engineering@silklabs.com>
Date: Thu, 21 Jan 2016 16:48:52 -0800
Subject: [PATCH] Androidify OpenBLAS

---
 Android.mk | 34 ++++++++++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)
 create mode 100644 Android.mk

diff --git a/Android.mk b/Android.mk
new file mode 100644
index 0000000..421cbc4
--- /dev/null
+++ b/Android.mk
@@ -0,0 +1,34 @@
+LOCAL_PATH:= $(call my-dir)
+
+include $(CLEAR_VARS)
+
+LOCAL_MODULE := libopenblas
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_CLASS := STATIC_LIBRARIES
+LOCAL_MODULE_SUFFIX := .a
+LOCAL_CUSTOM_BUILT_MODULE := true
+LOCAL_32_BIT_ONLY := true
+
+include $(BUILD_PREBUILT)
+
+$(LOCAL_BUILT_MODULE): LOCAL_PATH := $(abspath $(LOCAL_PATH))
+$(LOCAL_BUILT_MODULE): NDK_ROOT := $(ANDROID_BUILD_TOP)/prebuilts/ndk/current
+$(LOCAL_BUILT_MODULE): ARM_ABI := $(ANDROID_BUILD_TOP)/prebuilts/gcc/$(HOST_OS)-x86/arm/arm-linux-androideabi-4.9
+$(LOCAL_BUILT_MODULE): LOCAL_MODULE := $(LOCAL_MODULE)
+$(LOCAL_BUILT_MODULE): $(LOCAL_PATH)/Makefile
+	@echo Build: $@
+	$(hide) time $(MAKE) -C $(LOCAL_PATH) \
+	CC="$(abspath $(CC_WRAPPER)) $(ARM_ABI)/bin/arm-linux-androideabi-gcc \
+	  --sysroot=$(NDK_ROOT)/platforms/android-21/arch-arm" \
+	CROSS_SUFFIX="$(ARM_ABI)/bin/arm-linux-androideabi-" \
+	HOSTCC=gcc \
+	NO_LAPACK=1 \
+	TARGET=ARMV5 \
+	USE_THREAD=1 \
+	NUM_THREADS=8 \
+	USE_OPENMP=0
+	$(hide) cd $(LOCAL_PATH) && $(MAKE) PREFIX="$(ANDROID_BUILD_TOP)/$(dir $@)" \
+	  NO_LAPACK=1 install && $(MAKE) clean
+	$(hide) cp $(dir $@)lib/$(notdir $@) $@
+	$(hide) mkdir -p $(TARGET_OUT_HEADERS)/$(LOCAL_MODULE)
+	$(hide) cp -fr $(dir $@)include $(TARGET_OUT_HEADERS)/$(LOCAL_MODULE)
-- 
2.5.4 (Apple Git-61)

