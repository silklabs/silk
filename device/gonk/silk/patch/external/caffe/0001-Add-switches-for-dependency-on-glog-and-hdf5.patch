+ifeq ($(USE_GLOG), 1)
+	LIBRARIES += glog
+else
+	CXX_SRCS := ./src/ceres/internal/miniglog/glog/logging.cpp
+	INCLUDE_DIRS := ./include/ceres/internal/miniglog/ $(INCLUDE_DIRS)
+endif
