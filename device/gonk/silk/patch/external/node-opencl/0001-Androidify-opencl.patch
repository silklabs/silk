Date: Wed, 2 Dec 2015 22:39:19 -0800
Subject: [PATCH] Androidify opencl

---
 Android.mk          | 21 ++++++++++++++
 binding.gyp         | 10 ++++++-
 fakeopencl.cpp      |  0
 lib/opencl.js       |  2 +-
 package.json        | 16 +++++-----
 test/opencl_demo.js | 84 +++++++++++++++++++++++++++++++++++++++++++++++++++++
 6 files changed, 124 insertions(+), 9 deletions(-)
 create mode 100644 Android.mk
 create mode 100644 fakeopencl.cpp
 create mode 100644 test/opencl_demo.js

diff --git a/Android.mk b/Android.mk
new file mode 100644
index 0000000..f729dcc
--- /dev/null
+++ b/Android.mk
@@ -0,0 +1,21 @@
+LOCAL_PATH:= $(call my-dir)
+
+ifneq ($(TARGET_NO_FAKE_LIBOPENCL),true)
+  # Create a fake libOpenCL.so if not already being built for this platform.
+  # bindings.gyp only cares about the presence of this library and not
+  # symbols in it to tell node where to go resolve symbols at runtime
+  include $(CLEAR_VARS)
+  LOCAL_MODULE := libOpenCL
+  LOCAL_SRC_FILES := fakeopencl.cpp
+  LOCAL_MODULE_TAGS := optional
+  LOCAL_UNINSTALLABLE_MODULE := true
+  include $(BUILD_SHARED_LIBRARY)
+endif
+
+include $(CLEAR_VARS)
+LOCAL_MODULE_TAGS := optional
+LOCAL_NODE_MODULE_TYPE := file
+LOCAL_NDK_STL_VARIANT := gnustl_static
+LOCAL_SDK_VERSION := 19
+LOCAL_SHARED_LIBRARIES := libOpenCL
+include $(BUILD_NODE_MODULE)
