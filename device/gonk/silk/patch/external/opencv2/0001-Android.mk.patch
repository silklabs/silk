diff --git a/opencv.mk b/opencv.mk
new file mode 100644
index 0000000..d220a9b
--- /dev/null
+++ b/opencv.mk
@@ -0,0 +1,39 @@
+# Include from your Android.mk to link with OpenCV, after defining LOCAL_MODULE
+OPENCV_MODULE_NAMES := \
+  androidcamera \
+  core \
+  calib3d \
+  contrib \
+  features2d \
+  flann \
+  highgui \
+  imgproc \
+  legacy \
+  ml \
+  objdetect \
+  ocl \
+  photo \
+  stitching \
+  superres \
+  ts \
+  video \
+  videostab \
+
+OPENCV_3RDPARTY_COMPONENTS := \
+ libopencv2_libjasper \
+ libopencv2_libjpeg \
+ libopencv2_libpng \
+ libopencv2_tbb \
+
+OPENCV_MODULES := $(addprefix libopencv2_,$(OPENCV_MODULE_NAMES))
+
+ifneq ($(LOCAL_MODULE),libopencv2_core)
+LOCAL_CFLAGS += -Wno-non-virtual-dtor # Bug in include/opencv2/core/core.hpp?
+LOCAL_CFLAGS += -frtti -fexceptions
+LOCAL_NDK_STL_VARIANT := gnustl_static
+LOCAL_SDK_VERSION := 19
+LOCAL_32_BIT_ONLY := true
+LOCAL_STATIC_LIBRARIES += $(OPENCV_MODULES) $(OPENCV_3RDPARTY_COMPONENTS)
+LOCAL_SHARED_LIBRARIES += liblog libz libdl
+
+endif
diff --git a/platforms/android/android.toolchain.cmake b/platforms/android/android.toolchain.cmake
index b540ea4..9dbd3d8 100644
--- a/platforms/android/android.toolchain.cmake
+++ b/platforms/android/android.toolchain.cmake
@@ -512,7 +512,12 @@ if( BUILD_WITH_ANDROID_NDK )
   set( ANDROID_NDK_TOOLCHAINS_SUBPATH2 "" )
  elseif( ANDROID_NDK_LAYOUT STREQUAL "ANDROID" )
   set( ANDROID_NDK_HOST_SYSTEM_NAME ${ANDROID_NDK_HOST_SYSTEM_NAME2} ) # only 32-bit at the moment
-  set( ANDROID_NDK_TOOLCHAINS_PATH "${ANDROID_NDK}/../../gcc/${ANDROID_NDK_HOST_SYSTEM_NAME}/arm" )
+  string( FIND "${ANDROID_ABI}" "arm" __androidAbiIsArm )
+  if ( __androidAbiIsArm EQUAL -1 )
+    set( ANDROID_NDK_TOOLCHAINS_PATH "${ANDROID_NDK}/../../gcc/${ANDROID_NDK_HOST_SYSTEM_NAME}/x86" )
+  else()
+    set( ANDROID_NDK_TOOLCHAINS_PATH "${ANDROID_NDK}/../../gcc/${ANDROID_NDK_HOST_SYSTEM_NAME}/arm" )
+  endif()
   set( ANDROID_NDK_TOOLCHAINS_SUBPATH  "" )
   set( ANDROID_NDK_TOOLCHAINS_SUBPATH2 "" )
  else() # ANDROID_NDK_LAYOUT STREQUAL "RELEASE"
@@ -589,7 +594,8 @@ macro( __GLOB_NDK_TOOLCHAINS __availableToolchainsVar __availableToolchainsLst _
   if( __machine )
    string( REGEX MATCH "[0-9]+[.][0-9]+([.][0-9x]+)?$" __version "${__gcc_toolchain}" )
    if( __machine MATCHES x86_64 )
-    set( __arch "x86_64" )
+    # Force 32bit build, to match Android.mk
+    set( __arch "x86" )
    elseif( __machine MATCHES i686 )
     set( __arch "x86" )
    elseif( __machine MATCHES aarch64 )
@@ -1256,6 +1262,9 @@ elseif( ARMEABI OR ARMEABI_V7A)
   endif()
  endif()
 elseif( X86 OR X86_64 )
+ if( X86 )
+   set( ANDROID_CXX_FLAGS "${ANDROID_CXX_FLAGS} -m32" )
+ endif()
  set( ANDROID_CXX_FLAGS "${ANDROID_CXX_FLAGS} -funwind-tables" )
  if( NOT ANDROID_COMPILER_IS_CLANG )
   set( ANDROID_CXX_FLAGS "${ANDROID_CXX_FLAGS} -funswitch-loops -finline-limit=300" )
@@ -1365,6 +1374,10 @@ mark_as_advanced( ANDROID_NO_UNDEFINED ANDROID_SO_UNDEFINED ANDROID_FUNCTION_LEV
 # linker flags
 set( ANDROID_LINKER_FLAGS "" )
 
+if( X86 )
+ set( ANDROID_LINKER_FLAGS "${ANDROID_LINKER_FLAGS} -m32" )
+endif()
+
 if( ARMEABI_V7A )
  # this is *required* to use the following linker flags that routes around
  # a CPU bug in some Cortex-A8 implementations:
-- 
