From 5110157dfaaa89eefeeb269d21f6643e59377686 Mon Sep 17 00:00:00 2001
From: Travis CI <engineering@silklabs.com>
Date: Sun, 31 Jan 2016 13:27:48 -0800
Subject: [PATCH] Do not download TBB tar ball from the internet at compile
 time

---
 Android.mk | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Android.mk b/Android.mk
index cbff6c5..ab11ef4 100644
--- a/Android.mk
+++ b/Android.mk
@@ -72,6 +72,8 @@ $(OPENCV_MAKEFILE): OPENCV_TOOLCHAIN_NAME := $(OPENCV_TOOLCHAIN_NAME)
 $(OPENCV_MAKEFILE): $(LOCAL_PATH)/Android.mk
 	@echo Configure: $@
 	$(hide) mkdir -p $(@D)
+	$(hide) mkdir -p $(@D)/3rdparty/tbb/tbb43_20141204oss
+	$(hide) cp -r $(ANDROID_BUILD_TOP)/external/intel-tbb/* $(@D)/3rdparty/tbb/tbb43_20141204oss
 	cd $(@D) && cmake \
  -DCMAKE_TOOLCHAIN_FILE=$(LOCAL_PATH)/platforms/android/android.toolchain.cmake \
  -DCMAKE_BUILD_TYPE=RelWithDebInfo \
-- 
