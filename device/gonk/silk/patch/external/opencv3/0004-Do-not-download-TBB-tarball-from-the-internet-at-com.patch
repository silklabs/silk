From 4604a464f5bb8283498e12528ba7bf9983ba3d43 Mon Sep 17 00:00:00 2001
From: Michael Vines <mvines@silklabs.com>
Date: Fri, 5 Feb 2016 22:05:38 -0800
Subject: [PATCH] Do not download TBB tarball from the internet at compile time

---
 Android.mk | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Android.mk b/Android.mk
index f9578e9..0ac8ef2 100644
--- a/Android.mk
+++ b/Android.mk
@@ -72,6 +72,8 @@ $(OPENCV3_MAKEFILE): OPENCV3_TOOLCHAIN_NAME := $(OPENCV3_TOOLCHAIN_NAME)
 $(OPENCV3_MAKEFILE): $(LOCAL_PATH)/Android.mk
 	@echo Configure: $@
 	$(hide) mkdir -p $(@D)
+	$(hide) mkdir -p $(@D)/3rdparty/tbb/tbb43_20141204oss
+	$(hide) cp -r $(ANDROID_BUILD_TOP)/external/intel-tbb/* $(@D)/3rdparty/tbb/tbb43_20141204oss
 	cd $(@D) && cmake \
  -DCMAKE_TOOLCHAIN_FILE=$(LOCAL_PATH)/platforms/android/android.toolchain.cmake \
  -DCMAKE_BUILD_TYPE=RelWithDebInfo \
-- 
1.9.1

