From 5aedd986ffb03fd74a11622be67c29ed40ff4748 Mon Sep 17 00:00:00 2001
From: Anshul Jain <anshul@silklabs.com>
Date: Tue, 5 Jan 2016 11:51:31 -0800
Subject: [PATCH] Androidify pocketsphinx

---
 Android.mk | 44 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)
 create mode 100644 Android.mk

diff --git a/Android.mk b/Android.mk
new file mode 100644
index 0000000..3739bb5
--- /dev/null
+++ b/Android.mk
@@ -0,0 +1,44 @@
+# Build the native component of the PocketSphinx library for Android
+BASE_PATH := $(call my-dir)
+
+include $(CLEAR_VARS)
+LOCAL_C_INCLUDES := \
+  $(BASE_PATH)/../sphinxbase/include/android \
+  $(BASE_PATH)/../sphinxbase/include \
+  $(BASE_PATH)/include
+LOCAL_CFLAGS += -DHAVE_CONFIG_H
+LOCAL_CFLAGS += -DANDROID_NDK
+
+LOCAL_PATH := $(BASE_PATH)/src/libpocketsphinx
+LOCAL_MODULE := libpocketsphinx
+
+LOCAL_SRC_FILES := \
+  acmod.c     \
+  allphone_search.c \
+  bin_mdef.c    \
+  blkarray_list.c   \
+  dict.c     \
+  dict2pid.c    \
+  fsg_history.c   \
+  fsg_lextree.c   \
+  fsg_search.c   \
+  kws_detections.c \
+  kws_search.c   \
+  hmm.c.arm     \
+  mdef.c     \
+  ms_gauden.c.arm    \
+  ms_mgau.c.arm    \
+  ms_senone.c.arm    \
+  ngram_search.c   \
+  ngram_search_fwdtree.c \
+  ngram_search_fwdflat.c \
+  phone_loop_search.c  \
+  pocketsphinx.c \
+  ps_lattice.c   \
+  ps_mllr.c    \
+  ptm_mgau.c.arm    \
+  s2_semi_mgau.c.arm   \
+  tmat.c     \
+  vector.c
+
+include $(BUILD_STATIC_LIBRARY)
-- 
