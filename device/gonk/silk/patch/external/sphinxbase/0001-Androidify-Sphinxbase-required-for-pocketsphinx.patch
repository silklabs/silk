From 01b4ec71233de1a6eae6dc2157e449faf90a21f6 Mon Sep 17 00:00:00 2001
From: Anshul Jain <anshul@silklabs.com>
Date: Tue, 5 Jan 2016 11:52:49 -0800
Subject: [PATCH] Androidify Sphinxbase required for pocketsphinx

---
 Android.mk | 76 ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 76 insertions(+)
 create mode 100644 Android.mk

diff --git a/Android.mk b/Android.mk
new file mode 100644
index 0000000..66867da
--- /dev/null
+++ b/Android.mk
@@ -0,0 +1,76 @@
+# Build the native component of the PocketSphinx library for Android
+BASE_PATH := $(call my-dir)
+
+include $(CLEAR_VARS)
+
+LOCAL_C_INCLUDES := \
+  $(BASE_PATH)/include/android \
+  $(BASE_PATH)/include
+
+LOCAL_CFLAGS := \
+  -DHAVE_CONFIG_H \
+  -Wno-sign-compare \
+  -Wno-unused-parameter \
+  -Wno-missing-field-initializers \
+
+LOCAL_MODULE := libsphinxbase
+
+LOCAL_PATH := $(BASE_PATH)/src/libsphinxbase
+LOCAL_SRC_FILES := \
+  util/bio.c \
+  util/bitarr.c \
+  util/bitvec.c \
+  util/case.c \
+  util/ckd_alloc.c \
+  util/cmd_ln.c \
+  util/dtoa.c \
+  util/err.c \
+  util/errno.c \
+  util/f2c_lite.c \
+  util/filename.c \
+  util/genrand.c \
+  util/glist.c \
+  util/hash_table.c \
+  util/heap.c \
+  util/huff_code.c \
+  util/listelem_alloc.c \
+  util/logmath.c.arm \
+  util/matrix.c \
+  util/mmio.c \
+  util/pio.c \
+  util/profile.c \
+  util/priority_queue.c \
+  util/sbthread.c \
+  util/strfuncs.c \
+
+LOCAL_SRC_FILES += \
+  fe/fe_noise.c \
+  fe/fe_prespch_buf.c \
+  fe/fe_interface.c \
+  fe/fe_sigproc.c \
+  fe/fe_warp_affine.c \
+  fe/fe_warp.c \
+  fe/fe_warp_inverse_linear.c \
+  fe/fe_warp_piecewise_linear.c \
+  fe/fixlog.c \
+
+LOCAL_SRC_FILES += \
+  feat/agc.c \
+  feat/cmn.c \
+  feat/cmn_prior.c \
+  feat/feat.c \
+  feat/lda.c \
+
+LOCAL_SRC_FILES += \
+  lm/fsg_model.c \
+  lm/jsgf.c \
+  lm/jsgf_parser.c \
+  lm/jsgf_scanner.c \
+  lm/lm_trie.c \
+  lm/lm_trie_quant.c \
+  lm/ngram_model_trie.c \
+  lm/ngram_model_set.c \
+  lm/ngram_model.c \
+  lm/ngrams_raw.c \
+
+include $(BUILD_STATIC_LIBRARY)
-- 
