#!/bin/bash
#
# Lists the URLs for the last N builds

MAX_BUILDS=$1
if [[ -z $1 ]]; then
  echo usage: $0 [max builds]
  exit
fi

if [[ -z $SILK_BOARD ]]; then
  echo SILK_BOARD enviroment variable unset
  exit 1
fi

if [[ -z $SILK_PRODUCT ]]; then
  echo SILK_PRODUCT enviroment variable unset
  exit 1
fi

if [[ -z $TARGET_BUILD_VARIANT ]]; then
  echo TARGET_BUILD_VARIANT enviroment variable unset
  exit 1
fi

if [[ -z $BRANCH ]]; then
  echo BRANCH enviroment variable unset
  exit 1
fi

BUILD_URL_PREFIX=https://s3-us-west-2.amazonaws.com/silk-device
BUILD=${SILK_BOARD}-${SILK_PRODUCT}-${BRANCH}-${TARGET_BUILD_VARIANT}

N=$MAX_BUILDS
echo "========================================================================"
echo "Last $N builds for $BUILD"
echo "========================================================================"

wget -q -O sha1 $BUILD_URL_PREFIX/$BRANCH/$BUILD/last || true
LATEST_SHA1=$(cat sha1)
if [[ -z $LATEST_SHA1 ]]; then
  echo No builds available for $BUILD
  exit
fi

while [[ $N -gt 0 ]]; do
  rm -f sha1
  wget -q -O sha1 $BUILD_URL_PREFIX/$BRANCH/$BUILD/$LATEST_SHA1/last || true
  LATEST_SHA1=$(cat sha1)
  if [[ -z $LATEST_SHA1 ]]; then
    break
  fi
  if git rev-parse $LATEST_SHA1 > /dev/null 2>&1; then
    git show $LATEST_SHA1 --quiet --pretty=format:"%h| %ar - %s (%an)"
    echo
  fi
  echo $BUILD_URL_PREFIX/$BRANCH/$BUILD/$LATEST_SHA1/$BUILD.tgz
  echo
  echo "------------------------------------------------------------------------"
  N=$(( $N - 1 ))
done
