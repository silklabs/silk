ifndef PRODUCT_SILK_ANDRIOD_MK
PRODUCT_SILK_ANDRIOD_MK=1

LOCAL_PATH:= $(call my-dir)

include $(CLEAR_VARS)
LOCAL_MODULE := silk-build-prop
LOCAL_INSTALLED_MODULE_STEM := build.prop
LOCAL_MODULE_TAGS  := optional
LOCAL_MODULE_CLASS := ETC
LOCAL_MODULE_PATH  := $(TARGET_OUT_SILK)
