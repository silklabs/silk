From 190a192e218e1d0c67f227f28d5bd8e7d3f3d540 Mon Sep 17 00:00:00 2001
From: Anshul Jain <anshul@silklabs.com>
Date: Mon, 19 Sep 2016 18:03:27 -0700
Subject: [PATCH] Androidify NNPACK

---
 Android.mk | 77 ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 77 insertions(+)
 create mode 100644 Android.mk

diff --git a/Android.mk b/Android.mk
new file mode 100644
index 0000000..374fd30
--- /dev/null
+++ b/Android.mk
@@ -0,0 +1,77 @@
+LOCAL_PATH:= $(call my-dir)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := nnpack_ukernels
+LOCAL_SRC_FILES := \
+	src/psimd/2d-fourier-8x8.c \
+	src/psimd/2d-fourier-16x16.c \
+	src/psimd/2d-wt-8x8-3x3.c \
+	src/psimd/relu.c \
+	src/psimd/softmax.c \
+	src/psimd/fft-block-mac.c \
+	src/neon/blas/s4gemm.c \
+	src/neon/blas/c4gemm.c \
+	src/neon/blas/s4c2gemm.c \
+	src/neon/blas/c4gemm-conjb.c \
+	src/neon/blas/s4c2gemm-conjb.c \
+	src/neon/blas/c4gemm-conjb-transc.c \
+	src/neon/blas/s4c2gemm-conjb-transc.c \
+	src/neon/blas/sgemm.c \
+	src/neon/blas/sdotxf.c
+LOCAL_C_INCLUDES := \
+  $(LOCAL_PATH)/include \
+  $(LOCAL_PATH)/src
+LOCAL_CFLAGS := \
+  -DNNP_ARCH_ARM=1 \
+  -std=c99
+LOCAL_CLANG := true
+include $(BUILD_STATIC_LIBRARY)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := nnpack
+LOCAL_SRC_FILES := \
+	src/init.c \
+	src/convolution-output.c \
+	src/convolution-input-gradient.c \
+	src/convolution-kernel.c \
+	src/convolution-inference.c \
+	src/fully-connected-output.c \
+	src/fully-connected-inference.c \
+	src/pooling-output.c \
+	src/softmax-output.c \
+	src/relu-output.c \
+	src/relu-input-gradient.c
+LOCAL_C_INCLUDES := \
+  $(LOCAL_PATH)/include \
+  $(LOCAL_PATH)/src \
+  $(LOCAL_PATH)/../pthreadpool/include \
+  $(LOCAL_PATH)/../FXdiv/include
+LOCAL_CFLAGS := \
+  -DNNP_ARCH_ARM=1 \
+  -std=c99
+LOCAL_CLANG := true
+LOCAL_STATIC_LIBRARIES := nnpack_ukernels pthreadpool
+LOCAL_STATIC_LIBRARIES += cpufeatures
+include $(BUILD_STATIC_LIBRARY)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := nnpack_reference
+LOCAL_SRC_FILES := \
+  src/ref/convolution-output.c \
+	src/ref/convolution-input-gradient.c \
+	src/ref/convolution-kernel.c \
+	src/ref/fully-connected-output.c \
+	src/ref/max-pooling-output.c \
+	src/ref/softmax-output.c \
+	src/ref/relu-output.c \
+	src/ref/relu-input-gradient.c
+LOCAL_C_INCLUDES := \
+  $(LOCAL_PATH)/include \
+  $(LOCAL_PATH)/../pthreadpool/include
+LOCAL_STATIC_LIBRARIES := pthreadpool
+LOCAL_CFLAGS := \
+  -DNNP_ARCH_ARM=1 \
+  -std=c99
+LOCAL_CLANG := true
+include $(BUILD_STATIC_LIBRARY)
+
-- 
2.8.2

