From ac8557db8b07a20c585949e9388a3576fa3392c4 Mon Sep 17 00:00:00 2001
From: James Lal <james@silklabs.com>
Date: Thu, 31 Mar 2016 12:14:24 -0700
Subject: [PATCH] Androidify

---
 Android.mk   |  6 ++++++
 binding.gyp  | 11 ++++++++++-
 index.js     |  8 +-------
 package.json |  6 +++++-
 4 files changed, 22 insertions(+), 9 deletions(-)
 create mode 100644 Android.mk

diff --git a/Android.mk b/Android.mk
new file mode 100644
index 0000000..40174ba
--- /dev/null
+++ b/Android.mk
@@ -0,0 +1,6 @@
+LOCAL_PATH:= $(call my-dir)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE_TAGS := optional
+LOCAL_NODE_MODULE_TYPE := file
+include $(BUILD_NODE_MODULE)
diff --git a/binding.gyp b/binding.gyp
index 636f324..5b9794d 100644
--- a/binding.gyp
+++ b/binding.gyp
@@ -5,7 +5,16 @@
       'include_dirs': ["<!(node -e \"require('nan')\")"],
       'cflags!': [ '-O3' ],
       'cflags': [ '-O2' ],
-      'sources': [ 'src/bufferutil.cc' ]
+      'sources': [ 'src/bufferutil.cc' ],
+      "conditions": [
+        [
+          "OS=='android'", {
+            "libraries" : [
+              "<!(echo $Android_mk__LIBRARIES)",
+            ],
+          },
+        ],
+      ],
     }
   ]
 }
diff --git a/index.js b/index.js
index 00c607c..f994329 100644
--- a/index.js
+++ b/index.js
@@ -1,7 +1 @@
-'use strict';
-
-try {
-  module.exports = require('bindings')('bufferutil');
-} catch (e) {
-  module.exports = require('./fallback');
-}
+module.exports = require('build/bufferutil');
diff --git a/package.json b/package.json
index e879957..8a9c20a 100644
--- a/package.json
+++ b/package.json
@@ -14,6 +14,9 @@
     "bufferutil"
   ],
   "author": "Einar Otto Stangvik <einaros@gmail.com> (http://2x.io)",
+  "os": [
+    "android"
+  ],
   "license": "MIT",
   "bugs": {
     "url": "https://github.com/websockets/bufferutil/issues"
@@ -22,5 +25,6 @@
   "dependencies": {
     "bindings": "1.2.x",
     "nan": "^2.0.5"
-  }
+  },
+  "gypfile": true
 }
-- 
2.7.4 (Apple Git-66)

