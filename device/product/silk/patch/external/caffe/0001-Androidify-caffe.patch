From 3caa3c6c1eb9dc227260c4023b28ea0fe33b9ee8 Mon Sep 17 00:00:00 2001
From: Anshul Jain <anshul@silklabs.com>
Date: Thu, 15 Sep 2016 17:41:50 -0700
Subject: [PATCH 1/2] Androidify caffe

---
 Android.mk | 104 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 104 insertions(+)
 create mode 100644 Android.mk

diff --git a/Android.mk b/Android.mk
new file mode 100644
index 0000000..70d80a9
--- /dev/null
+++ b/Android.mk
@@ -0,0 +1,104 @@
+ifneq (,$(wildcard external/opencv3/opencv.mk))
+LOCAL_PATH:= $(call my-dir)
+
+include $(CLEAR_VARS)
+
+LOCAL_MODULE := libcaffe
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_CLASS := SHARED_LIBRARIES
+LOCAL_MODULE_SUFFIX := .so
+LOCAL_CUSTOM_BUILT_MODULE := true
+LOCAL_32_BIT_ONLY := true
+LOCAL_STRIP_MODULE := false
+
+ifneq ($(TARGET_GE_MARSHMALLOW),)
+LIB_PROTOBUF := libprotobuf-cpp-full-gnustl-rtti
+else
+LIB_PROTOBUF := libprotobuf-cpp-2.3.0-full-gnustl-rtti
+endif
+
+LOCAL_STATIC_LIBRARIES := \
+  libboost \
+  libgflags \
+  libglog \
+  $(LIB_PROTOBUF) \
+
+include external/opencv3/opencv.mk
+include $(BUILD_PREBUILT)
+
+# Explicitly add the dependencies as Android make system ignores resolving
+# the dependencies for prebuilt modules
+STATIC_LIBRARIES := $(foreach lib,$(LOCAL_STATIC_LIBRARIES), \
+  $(call intermediates-dir-for, \
+  STATIC_LIBRARIES,$(lib),,,$(TARGET_2ND_ARCH))/$(lib).a)
+
+CAFFE_MAKEFILE := $(dir $(LOCAL_BUILT_MODULE))/Makefile
+$(CAFFE_MAKEFILE): LOCAL_MODULE := $(LOCAL_MODULE)
+$(CAFFE_MAKEFILE): LOCAL_PATH := $(abspath $(LOCAL_PATH))
+$(CAFFE_MAKEFILE): BOOST_HOME := $(abspath $(call intermediates-dir-for,STATIC_LIBRARIES,libboost,,,$(TARGET_2ND_ARCH)))
+$(CAFFE_MAKEFILE): GFLAGS_HOME := $(abspath $(call intermediates-dir-for,STATIC_LIBRARIES,libgflags,,,$(TARGET_2ND_ARCH)))
+$(CAFFE_MAKEFILE): GLOG_HOME := $(abspath $(call intermediates-dir-for,STATIC_LIBRARIES,libglog,,,$(TARGET_2ND_ARCH)))
+$(CAFFE_MAKEFILE): PROTOBUF_ROOT := $(abspath $(call intermediates-dir-for,STATIC_LIBRARIES,$(LIB_PROTOBUF),,,$(TARGET_2ND_ARCH)))
+$(CAFFE_MAKEFILE): OPENCV_HOME := $(abspath $(call intermediates-dir-for,STATIC_LIBRARIES,libopencv3_core,,,$(TARGET_2ND_ARCH))/sdk/native/jni)
+$(CAFFE_MAKEFILE): SML_HOME := $(ANDROID_BUILD_TOP)/external/qualcomm-developer-network/QSML-0.14.0/ilp64/arm-linux-androideabi
+$(CAFFE_MAKEFILE): CAFFE_HOME := $(call intermediates-dir-for, SHARED_LIBRARIES,$(LOCAL_MODULE),,,$(TARGET_2ND_ARCH))
+$(CAFFE_MAKEFILE): PROTOBUF_HOST := $(abspath $(PROTOC))
+$(CAFFE_MAKEFILE): | $(PROTOC)
+$(CAFFE_MAKEFILE): $(STATIC_LIBRARIES)
+ifneq ($(TARGET_GE_MARSHMALLOW),)
+$(CAFFE_MAKEFILE): ANDROID_TOOLCHAIN_NAME := $(if $(findstring x86,$(TARGET_ARCH)),x86_64-linux-android-4.9,arm-linux-androideabi-4.9)
+else
+$(CAFFE_MAKEFILE): ANDROID_TOOLCHAIN_NAME := $(if $(findstring x86,$(TARGET_ARCH)),x86_64-linux-android-4.8,arm-linux-androideabi-4.8)
+endif
+$(CAFFE_MAKEFILE): $(LOCAL_PATH)/Android.mk
+	@echo Configure: $(CAFFE_HOME)
+	ls -l $(PROTOBUF_HOST)
+	$(hide) mkdir -p $(CAFFE_HOME)
+	cd $(CAFFE_HOME) && cmake \
+	-DCMAKE_CXX_FLAGS="-std=c++11" \
+	-DCMAKE_TOOLCHAIN_FILE=$(ANDROID_TOOLCHAIN_CMAKE) \
+	-DANDROID_NDK=$(abspath prebuilts/ndk/current) \
+	-DCMAKE_BUILD_TYPE=Release \
+	-DANDROID_TOOLCHAIN_NAME=$(ANDROID_TOOLCHAIN_NAME) \
+	-DANDROID_ABI="$(if $(findstring x86,$(TARGET_ARCH)),x86,armeabi-v7a with NEON)" \
+	-DANDROID_NATIVE_API_LEVEL=21 \
+	-DADDITIONAL_FIND_PATH="$(BOOST_HOME);$(SML_HOME);$(OPENCV_HOME)" \
+	-DBUILD_python=OFF \
+	-DBUILD_docs=OFF \
+	-DCPU_ONLY=ON \
+	-DUSE_LMDB=OFF \
+	-DUSE_LEVELDB=OFF \
+	-DUSE_HDF5=OFF \
+	-DBLAS=sml \
+	-DBoost_DEBUG=ON \
+	-DBOOST_ROOT=$(BOOST_HOME) \
+	-DGFLAGS_INCLUDE_DIR=$(GFLAGS_HOME)/include \
+	-DGFLAGS_LIBRARY=$(GFLAGS_HOME)/lib/libgflags.a \
+	-DGLOG_INCLUDE_DIR="${GLOG_HOME}/include" \
+	-DGLOG_LIBRARY="${GLOG_HOME}/lib/libglog.a" \
+	-DOpenCV_DIR=$(OPENCV_HOME) \
+	-DPROTOBUF_PROTOC_EXECUTABLE=$(PROTOBUF_HOST) \
+	-DPROTOBUF_INCLUDE_DIR=$(ANDROID_BUILD_TOP)/external/protobuf/src \
+	-DPROTOBUF_LIBRARY=$(PROTOBUF_ROOT)/$(LIB_PROTOBUF).a \
+	-DSML_INCLUDE_DIR="${SML_HOME}/include" \
+	-DSML_LIBRARY="${SML_HOME}/lib/libQSML-0.14.0.so" \
+	-DCMAKE_INSTALL_PREFIX=$(ANDROID_BUILD_TOP)/$(CAFFE_HOME) \
+	$(LOCAL_PATH)
+
+$(LOCAL_BUILT_MODULE): LOCAL_MODULE := $(LOCAL_MODULE)
+$(LOCAL_BUILT_MODULE): LOCAL_PATH := $(abspath $(LOCAL_PATH))
+$(LOCAL_BUILT_MODULE): CAFFE_HOME := $(call intermediates-dir-for, SHARED_LIBRARIES,$(LOCAL_MODULE),,,$(TARGET_2ND_ARCH))
+ifdef TARGET_2ND_ARCH
+CAFFE_DEST := $($(TARGET_2ND_ARCH_VAR_PREFIX)TARGET_OUT_INTERMEDIATE_LIBRARIES)
+else
+CAFFE_DEST := $(TARGET_OUT_INTERMEDIATE_LIBRARIES)
+endif
+$(LOCAL_BUILT_MODULE): $(CAFFE_MAKEFILE)
+	@echo Build: $(CAFFE_HOME)
+	$(hide) time $(MAKE) -C $(CAFFE_HOME) install/strip
+	$(hide) cp $(CAFFE_HOME)/lib/$(notdir $@) $(CAFFE_HOME)
+	$(hide) cp $(CAFFE_HOME)/lib/$(notdir $@) $(CAFFE_DEST)
+	$(hide) mkdir -p $(TARGET_OUT_HEADERS)/$(LOCAL_MODULE)
+	$(hide) cp -fr $(CAFFE_HOME)/include $(TARGET_OUT_HEADERS)/$(LOCAL_MODULE)
+endif
+
-- 
2.8.2

