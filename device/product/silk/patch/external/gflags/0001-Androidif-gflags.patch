From cf3fd1fdef1807723a8697cf961e3913925d0596 Mon Sep 17 00:00:00 2001
From: Travis CI <engineering@silklabs.com>
Date: Wed, 20 Jan 2016 21:50:51 -0800
Subject: [PATCH] Androidif gflags

---
 .gitignore |  1 +
 Android.mk | 42 ++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 43 insertions(+)
 create mode 100644 Android.mk

diff --git a/.gitignore b/.gitignore
index 39cb957..59743f7 100644
--- a/.gitignore
+++ b/.gitignore
@@ -8,6 +8,7 @@ CMakeFiles/
 /include/gflags/gflags_completions.h
 /include/gflags/gflags_declare.h
 /include/gflags/gflags.h
+/include/gflags/gflags_gflags.h
 /lib/
 /test/gflags_unittest_main.cc
 /test/gflags_unittest-main.cc
diff --git a/Android.mk b/Android.mk
new file mode 100644
index 0000000..f49484f
--- /dev/null
+++ b/Android.mk
@@ -0,0 +1,42 @@
+LOCAL_PATH:= $(call my-dir)
+
+include $(CLEAR_VARS)
+
+LOCAL_MODULE := libgflags
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_CLASS := STATIC_LIBRARIES
+LOCAL_MODULE_SUFFIX := .a
+LOCAL_CUSTOM_BUILT_MODULE := true
+LOCAL_32_BIT_ONLY := true
+
+include $(BUILD_PREBUILT)
+
+
+GFLAGS_MAKEFILE := $(dir $(LOCAL_BUILT_MODULE))/Makefile
+$(GFLAGS_MAKEFILE): LOCAL_PATH := $(abspath $(LOCAL_PATH))
+ifneq ($(TARGET_GE_MARSHMALLOW),)
+$(GFLAGS_MAKEFILE): ANDROID_TOOLCHAIN_NAME := $(if $(findstring x86,$(TARGET_ARCH)),x86_64-linux-android-4.9,arm-linux-androideabi-4.9)
+else
+$(GFLAGS_MAKEFILE): ANDROID_TOOLCHAIN_NAME := $(if $(findstring x86,$(TARGET_ARCH)),x86_64-linux-android-4.8,arm-linux-androideabi-4.8)
+endif
+$(GFLAGS_MAKEFILE): $(LOCAL_PATH)/Android.mk
+	@echo Configure: $@
+	$(hide) mkdir -p $(@D)
+	cd $(@D) && cmake \
+	-DCMAKE_TOOLCHAIN_FILE=$(ANDROID_TOOLCHAIN_CMAKE) \
+	-DANDROID_NDK=$(abspath prebuilts/ndk/current) \
+	-DCMAKE_BUILD_TYPE=Release \
+	-DANDROID_TOOLCHAIN_NAME=$(ANDROID_TOOLCHAIN_NAME) \
+	-DANDROID_ABI="$(if $(findstring x86,$(TARGET_ARCH)),x86,armeabi-v7a with NEON)" \
+	-DANDROID_NATIVE_API_LEVEL=21 \
+	-DTHREADS_PTHREAD_ARG=OFF \
+	-DCMAKE_INSTALL_PREFIX=$(ANDROID_BUILD_TOP)/$(dir $@) \
+ $(LOCAL_PATH)
+
+$(LOCAL_BUILT_MODULE): LOCAL_MODULE := $(LOCAL_MODULE)
+$(LOCAL_BUILT_MODULE): $(GFLAGS_MAKEFILE)
+	@echo Build: $@
+	$(hide) time $(MAKE) -C $(@D) install
+	$(hide) cp $(dir $@)lib/$(notdir $@) $@
+	$(hide) mkdir -p $(TARGET_OUT_HEADERS)/$(LOCAL_MODULE)
+	$(hide) cp -fr $(dir $@)include $(TARGET_OUT_HEADERS)/$(LOCAL_MODULE)
-- 
2.8.2

