From ebb3b88e975ead15efd6d860986593e11ac52a82 Mon Sep 17 00:00:00 2001
From: James Lal <james@silklabs.com>
Date: Mon, 23 May 2016 14:17:36 -0700
Subject: [PATCH] Androidify

---
 Android.mk  |  6 ++++++
 binding.gyp | 11 ++++++++++-
 index.js    |  2 +-
 3 files changed, 17 insertions(+), 2 deletions(-)
 create mode 100644 Android.mk

diff --git a/Android.mk b/Android.mk
new file mode 100644
index 0000000..40174ba
--- /dev/null
+++ b/Android.mk
@@ -0,0 +1,6 @@
+LOCAL_PATH:= $(call my-dir)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE_TAGS := optional
+LOCAL_NODE_MODULE_TYPE := file
+include $(BUILD_NODE_MODULE)
diff --git a/binding.gyp b/binding.gyp
index ed14933..e0ded8f 100644
--- a/binding.gyp
+++ b/binding.gyp
@@ -10,7 +10,16 @@
         "<!(node -e \"require('nan')\")"
       ],
       "dependencies" : [
-      ]
+      ],
+      "conditions": [
+        [
+          "OS=='android'", {
+            "libraries" : [
+              "<!(echo $Android_mk__LIBRARIES)",
+            ],
+          },
+        ],
+      ],
     }
   ]
 }
diff --git a/index.js b/index.js
index 83b484b..86464e0 100644
--- a/index.js
+++ b/index.js
@@ -1 +1 @@
-module.exports = require('bindings')('kissfft');
+module.exports = require('./build/Release/kissfft.node');
-- 
2.7.3

