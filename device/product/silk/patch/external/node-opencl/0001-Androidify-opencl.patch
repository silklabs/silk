diff --git a/tools/opencl_demo.js b/tools/opencl_demo.js
new file mode 100644
index 0000000..762ee08
--- /dev/null
+++ b/tools/opencl_demo.js
@@ -0,0 +1,83 @@
+/**
+ * Copyright (c) 2016 Silk Labs, Inc.
+ * All Rights Reserved.
+ * Confidential and Proprietary - Silk Labs, Inc.
+ *
+ * @private
+ */
+
+/**
+ * `adb shell node system/silk/node_modules/node-opencl/tools/opencl_demo.js`
+ */
+
+'use strict';
+
+let fs = require('fs');
+let cl = require('node-opencl');
+
+function deviceTypeToStr(type) {
+  switch (type) {
+  case cl.DEVICE_TYPE_GPU:
+    return 'GPU';
+  case cl.DEVICE_TYPE_CPU:
+    return 'CPU';
+  case cl.DEVICE_TYPE_DEFAULT:
+    return 'Default';
+  case cl.DEVICE_TYPE_ACCELERATOR:
+    return "Accelerator";
+  }
+}
+
+function getDeviceInfo(device) {
+  let val = cl.getDeviceInfo(device, cl.DEVICE_NAME);
+  console.log(`\tDEVICE_NAME = ${val}`);
+
+  val = cl.getDeviceInfo(device, cl.DEVICE_VENDOR);
+  console.log(`\tDEVICE_VENDOR = ${val}`);
+
+  val = cl.getDeviceInfo(device, cl.DEVICE_VERSION);
+  console.log(`\tDEVICE_VERSION = ${val}`);
+
+  val = cl.getDeviceInfo(device, cl.DEVICE_TYPE);
+  console.log(`\tDEVICE_TYPE = ${deviceTypeToStr(val)}`);
+}
+
+function getPlatformInfo(platform) {
+  console.log(`#getPlatformInfo() for ${cl.getPlatformInfo(platform, cl.PLATFORM_VENDOR)}` +
+      `  ${cl.getPlatformInfo(platform, cl.PLATFORM_NAME)}`);
+
+  let val = cl.getPlatformInfo(platform, cl.PLATFORM_VERSION);
+  console.log(`PLATFORM_VERSION = ${val}`);
+
+  val = cl.getPlatformInfo(platform, cl.PLATFORM_PROFILE);
+  console.log(`PLATFORM_PROFILE = ${val}`);
+
+  val = cl.getPlatformInfo(platform, cl.PLATFORM_NAME);
+  console.log(`PLATFORM_NAME = ${val}`);
+
+  val = cl.getPlatformInfo(platform, cl.PLATFORM_VENDOR);
+  console.log(`PLATFORM_VENDOR = ${val}`);
+
+  val = cl.getPlatformInfo(platform, cl.PLATFORM_EXTENSIONS);
+  console.log(`PLATFORM_EXTENSIONS = ${val}`);
+
+  let devices = cl.getDeviceIDs(platform);
+  for (let i = 0; i < devices.length; i++) {
+    getDeviceInfo(devices[i]);
+  }
+}
+
+function runDemo() {
+  let platforms = cl.getPlatformIDs();
+  for (let i = 0; i < platforms.length; i++) {
+    getPlatformInfo(platforms[i]);
+  }
+}
+
+let exists = fs.existsSync(`/system/vendor/lib/libOpenCL.so`);
+if (exists) {
+  console.log(`Found opencl library; running demo`);
+  runDemo();
+} else {
+  console.log(`Error loading opencl; skipping demo`);
+}
