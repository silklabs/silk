From fcbeb34f84c03dbd312f87a16c095e4dec0b5284 Mon Sep 17 00:00:00 2001
From: Philipp von Weitershausen <philikon@silklabs.com>
Date: Thu, 16 Jun 2016 11:26:05 -0700
Subject: [PATCH] Androidify

---
 Android.mk              |  9 +++++++++
 binding.gyp             |  7 +++++++
 docs/not implemented.md | 20 --------------------
 package.json            |  3 +--
 4 files changed, 17 insertions(+), 22 deletions(-)
 create mode 100644 Android.mk
 delete mode 100644 docs/not implemented.md

diff --git a/Android.mk b/Android.mk
new file mode 100644
index 0000000..bb87fa5
--- /dev/null
+++ b/Android.mk
@@ -0,0 +1,9 @@
+LOCAL_PATH:= $(call my-dir)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE_TAGS := optional
+
+LOCAL_STATIC_LIBRARIES := \
+  libsodium \
+
+include $(BUILD_NODE_MODULE)
diff --git a/binding.gyp b/binding.gyp
index a1ce1cf..68ffe82 100644
--- a/binding.gyp
+++ b/binding.gyp
@@ -66,6 +66,13 @@
           "libraries": [
               '../deps/build/lib/libsodium.a'
           ]
+        }],
+        ['OS=="android"', {
+          "cflags": [
+            "-isystem <!(echo $ANDROID_BUILD_TOP/external/libsodium/src/libsodium/include/)",
+            "-fPIC",
+          ],
+          "libraries": ['<!(echo $Android_mk__LIBRARIES)'],
         }]
       ]
     }
diff --git a/docs/not implemented.md b/docs/not implemented.md
deleted file mode 100644
index 442319f..0000000
--- a/docs/not implemented.md	
+++ /dev/null
@@ -1,20 +0,0 @@
-This functions from Libsodium have not yet been implemented in node-sodium
-If you really need them please create a pull request and I will merge it in. Thank you for supporting the effort!
-    
-  * randombytes_implementation_name
-  * randombytes_set_implementation
-  * sodium_allocarray
-  * sodium_free
-  * sodium_malloc
-  * sodium_mlock
-  * sodium_mprotect_noaccess
-  * sodium_mprotect_readonly
-  * sodium_mprotect_readwrite
-  * sodium_munlock
-  
-Deprecated Functions
-  
-  * crypto_sign_edwards25519sha512batch
-  * crypto_sign_edwards25519sha512batch_keypair
-  * crypto_sign_edwards25519sha512batch_open
-  
diff --git a/package.json b/package.json
index 574a648..c2028a1 100644
--- a/package.json
+++ b/package.json
@@ -16,8 +16,7 @@
     "should": ">=8.3.0"
   },
   "scripts": {
-    "test": "make test",
-    "install": "make sodium"
+    "test": "make test"
   },
   "repository": {
     "type": "git",
-- 
2.8.3

