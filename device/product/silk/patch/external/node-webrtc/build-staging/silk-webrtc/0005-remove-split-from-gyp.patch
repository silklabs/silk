 chromium/src/tools/gyp/pylib/gyp/__init__.py | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/chromium/src/tools/gyp/pylib/gyp/__init__.py b/chromium/src/tools/gyp/pylib/gyp/__init__.py
index 54d20ca..73c4944 100755
--- a/chromium/src/tools/gyp/pylib/gyp/__init__.py
+++ b/chromium/src/tools/gyp/pylib/gyp/__init__.py
@@ -59,9 +59,6 @@ def Load(build_files, format, default_variables={},
   if params is None:
     params = {}
 
-  if '-' in format:
-    format, params['flavor'] = format.split('-', 1)
-
   default_variables = copy.copy(default_variables)
 
   # Default variables provided by this program and its modules should be
