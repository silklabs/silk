Subject: [PATCH] Androidify pthreadpool

---
 Android.mk | 10 ++++++++++
 1 file changed, 10 insertions(+)
 create mode 100644 Android.mk

diff --git a/Android.mk b/Android.mk
new file mode 100644
index 0000000..aa0de7b
--- /dev/null
+++ b/Android.mk
@@ -0,0 +1,10 @@
+LOCAL_PATH:= $(call my-dir)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := pthreadpool
+LOCAL_CFLAGS += -std=c99
+LOCAL_SRC_FILES := src/pthreadpool.c
+LOCAL_C_INCLUDES := \
+  $(LOCAL_PATH)/include \
+  $(LOCAL_PATH)/../FXdiv/include
+include $(BUILD_STATIC_LIBRARY)
