Subject: [PATCH] Add log message for frame encode time

---
 webrtc/modules/video_coding/generic_encoder.cc | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/webrtc/modules/video_coding/generic_encoder.cc b/webrtc/modules/video_coding/generic_encoder.cc
index 2463cf5..a16553d 100644
--- a/webrtc/modules/video_coding/generic_encoder.cc
+++ b/webrtc/modules/video_coding/generic_encoder.cc
@@ -19,6 +19,7 @@
 #include "webrtc/modules/video_coding/encoded_frame.h"
 #include "webrtc/modules/video_coding/media_optimization.h"
 #include "webrtc/system_wrappers/include/critical_section_wrapper.h"
+#include "webrtc/system_wrappers/include/tick_util.h"
 
 namespace webrtc {
 namespace {
@@ -152,7 +153,11 @@ int32_t VCMGenericEncoder::Encode(const VideoFrame& inputFrame,
   // properly, which it isn't). More than one frame may be in the pipeline.
   vcm_encoded_frame_callback_->SetRotation(rotation_);
 
+  int64_t pre = TickTime::Now().MillisecondTimestamp();
   int32_t result = encoder_->Encode(inputFrame, codecSpecificInfo, &frameTypes);
+  int64_t post = TickTime::Now().MillisecondTimestamp();
+  LOG(LS_VERBOSE) << "Encode took " << (post - pre) << "ms, "
+                  << inputFrame.width() << "x" << inputFrame.height();
 
   if (vcm_encoded_frame_callback_) {
     vcm_encoded_frame_callback_->SignalLastEncoderImplementationUsed(
