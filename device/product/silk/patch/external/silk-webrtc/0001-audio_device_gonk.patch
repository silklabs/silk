From 9aba5161adbff55072bd9d259984557082cab48f Mon Sep 17 00:00:00 2001
From: Michael Vines <mvines@silklabs.com>
Date: Wed, 15 Jun 2016 10:13:08 -0700
Subject: [PATCH] audio_device_gonk

---
 webrtc/modules/audio_device/audio_device.gypi    | 6 ++++++
 webrtc/modules/audio_device/audio_device_impl.cc | 4 ++++
 webrtc/modules/audio_device/audio_device_impl.h  | 4 ++--
 webrtc/modules/audio_device/gonk                 | 1 +
 webrtc/voice_engine/voice_engine_impl.cc         | 4 ++--
 5 files changed, 15 insertions(+), 4 deletions(-)
 create mode 120000 webrtc/modules/audio_device/gonk

diff --git a/webrtc/modules/audio_device/audio_device.gypi b/webrtc/modules/audio_device/audio_device.gypi
index abefcdb..04e76c1 100644
--- a/webrtc/modules/audio_device/audio_device.gypi
+++ b/webrtc/modules/audio_device/audio_device.gypi
@@ -70,6 +70,10 @@
         ['OS=="android"', {
           'include_dirs': [
             'android',
+            '<!(echo $ANDROID_BUILD_TOP/frameworks/av/include)',
+            '<!(echo $ANDROID_BUILD_TOP/system/core/include)',
+            '<!(echo $ANDROID_BUILD_TOP/frameworks/native/include)',
+            '<!(echo $ANDROID_BUILD_TOP/hardware/libhardware/include)',
           ],
         }], # OS==android
         ['include_internal_audio_device==0', {
@@ -92,6 +96,8 @@
           'conditions': [
             ['OS=="android"', {
               'sources': [
+                'gonk/audio_device_gonk.cc',
+                'gonk/audio_device_gonk.h',
                 'android/audio_device_template.h',
                 'android/audio_manager.cc',
                 'android/audio_manager.h',
diff --git a/webrtc/modules/audio_device/audio_device_impl.cc b/webrtc/modules/audio_device/audio_device_impl.cc
index d881bcd..b1052e4 100644
--- a/webrtc/modules/audio_device/audio_device_impl.cc
+++ b/webrtc/modules/audio_device/audio_device_impl.cc
@@ -23,6 +23,8 @@
     #include "audio_device_core_win.h"
  #endif
 #elif defined(WEBRTC_ANDROID)
+#include "webrtc/modules/audio_device/gonk/audio_device_gonk.h"
+#elif defined(REAL_WEBRTC_ANDROID)
 #include <stdlib.h>
 #include "webrtc/modules/audio_device/android/audio_device_template.h"
 #include "webrtc/modules/audio_device/android/audio_manager.h"
@@ -236,6 +238,8 @@ int32_t AudioDeviceModuleImpl::CreatePlatformSpecificObjects()
 #endif  // #if defined(_WIN32)
 
 #if defined(WEBRTC_ANDROID)
+    ptrAudioDevice = new AudioDeviceGonk();
+#elif defined(REAL_WEBRTC_ANDROID)
     // Create an Android audio manager.
     _audioManagerAndroid.reset(new AudioManager());
     // Select best possible combination of audio layers.
diff --git a/webrtc/modules/audio_device/audio_device_impl.h b/webrtc/modules/audio_device/audio_device_impl.h
index a112e3e..0108b9e 100644
--- a/webrtc/modules/audio_device/audio_device_impl.h
+++ b/webrtc/modules/audio_device/audio_device_impl.h
@@ -196,7 +196,7 @@ class AudioDeviceModuleImpl : public AudioDeviceModule {
   int GetRecordAudioParameters(AudioParameters* params) const override;
 
   int32_t Id() { return _id; }
-#if defined(WEBRTC_ANDROID)
+#if defined(REAL_WEBRTC_ANDROID)
   // Only use this acccessor for test purposes on Android.
   AudioManager* GetAndroidAudioManagerForTest() {
     return _audioManagerAndroid.get();
@@ -217,7 +217,7 @@ class AudioDeviceModuleImpl : public AudioDeviceModule {
   AudioDeviceGeneric* _ptrAudioDevice;
 
   AudioDeviceBuffer _audioDeviceBuffer;
-#if defined(WEBRTC_ANDROID)
+#if defined(REAL_WEBRTC_ANDROID)
   std::unique_ptr<AudioManager> _audioManagerAndroid;
 #endif
   int32_t _id;
diff --git a/webrtc/modules/audio_device/gonk b/webrtc/modules/audio_device/gonk
new file mode 120000
index 0000000..7735b1f
--- /dev/null
+++ b/webrtc/modules/audio_device/gonk
@@ -0,0 +1 @@
+../../../../../vendor/propsilk/webrtc/audio_device_gonk
\ No newline at end of file
diff --git a/webrtc/voice_engine/voice_engine_impl.cc b/webrtc/voice_engine/voice_engine_impl.cc
index 919d0e8..ddd20c7 100644
--- a/webrtc/voice_engine/voice_engine_impl.cc
+++ b/webrtc/voice_engine/voice_engine_impl.cc
@@ -8,7 +8,7 @@
  *  be found in the AUTHORS file in the root of the source tree.
  */
 
-#if defined(WEBRTC_ANDROID)
+#if defined(REAL_WEBRTC_ANDROID)
 #include "webrtc/modules/audio_device/android/audio_device_template.h"
 #include "webrtc/modules/audio_device/android/audio_record_jni.h"
 #include "webrtc/modules/audio_device/android/audio_track_jni.h"
@@ -137,7 +137,7 @@ bool VoiceEngine::Delete(VoiceEngine*& voiceEngine) {
 #if !defined(WEBRTC_CHROMIUM_BUILD)
 // TODO(henrika): change types to JavaVM* and jobject instead of void*.
 int VoiceEngine::SetAndroidObjects(void* javaVM, void* context) {
-#ifdef WEBRTC_ANDROID
+#ifdef REAL_WEBRTC_ANDROID
   webrtc::JVM::Initialize(reinterpret_cast<JavaVM*>(javaVM),
                           reinterpret_cast<jobject>(context));
   return 0;
-- 
1.9.1

