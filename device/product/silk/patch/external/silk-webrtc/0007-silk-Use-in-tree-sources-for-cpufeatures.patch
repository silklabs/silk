From 4284af3e344c24b64ba03e67a480d2a69d54cd28 Mon Sep 17 00:00:00 2001
From: James Lal <james@silklabs.com>
Date: Mon, 6 Jun 2016 16:09:35 -0700
Subject: [PATCH 07/11] silk: Use in tree sources for cpufeatures

---
 chromium/src/build/android/ndk.gyp | 7 ++-----
 chromium/src/build/common.gypi     | 3 +++
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/chromium/src/build/android/ndk.gyp b/chromium/src/build/android/ndk.gyp
index 495afc7..0f1a82f 100644
--- a/chromium/src/build/android/ndk.gyp
+++ b/chromium/src/build/android/ndk.gyp
@@ -8,15 +8,12 @@
       'target_name': 'cpu_features',
       'type': 'static_library',
       'direct_dependent_settings': {
-        'aosp_build_settings': {
-          'LOCAL_STATIC_LIBRARIES': 'cpufeatures'
-        },
         'include_dirs': [
-        #   '<(android_ndk_root)/sources/android/cpufeatures',
+           '<(android_ndk_headers)/sources/android/cpufeatures',
         ],
       },
       'sources': [
-        # '<(android_ndk_root)/sources/android/cpufeatures/cpu-features.c',
+         '<(android_ndk_sources)/sources/android/cpufeatures/cpu-features.c',
       ],
       'variables': {
         'clang_warning_flags': [
diff --git a/chromium/src/build/common.gypi b/chromium/src/build/common.gypi
index 1d99f31..82f9408 100644
--- a/chromium/src/build/common.gypi
+++ b/chromium/src/build/common.gypi
@@ -1747,6 +1747,9 @@
           'variables': {
             # Standard libraries can use the relative path to the NDK.
             'android_ndk_root%': '../../third_party/android_tools/ndk/',
+            # Silk specific customization for deeper integration with a full
+            # android source tree.
+            'android_ndk_sources%': '',
             # Unfortunately, it is required to use the absolute path to the SDK
             # because it us passed to ant which uses a different relative path
             # from GYP.
-- 
2.7.3

