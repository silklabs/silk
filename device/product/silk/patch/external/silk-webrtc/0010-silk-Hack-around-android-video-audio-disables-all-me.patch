From be223a5c3db6652d2ba5e83d5a8f065eed377085 Mon Sep 17 00:00:00 2001
From: James Lal <james@silklabs.com>
Date: Mon, 6 Jun 2016 22:38:42 -0700
Subject: [PATCH 10/11] silk: Hack around android video/audio [disables all
 media]

---
 webrtc/media/engine/webrtcvoiceengine.cc | 3 ++-
 webrtc/media/media.gyp                   | 4 ++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/webrtc/media/engine/webrtcvoiceengine.cc b/webrtc/media/engine/webrtcvoiceengine.cc
index b899470..d074abf 100644
--- a/webrtc/media/engine/webrtcvoiceengine.cc
+++ b/webrtc/media/engine/webrtcvoiceengine.cc
@@ -540,7 +540,8 @@ WebRtcVoiceEngine::WebRtcVoiceEngine(webrtc::AudioDeviceModule* adm,
   webrtc::Trace::SetTraceCallback(this);
   webrtc::Trace::set_level_filter(kElevatedTraceFilter);
   LOG(LS_INFO) << webrtc::VoiceEngine::GetVersionString();
-  RTC_CHECK_EQ(0, voe_wrapper_->base()->Init(adm_.get()));
+  //RTC_CHECK_EQ(0, voe_wrapper_->base()->Init(adm_.get()));
+  adm_ = nullptr;
   webrtc::Trace::set_level_filter(kDefaultTraceFilter);
 
   // No ADM supplied? Get the default one from VoE.
diff --git a/webrtc/media/media.gyp b/webrtc/media/media.gyp
index 621af83..d7fd062 100644
--- a/webrtc/media/media.gyp
+++ b/webrtc/media/media.gyp
@@ -138,12 +138,12 @@
           ],
         }, {
           'defines': [
-            'HAVE_WEBRTC_VIDEO',
+            #'HAVE_WEBRTC_VIDEO',
             'HAVE_WEBRTC_VOICE',
           ],
           'direct_dependent_settings': {
             'defines': [
-              'HAVE_WEBRTC_VIDEO',
+              #'HAVE_WEBRTC_VIDEO',
               'HAVE_WEBRTC_VOICE',
             ],
           },
-- 
2.7.3

