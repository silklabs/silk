From fcb78b3fd6591482a5ad813c4ea964370e3ab094 Mon Sep 17 00:00:00 2001
From: Michael Vines <mvines@silklabs.com>
Date: Mon, 13 Jun 2016 14:41:17 -0700
Subject: [PATCH] silk-capture video_capture backend

---
 webrtc/modules/video_capture/gonk                  |  1 +
 webrtc/modules/video_capture/video_capture.gypi    | 22 ++++++++++++++++++----
 .../modules/video_capture/video_capture_factory.cc |  4 ++--
 3 files changed, 21 insertions(+), 6 deletions(-)
 create mode 120000 webrtc/modules/video_capture/gonk

diff --git a/webrtc/modules/video_capture/gonk b/webrtc/modules/video_capture/gonk
new file mode 120000
index 0000000..dd7cf56
--- /dev/null
+++ b/webrtc/modules/video_capture/gonk
@@ -0,0 +1 @@
+../../../../../vendor/propsilk/webrtc/video_capture_gonk
\ No newline at end of file
diff --git a/webrtc/modules/video_capture/video_capture.gypi b/webrtc/modules/video_capture/video_capture.gypi
index c80f2bf..03236a5 100644
--- a/webrtc/modules/video_capture/video_capture.gypi
+++ b/webrtc/modules/video_capture/video_capture.gypi
@@ -53,12 +53,26 @@
         {
           'target_name': 'video_capture_module_internal_impl',
           'type': 'static_library',
+         'dependencies': [
+            'video_capture_module',
+            '<(webrtc_root)/common.gyp:webrtc_common',
+          ],
           'conditions': [
-            ['OS!="android"', {
-              'dependencies': [
-                'video_capture_module',
-                '<(webrtc_root)/common.gyp:webrtc_common',
+            ['OS=="android"', {
+              'sources': [
+                'gonk/device_info_gonk.cc',
+                'gonk/device_info_gonk.h',
+                'gonk/video_capture_gonk.cc',
+                'gonk/video_capture_gonk.h',
+              ],
+              'include_dirs': [
+                '<!(echo $ANDROID_BUILD_TOP/vendor/opensilk/capture)',
+                '<!(echo $ANDROID_BUILD_TOP/system/core/include)',
+                '<(DEPTH)/third_party/libyuv/include',
               ],
+              'dependencies': [
+                '<(DEPTH)/third_party/libyuv/libyuv.gyp:libyuv',
+               ],
             }],
             ['OS=="linux"', {
               'sources': [
diff --git a/webrtc/modules/video_capture/video_capture_factory.cc b/webrtc/modules/video_capture/video_capture_factory.cc
index 927beba..ccb7678 100644
--- a/webrtc/modules/video_capture/video_capture_factory.cc
+++ b/webrtc/modules/video_capture/video_capture_factory.cc
@@ -17,7 +17,7 @@ namespace webrtc {
 rtc::scoped_refptr<VideoCaptureModule> VideoCaptureFactory::Create(
     const int32_t id,
     const char* deviceUniqueIdUTF8) {
-#if defined(ANDROID)
+#if 0
   return nullptr;
 #else
   return videocapturemodule::VideoCaptureImpl::Create(id, deviceUniqueIdUTF8);
@@ -32,7 +32,7 @@ rtc::scoped_refptr<VideoCaptureModule> VideoCaptureFactory::Create(
 
 VideoCaptureModule::DeviceInfo* VideoCaptureFactory::CreateDeviceInfo(
     const int32_t id) {
-#if defined(ANDROID)
+#if 0
   return nullptr;
 #else
   return videocapturemodule::VideoCaptureImpl::CreateDeviceInfo(id);
-- 
2.9.2

