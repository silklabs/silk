#!/bin/bash -e
#
# Changes the system time framework and looking for tombstones
#

N=500

# Set to true to ensure no tombstones are generated during the iterations
# (ie, mediaserver like the crash in the background sometimes)
#BAN_TOMBSTONES=false
BAN_TOMBSTONES=true

LOCAL_PATH=$(dirname $0)

adb="timeout -s KILL 10s adb"

$adb root
sleep 1
$adb wait-for-device
$adb shell rm -rf /data/tombstones
$adb shell mkdir /data/tombstones

$adb shell setprop persist.silk.coredump 1
$adb shell rm -rf /data/core

pulltombstones() {
  local count=$($adb shell ls /data/tombstones | wc -l)
  if [[ $count -gt 0 ]]; then
    echo "****************** TOMBSTONES ******************"
    $adb pull /data/tombstones/
    echo "****************** CORES ******************"
    $adb pull /data/core
    exit 1
  fi
  echo No tombstones observed after $i iterations
}
trap pulltombstones EXIT

i=1
while [[ $i -le $N ]]; do
  echo "****************** ITERATION $i ******************"
  $adb shell ls -l /data/tombstones

  if $BAN_TOMBSTONES; then
    count=$($adb shell ls /data/tombstones | wc -l)
    test $count -eq 0
  fi

  $adb shell time_genoff 134113230000 # 1974-ish
  sleep 2s
  $adb shell date

  # Right now
  $adb shell time_genoff $(date +%s)000
  sleep 2s
  adb shell date

  $adb shell time_genoff 1234  #1969-ish
  sleep 2s
  $adb shell date

  i=$(($i + 1))
done

exit 0
