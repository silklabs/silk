LOCAL_PATH=$(dirname $0)
DEVICECHECK=$LOCAL_PATH/devicecheck

usage()
{
  echo "Usage: $0 [-r|-h]"
  echo
  echo "Checks if the emulator boots with the local build products"
  echo
  echo " -r        Additionally run the specified script"
  echo " -h        Display this message"
  exit 1
}

if [ -z $ANDROID_BUILD_TOP ]; then
  echo ANDROID_BUILD_TOP is not defined.  Please envsetup first
  exit 1
fi


while getopts "hr:" opt; do
  case $opt in
    h)
        usage;;
    r)  RUN_SCRIPT="$LOCAL_PATH/$OPTARG"
        ;;
   \?) echo "Error: Invalid option -$OPTARG"; exit 1;;
  esac
done

exitstatus=1
function cleanup {
  local pids="$(jobs -p)"
  for pid in $pids; do
    echo $0: cleanup: killing: $pid
    kill $pid
    echo $0: cleanup: waiting: $pid
    wait $pid
  done
  exit $exitstatus
}
trap cleanup SIGINT SIGTERM SIGHUP EXIT

killqemu() {
  echo Killing emulator at pid=$EMU_PID
  kill $EMU_PID
  wait $EMU_PID || true

  # Give slow CI systems a chance to breath...
  sleep 2s
}

runqemu() {
  local retries=$1
  if [[ $retries -lt 0 ]]; then
    echo Exhausted runqemu retries
    cleanup 
  fi

  echo "Starting emulator"
  make -C $ANDROID_BUILD_TOP qemu &
  EMU_PID=$!

  set +e
  $DEVICECHECK
  exitstatus=$?
  if [[ $exitstatus = 124 ]]; then
    echo
    echo ==== Retrying runqemu ====
    echo
    ps aux
    runqemu $(( $retries - 1 ))
  fi
  set -e
}

# Start it, and ensure that it boots
runqemu 3

# Swap in the current /system/silk build products
echo
echo "Installing local build into emulator at pid=$EMU_PID"
echo
(
  set -ex
  adb root
  adb wait-for-device
  adb remount
  adb wait-for-device
  adb shell stop
  adb shell rm -rv /system/silk /data/silk-test
  adb sync
  adb shell sync
)
echo
killqemu

# Restart the emulator, does it still boot?
runqemu 3

# Run additional script
if [[ -n $RUN_SCRIPT ]]; then
  echo running script $RUN_SCRIPT
  $RUN_SCRIPT
fi

echo
echo PASS
exitstatus=0
cleanup
