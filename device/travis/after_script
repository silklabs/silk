#!/bin/bash -ex

set -ex
$PREBUILT_CCACHE -s
df -h
du -h -d 1 * .repo
du -h -d 2 out/target/product/
du -h -d 1 ..
du -hs .

# Deploy our per build artifacts...
../s3-artifacts/bin/upload \
  $ARTIFACT_BUCKET \
  $ARTIFACT_REMOTE_PATH \
  $ARTIFACT_DIR \
  --lossy \
  --credentials $ARTIFACT_CREDENTIALS

