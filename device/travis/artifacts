
export ARTIFACT_BUCKET=silk-travis-artifacts-us-east-1
export ARTIFACT_WEBHOST="http://silk-travis-artifacts-us-east-1.s3-website-us-east-1.amazonaws.com"
export ARTIFACT_CREDENTIALS=temporary_artifacts
export ARTIFACT_REMOTE_PATH="$TRAVIS_REPO_SLUG/$TRAVIS_BUILD_ID/$TRAVIS_JOB_ID"
export ARTIFACT_DIR=$PWD/.artifacts/

if [[ "$TRAVIS_PULL_REQUEST" == "false" ]]; then
  CACHE_TYPE="branch"
else
  CACHE_TYPE="pull_request"
fi
# Must not contain leading or trailing slashes...
export CCACHE_ARTIFACT_PATH="silk-device/$TRAVIS_OS_NAME/$BOARD-$PRODUCT/$CACHE_TYPE/ccache"
mkdir -p $ARTIFACT_DIR
