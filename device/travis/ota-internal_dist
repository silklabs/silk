#!/bin/bash -e

source build/envsetup.sh

set -x
source ../pub/version/branch
test -n $BRANCH
test -n $SILK_BOARD
test -n $SILK_PRODUCT
test -n $TARGET_BUILD_VARIANT

rm -rf ota-internal_dist
mkdir ota-internal_dist
ls -l $ANDROID_PRODUCT_OUT/*.zip

if [ -f $ANDROID_PRODUCT_OUT/*-ota-*.zip ]; then # [ not [[, due to pathname expansion
  # Full OTA package not available for all gonks
  mv -v $ANDROID_PRODUCT_OUT/*-ota-*.zip \
    ota-internal_dist/$SILK_BOARD-$SILK_PRODUCT-ota-$BRANCH-$TARGET_BUILD_VARIANT.zip
fi
mv -v $ANDROID_PRODUCT_OUT/*-silkota-*.zip \
  ota-internal_dist/$SILK_BOARD-$SILK_PRODUCT-silkota-$BRANCH-$TARGET_BUILD_VARIANT.zip

./travis/build_ota_manifest.sh \
  $BRANCH \
  $SILK_BOARD \
  $SILK_PRODUCT \
  $TARGET_BUILD_VARIANT \
  $ANDROID_PRODUCT_OUT/system \
  ota-internal_dist

../s3-artifacts/bin/upload \
    update.silklabs.com \
    ota-internal/$BRANCH \
    $(readlink -f ota-internal_dist) \
    --credentials update.silklabs.com_ota-internal \
    --noindex \
    --lossy \

exit 0
