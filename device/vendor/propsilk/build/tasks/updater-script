show_progress(0.1, 1);
ui_print("Mounting /mnt/system");

# Ensure the /mnt directory exists, indirectly by creating a symlink in it
symlink(".loop", "/mnt/.loop");

# The /system block device can vary, try a couple common options
mount(ext4, EMMC, "/dev/block/bootdevice/by-name/system", "/mnt/system"); # CAF
mount(ext4, EMMC, "/dev/block/platform/msm_sdcc.1/by-name/system", "/mnt/system"); # AOSP
is_mounted("/mnt/system");

show_progress(0.1, 2);
ui_print("Removing old /system/silk");
delete_recursive("/mnt/system/silk");

show_progress(0.3, 15);
ui_print("Extracting /system/silk");
package_extract_dir(silk, "/mnt/system/silk");
set_metadata_recursive("/mnt/system/silk", uid, 0, gid, 2000, fmode, 0755, dmode, 0755);

show_progress(0.1, 1);
ui_print("Umounting /mnt/system");
unmount("/mnt/system");

set_progress(1);
ui_print(Success);
