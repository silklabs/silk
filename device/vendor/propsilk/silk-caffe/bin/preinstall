#!/bin/bash -e

if [[ "$NPM_CONFIG_PLATFORM" == "android" ]]; then
  echo npm install in Android not required
  exit 1
fi

J="-j2"
if [[ -z $CI ]]; then
  J="-j6"
fi

# Download caffe
if [[ ! -d caffe ]]; then
  echo Downloading caffe
  git clone git@github.com:silklabs/caffe.git -b tag2
fi

# Install caffe
PROTOBUF_ROOT=$(pwd)/protobuf
echo "protobuf root $PROTOBUF_ROOT"
if [[ ! -f caffe/build/lib/libcaffe.dylib ]]; then
  echo "Compiling caffe"
  pushd caffe
  mkdir -p build
  pushd build
  cmake \
    -DCPU_ONLY=ON \
    -DBUILD_python=OFF \
    -DBUILD_matlab=OFF \
    -DUSE_HDF5=OFF \
    -DUSE_LEVELDB=OFF \
    -DUSE_LMDB=OFF \
    -DBUILD_docs=OFF \
    ..
  make all $J
  popd
  popd
fi
