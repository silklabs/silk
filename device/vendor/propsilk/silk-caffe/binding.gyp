{
  'targets': [{
      'target_name': 'caffe',
      'sources': [
          'src/caffe.cpp',
          'src/cvutils.cpp',
          'src/model.cpp',
      ],
      'include_dirs': [
        '<!(node -e "require(\'nan\')")',
        '<!(node -e "require(\'silk-external-dlib\')")',
      ],
      'cflags_cc': [
        '-fexceptions',
        '-frtti',
      ],
      'ldflags': [
        '-Wl,--no-fatal-warnings',
      ],
      'conditions': [
        [ 'OS==\"android\"', {
          'include_dirs': [
            '<!(echo \" -I $ANDROID_BUILD_TOP/external/node-opencv/inc \")',
          ],
          'libraries': [
            '<!(echo $Android_mk__LIBRARIES)',
          ],
          'cflags': [
            '-std=c++11',
            '-DBUILD_python=OFF',
            '-DBUILD_docs=OFF',
            '-DCPU_ONLY=ON',
            '-DUSE_GLOG=OFF',
            '-DUSE_LMDB=OFF',
            '-DUSE_LEVELDB=OFF',
            '-DUSE_HDF5=OFF',
            '-Wno-sign-compare',
            '-Wstrict-aliasing',
            '-Wno-sign-promo',
            '-isystem <!(echo $ANDROID_BUILD_TOP/system/core/include/)',
            '-isystem <!(echo $ANDROID_BUILD_TOP/$TARGET_OUT_HEADERS/libgflags/include/)',
            '-isystem <!(echo $ANDROID_BUILD_TOP/external/qualcomm-developer-network/QSML-0.14.0/ilp64/arm-linux-androideabi/include)',
            '-isystem <!(echo $ANDROID_BUILD_TOP/$TARGET_OUT_HEADERS/libglog/include/)',
            '-isystem <!(echo $ANDROID_BUILD_TOP/external/protobuf/src)',
            '-isystem <!(echo $ANDROID_BUILD_TOP/external/boost/)',
            '-isystem <!(echo $ANDROID_BUILD_TOP/$TARGET_OUT_HEADERS/libcaffe/include/)',
            '-isystem <!(echo $ANDROID_BUILD_TOP/external/caffe/include/)',
            '-isystem <!(echo $ANDROID_BUILD_TOP/$TARGET_OUT_HEADERS/libopencv2_core/include/)',
          ],
        }],
        [ 'OS==\"mac\"', {
            'include_dirs': [
              '<!(node -e "require(\'opencv/include_dirs\')")',
            ],
            'libraries': [
              '<!@(pkg-config --libs opencv)',
              '-lcaffe',
            ],
            'xcode_settings': {
              'OTHER_CFLAGS': [
                '-mmacosx-version-min=10.7',
                '-std=c++11',
                '-stdlib=libc++',
                '-DBUILD_python=OFF',
                '-DBUILD_docs=OFF',
                '-DCPU_ONLY=ON',
                '-DUSE_LMDB=OFF',
                '-DUSE_LEVELDB=OFF',
                '-Wno-sign-compare',
                '-Wstrict-aliasing',
                '<!@(pkg-config --cflags opencv)',
                '-isystem /usr/local/include',
                '-isystem <!(echo $PWD/caffe/src/)',
                '-isystem <!(echo $PWD/caffe/include/)',
                '-isystem <!(echo $PWD/caffe/build/include/)',
                '-isystem <!(echo $PWD/protobuf/src)',
              ],
              "OTHER_LDFLAGS": [
                "-L<!(echo $PWD/caffe/build/lib)",
                "-Wl,-rpath,<!(echo $PWD/caffe/build/lib)",
              ],
              'GCC_ENABLE_CPP_RTTI': 'YES',
              'GCC_ENABLE_CPP_EXCEPTIONS': 'YES',
          },
        }],
        [ 'OS==\"linux\"', {
          'include_dirs': [
            '<!(node -e "require(\'opencv/include_dirs\')")',
          ],
          'libraries': [
            '<!@(pkg-config --libs opencv)',
            '-lcaffe',
          ],
          'cflags': [
            '-std=c++11',
            '-DBUILD_python=OFF',
            '-DBUILD_docs=OFF',
            '-DCPU_ONLY=ON',
            '-DUSE_GLOG=OFF',
            '-DUSE_LMDB=OFF',
            '-DUSE_LEVELDB=OFF',
            '-DUSE_HDF5=OFF',
            '-Wno-sign-compare',
            '-Wstrict-aliasing',
            '-Wno-sign-promo',
            '<!@(pkg-config --cflags opencv)',
            '-isystem <!(echo $PWD/caffe/src/)',
            '-isystem <!(echo $PWD/caffe/include/)',
            '-isystem <!(echo $PWD/caffe/build/include/)',
            '-isystem <!(echo $PWD/protobuf/src)',
          ],
          "ldflags": [
            "-L<!(echo $PWD/caffe/build/lib)",
            "-Wl,-rpath,<!(echo $PWD/caffe/build/lib)",
          ],
        }],
      ],
    },
  ],
}
