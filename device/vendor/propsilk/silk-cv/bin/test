#!/bin/bash -ex

LOCAL_PATH=$(dirname $0)

what="$@"
if [[ -z $what ]]; then
  what="$(find test -name '*_test.js')"
fi

if [[ -z "$DEBUG" ]]; then
  DEBUG="*"
fi

if [[ ! -d $LOCAL_PATH/../test/fixtures ]]; then
  git clone --depth 1 git@github.com:silklabs/silk-cv-test-fixtures.git $LOCAL_PATH/../test/fixtures
fi

# Lame hack to allow faceDetector.cpp to find the face landmark model from tests
if [[ ! -f system/silk/media/shape_predictor_68_face_landmarks.dat ]]; then
  if [[ ! -f node_modules/silk-external-dlib/shape_predictor_68_face_landmarks.dat ]]; then
    echo "npm install failed?"
    exit 1
  fi

  mkdir -p system/silk/media
  ln -sf $(readlink -f node_modules/silk-external-dlib/shape_predictor_68_face_landmarks.dat) \
    system/silk/media/shape_predictor_68_face_landmarks.dat
fi

export DYLD_INSERT_LIBRARIES=/usr/lib/libgmalloc.dylib
export MallocScribble=1
export MallocPreScribble=1
export MallocGuardEdges=1
export MallocCheckHeapAbort=1
export MallocErrorAbort=1
export MallocCheckHeapStart=1

export PATH=$PATH:$LOCAL_PATH/../node_modules/.bin
export DEBUG="$DEBUG"
mocha $what
