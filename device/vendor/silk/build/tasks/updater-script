show_progress(0.1, 1);
ui_print("Mounting /system");
# The /system block device can vary, try a couple common options
mount(ext4, EMMC, "/dev/block/bootdevice/by-name/system", "/system"); # CAF
mount(ext4, EMMC, "/dev/block/platform/msm_sdcc.1/by-name/system", "/system"); # AOSP
is_mounted("/system");

show_progress(0.1, 2);
ui_print("Removing old /system/silk");
delete_recursive("/system/silk");

show_progress(0.3, 15);
ui_print("Extracting /system/silk");
package_extract_dir(silk, "/system/silk");
set_metadata_recursive("/system/silk", uid, 0, gid, 2000, fmode, 0755, dmode, 0755);

show_progress(0.1, 1);
ui_print("Umounting /system");
unmount("/system");

set_progress(1);
ui_print(Success);
