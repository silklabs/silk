[include]
lib/
interface/

[ignore]
.*/dist/.*
.*/node_modules/eslint.*
.*/node_modules/babel.*
.*/node_modules/gulp.*
.*/node_modules/silk-socket.io.*
.*/node_modules/browserify.*
.*/node_modules/watchify.*

[libs]
interface/net.js

[options]
unsafe.enable_getters_and_setters=true
module.system=haste
esproposal.class_instance_fields=ignore
esproposal.class_static_fields=ignore

[version]
0.20.1
