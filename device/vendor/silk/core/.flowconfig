[include]
lib/
interface/
node_modules/silk-core-version
node_modules/silk-sdk/interface/

[ignore]
.*/dist/.*
.*/node_modules/eslint.*
.*/node_modules/babel.*
.*/node_modules/gulp.*
.*/node_modules/silk-socket.io.*
.*/node_modules/browserify.*
.*/node_modules/watchify.*

.*/api/test/.*
.*/azure-storage/test/.*
.*/server/test/.*
.*/server/tmp/.*
.*/server/src/.*
.*/streams/test/.*
.*/rtc/test/.*

[libs]
node_modules/silk-sdk/interface/silk-sysutils.js

[options]
unsafe.enable_getters_and_setters=true
module.system=haste
module.use_strict=true
esproposal.class_instance_fields=ignore
esproposal.class_static_fields=ignore
suppress_comment= \\(.\\|\n\\)*\\$FlowFixMe

[version]
0.25.0
