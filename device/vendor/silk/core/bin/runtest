#!/bin/bash -ex

LOCAL_PATH=$(dirname $0)

what="$@"
if [[ -z $what ]]; then
  what="$(find test -name '*_test.js')"
fi

if [[ -z "$DEBUG" ]]; then
  DEBUG="silk-*"
fi

DEPENDENCIES=$LOCAL_PATH/../../../../../pub/bsp-gonk/vendor/silk/
for p in silk-sysutils; do
  ( set -ex; cd $DEPENDENCIES/$p; test -d node_modules || npm install )
done

NODE_PATH=$DEPENDENCIES DEBUG="$DEBUG" mocha $what
