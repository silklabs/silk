#!/bin/bash -ex

LOCAL_PATH=$(dirname $0)

what="$@"
if [[ -z $what ]]; then
  what="$(find test -name '*_test.js')"
fi

# silk-core-version is assumed to already exist on device, so it needs to be
# manually installed here for local unit tests
if [[ ! -d $LOCAL_PATH/../node_modules/silk-core-version ]]; then
  npm install $LOCAL_PATH/../../../../../version
fi

env PATH=$PATH:$LOCAL_PATH/../node_modules/.bin DEBUG=* mocha $what
