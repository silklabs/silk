    "silk-rtc": "/rtc",
    "silk-api": "/api",
    "silk-azure-storage": "/azure-storage",
    "silk-raygun": "/raygun",
    "silk-sdk": "/pub/sdk",
    "silk-server": "/server",
    "silk-streams": "/streams",
    "silk-core-version": "/pub/version",
