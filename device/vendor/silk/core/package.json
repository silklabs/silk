{
  "name": "silk-device-main",
  "version": "0.0.1",
  "description": "The common control software on each silk node",
  "main": "core.js",
  "scripts": {
    "preinstall": "./bin/preinstall",
    "postinstall": "./bin/postinstall && npm run-script build",
    "build": "webpack --progress",
    "lax": "LAX=1 ./build",
    "test": "./bin/runtest",
    "lint": "eslint lib",
    "flow": "flow check",
    "posttest": "npm run-script lint && npm run-script flow",
    "clean": "rm -rf node_modules silk-device-main.js silk-device-main.js.map"
  },
  "symlinkDependencies": {
    "babel-core": "/pub/babel-core",
    "babel-preset-silk-node4": "/pub/babel-preset-silk-node4",
    "eslint-config-silk": "/pub/eslint-config",
    "silk-audio": "/audio",
    "silk-babeldeps": "/babeldeps",
    "silk-config": "/config",
    "silk-core-version": "/pub/version",
    "silk-flow-bin": "/flow-bin",
    "silk-log": "/pub/log",
    "silk-rtc": "/rtc",
    "silk-api": "/api",
    "silk-azure-storage": "/azure-storage",
    "silk-raygun": "/raygun",
    "silk-sdk": "/pub/sdk",
    "silk-server": "/server",
    "silk-streams": "/streams",
    "silk-utils": "/utils"
  },
  "dependencies": {
    "CBuffer": "1.1.0",
    "babel-eslint": "5.0.0",
    "babel-loader": "6.2.0",
    "babel-runtime": "6.3.19",
    "byline": "4.2.1",
    "copy-webpack-plugin": "2.1.5",
    "eslint": "1.10.3",
    "eslint-plugin-import": "0.12.0",
    "event-to-promise": "0.4.0",
    "is-online": "5.0.1",
    "is-reachable": "1.2.0",
    "joi": "6.10.1",
    "json-loader": "0.5.4",
    "mkdirp-promise": "1.0.3",
    "mold-source-map": "0.4.0",
    "mz": "2.0.0",
    "request": "2.58.0",
    "socket.io-client": "1.4.6",
    "source-map-support": "0.3.3",
    "split": "1.0.0",
    "validator": "3.41.2",
    "webpack": "1.13.0",
    "ws": "^1.0.1"
  },
  "devDependencies": {
    "mocha": "2.4.2",
    "node-fetch": "1.3.3",
    "node-webrtc": "git+ssh://git@github.com/silklabs/node-webrtc#master"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:silklabs/silk-device.git"
  },
  "keywords": [
    "iot"
  ],
  "engines": {
    "node": "4.2"
  },
  "private": true
}
