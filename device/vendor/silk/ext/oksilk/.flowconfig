[include]
lib/
interface/

[ignore]
.*/dist/.*
.*/node_modules/eslint.*
.*/node_modules/gulp.*
.*/node_modules/browserify.*
.*/node_modules/watchify.*
.*/node_modules/mz.*

[libs]
interface/pocketsphinx.js

[options]
unsafe.enable_getters_and_setters=true
module.system=haste
esproposal.class_instance_fields=ignore
esproposal.class_static_fields=ignore

[version]
0.21.0
