{
  "name": "oksilk",
  "version": "0.0.1",
  "description": "Continous voice recognition using PocketSphinx",
  "main": "oksilk.js",
  "scripts": {
    "preinstall": "if [ -d ../../locked_node_modules ]; then ../../locked_node_modules/fetch.sh; fi",
    "postinstall": "./bin/postinstall",
    "clean": "rm -rf node_modules oksilk.js oksilk.js.map"
  },
  "silkDependencies": {
    "silk-babeldeps": "/babeldeps",
    "silk-config": "/config",
    "silk-exttest": "/device/vendor/silk/sdk/exttest",
    "silk-sdk-glue": "/device/vendor/silk/sdk/glue",
    "silk-flow-bin": "/flow-bin",
    "silk-log": "/log"
  },
  "dependencies": {
    "babel-runtime": "5.8.35"
  },
  "devDependencies": {
    "babel": "5.8.35"
  },
  "private": true
}
