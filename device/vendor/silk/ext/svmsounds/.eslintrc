{
  "extends": "eslint-config-silk",
  "env": {
    "mocha": true
  },
  "plugins": [
    "import"
  ],
  "rules": {
    "comma-dangle": 0,
    "import/no-require": 2,
    "import/no-unresolved": 0,
    // Seems to play badly with flow...
    "import/namespace": 0,
    "import/named": 0,
    "import/default": 0,
    "import/no-duplicates": 0,
  }
}
