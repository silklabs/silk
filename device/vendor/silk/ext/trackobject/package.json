{
  "name": "trackobject",
  "version": "0.0.1",
  "description": "OpenCV extension to track objects",
  "main": "trackobject.js",
  "scripts": {
    "preinstall": "if [ -d ../../locked_node_modules ]; then ../../locked_node_modules/fetch.sh; fi",
    "postinstall": "./bin/postinstall",
    "pretest": "npm install node-pre-gyp@0.6.11 && npm install opencv@4.0.0",
    "test": "DEBUG=* mocha $(find test -name '*_test.js')",
    "clean": "rm -rf node_modules"
  },
  "silkDependencies": {
    "silk-babeldeps": "/babeldeps",
    "silk-exttest": "/device/vendor/silk/sdk/exttest",
    "silk-sdk-glue": "/device/vendor/silk/sdk/glue",
    "log": "/log"
  },
  "dependencies": {
    "babel-runtime": "^5.8.20",
    "mz": "2.0.0"
  },
  "devDependencies": {
    "babel": "^5.8.23",
    "event-to-promise": "^0.4.0",
    "mocha": "^2.3.3"
  },
  "private": true
}
