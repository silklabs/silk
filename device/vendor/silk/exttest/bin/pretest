#!/bin/bash -ex

# Resolve to realpath....
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$( cd -P "$( dirname "$SOURCE" )" && pwd )"

cd $ROOT/../../../../../

ensure_native_built() {
  local module=$1
  local module_path=node_modules/$1
  pwd

  if [[ -f $module_path/binding.gyp ]]; then
    local build_dir=$module_path/build
    if [[ ! -d $build_dir  || -z $(find $build_dir -name '*.node') ]]; then
      # JOBS=MAX causes -j<cores> in node-gyp.
      JOBS=MAX npm build $module_path
    fi
  fi
}

# TODO: Kill this eventually
npm build node_modules/silk-external-dlib

modules=(
  kissfft
  opencv
  silk-capture
  silk-cv
)

for module in "${modules[@]}"; do
  ensure_native_built $module
done

