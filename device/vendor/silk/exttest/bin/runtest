#!/bin/bash -ex

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$( cd -P "$( dirname "$SOURCE" )" && pwd )"

what="$@"
if [[ -z $what ]]; then
  what="$(find test -name '*_test.js')"
fi

if [[ -z "$DEBUG" ]]; then
  DEBUG="silk-*"
fi

MOCHA_OPTS_PATH=$ROOT/../test/mocha.opts
PATH=$ROOT/../../../../../node_modules/.bin:$PATH
DEBUG="$DEBUG" mocha --opts $MOCHA_OPTS_PATH $what
