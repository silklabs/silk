#!/bin/bash -ex

LOCAL_PATH=$(dirname $0)

what="$@"
if [[ -z $what ]]; then
  what="$(find test -name '*_test.js')"
fi

if [[ -z "$DEBUG" ]]; then
  DEBUG="silk-*"
fi

MOCHA_OPTS_PATH=$LOCAL_PATH/../silk-exttest/test/mocha.opts
NODE_PATH=$LOCAL_PATH/.. DEBUG="$DEBUG" mocha --opts $MOCHA_OPTS_PATH $what
