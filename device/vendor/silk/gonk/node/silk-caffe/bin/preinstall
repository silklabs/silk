#!/bin/bash -e

usage()
{
  echo "Usage: $0 [-p|-h]"
  echo
  echo "Install Caffe and its dependencies"
  echo
  echo " -p        Path to patch scripts for dlib and caffe"
  echo " -h        Display this message"
  exit 1
}

while getopts "hp:" opt; do
  case $opt in
    h)
        usage;;
    p)  PATCH_TREE="$OPTARG"
        ;;
   \?) echo "Error: Invalid option -$OPTARG"; exit 1;;
  esac
done

if [[ -z $PATCH_TREE ]]; then
  PATCH_TREE=$DEVICE_PATCH_TREE
fi

echo "Using patch folder: $PATCH_TREE"

if [[ "$NPM_CONFIG_PLATFORM" == "android" ]]; then
  echo "Caffe installation is only supported on Darwin"
  exit 0
fi

UNAMESTR=`uname`
if [[ "$UNAMESTR" != 'Darwin' ]]; then
  echo "Caffe installation is only supported on Darwin"
  exit 0
fi

# Install node-opencv
if [[ ! -d node_modules/opencv ]]; then
 npm install peterbraden/node-opencv#ead733ba3410ed6112ba6e19552c99db2d21359c --ignore-scripts
fi

# Install protobuf and compile as static library
# Reference https://github.com/BVLC/caffe/issues/1917
if [[ ! -d protobuf ]]; then
  echo Compiling protobuf
  git clone https://github.com/google/protobuf
  pushd protobuf

  # Default brew formula for protobuf is v2.6.1
  # We need the same protobuf version for caffe as opencv3 is compiled with
  # default protobuf version v2.6.1 or else there is a run time conflict
  git checkout tags/v2.6.1 -b v2.6.1
  ./autogen.sh
  ./configure --disable-shared
  make -j2
  popd
fi

# Download dlib
if [[ ! -d dlib ]]; then
  echo Downloading dlib

  git clone git@github.com:davisking/dlib.git

  # Patch dlib
  echo patching dlib
  pushd dlib
  PATCHES=$(find $PATCH_TREE/dlib -name \*.patch | sort -fs)
  for P in ${PATCHES}; do
    git am --quiet $P
  done
  popd
fi

# Download caffe
if [[ ! -d caffe ]]; then
  echo Downloading caffe
  git clone git@github.com:BVLC/caffe.git

  # Patch caffe
  echo patching caffe
  pushd caffe
  git am --quiet $PATCH_TREE/caffe/0001-Select-correct-version-of-vecLib.patch
  popd
fi

# Install caffe
PROTOBUF_ROOT=$(pwd)/protobuf
echo "protobuf root $PROTOBUF_ROOT"
if [[ ! -f caffe/build/lib/libcaffe.dylib ]]; then
  echo "Compiling caffe"
  pushd caffe
  mkdir -p build
  pushd build
  cmake \
    -DCPU_ONLY=ON \
    -DBUILD_python=OFF \
    -DBUILD_matlab=OFF \
    -DPROTOBUF_PROTOC_EXECUTABLE=$PROTOBUF_ROOT/src/protoc \
    -DPROTOBUF_INCLUDE_DIR=$PROTOBUF_ROOT/src \
    -DPROTOBUF_LIBRARY=$PROTOBUF_ROOT/src/.libs/libprotobuf.a \
    ..
  make all -j2
  popd
  popd
fi
