LOCAL_PATH:= $(call my-dir)

ifneq ($(TARGET_PRODUCT),silk_arm)  # Skip in the minimal build

include $(CLEAR_VARS)
LOCAL_MODULE       := silk-base_version
LOCAL_MODULE_STEM  := base_version.js
LOCAL_MODULE_TAGS  := optional
LOCAL_MODULE_CLASS := ETC
LOCAL_SRC_FILES    := ../../core/lib/base_version.js
LOCAL_MODULE_PATH  := $(TARGET_OUT)/node_modules
include $(BUILD_PREBUILT)

endif

include $(CLEAR_VARS)
LOCAL_MODULE       := silk-core_version
LOCAL_MODULE_STEM  := core_version.js
LOCAL_MODULE_TAGS  := optional
LOCAL_MODULE_CLASS := ETC
LOCAL_MODULE_PATH  := $(TARGET_OUT_SILK_NODE_MODULES)
LOCAL_CUSTOM_BUILT_MODULE := true
include $(BUILD_PREBUILT)

$(LOCAL_BUILT_MODULE):
	$(hide) mkdir -p $(@D)
	$(hide) echo "/*AUTOGENERATED*/" > $@
	$(hide) echo "module.exports = '$(BUILD_FINGERPRINT)';" >> $@

