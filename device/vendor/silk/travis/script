#!/bin/bash -e

echo PWD=$PWD
if [ ! -d core ]; then
  echo core/ not found
  exit 0
fi

echo "## Running unit tests ##"
dirs=(core \
      ext/*/ \
      ../propsilk/silk-audio-dnn/ \
      ../propsilk/silk-dialog-storage/ \
      )
for dir in ${dirs[@]}; do
  if [ -d "$dir/test" ]; then
    echo "### Testing $dir"
    pushd "$dir"
    NPM_CONFIG_REGISTRY="" npm test
    popd
  fi
done

exit 0
