#!/bin/bash -ex

cd $(dirname $0)/..

APIDOC_SOURCE_FILES=" \
  ../../dialog-engine/lib/index.js \
  ../../bsp-gonk/vendor/propsilk/silk-dialog-storage/lib/index.js \
  ../../bsp-gonk/vendor/propsilk/silk-factory-reset/lib/index.js \
  ../../bsp-gonk/vendor/propsilk/silk-netstatus/lib/index.js \
  ../../pub/bsp-gonk/vendor/silk/silk-lights/lib/index.js \
  ../../pub/bsp-gonk/vendor/silk/silk-volume/lib/index.js \
"

./node_modules/.bin/documentation \
  build \
  $APIDOC_SOURCE_FILES \
  --project-version master \
  -f html \
  -o dist/dialog-script-api \
  --shallow \
  -t node_modules/documentation-theme-default \
  --name silk-dialog-script-api

du -hs dist/dialog-script-api
