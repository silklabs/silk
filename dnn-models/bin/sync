#!/bin/bash -e

TAG=tag1

if [[ -d silk-dnn ]]; then
  LATEST=$(cat silk-dnn/.gittag || echo unknown)

  if [[ "$LATEST" != "$TAG" ]]; then
    echo updating dnn model
    rm -rf silk-dnn
  fi
fi

if [[ ! -d silk-dnn ]]; then
  git clone --depth 1 git@github.com:silklabs/silk-dnn.git silk-dnn -b $TAG

  # Assemble tiny-yolo model file
  for model in tiny-{coco,yolo}; do
    make -C silk-dnn/models/$model
  done
 # 2>&1 > /dev/null

  # Remove split files/.git to reduce disk space (Travis!)
  rm -rf silk-dnn/.git
  find . -name \*.gz_* | xargs rm -rvf

  echo $TAG > silk-dnn/.gittag
  du -hs silk-dnn/
fi

