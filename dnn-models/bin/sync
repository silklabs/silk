#!/bin/bash -e

SHA1=184d577020d611e2abb783706e55e948ee89e78c

if [[ -d silk-dnn ]]; then
  pushd silk-dnn 2>&1 > /dev/null
  LATEST=$(git rev-parse HEAD)
  popd 2>&1 > /dev/null

  if [[ $LATEST != $SHA1 ]]; then
    echo updating dnn model
    rm -rf silk-dnn
  fi
fi

if [[ ! -d silk-dnn ]]; then
  git clone git@github.com:silklabs/silk-dnn.git silk-dnn
  pushd silk-dnn 2>&1 > /dev/null
  git checkout $SHA1
  popd
fi
