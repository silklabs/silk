#!/bin/bash -e

SHA1=677546d7fbbb492ab130334575bea078b29aae91

if [[ -d silk-dnn ]]; then
  pushd silk-dnn 2>&1 > /dev/null
  LATEST=$(git rev-parse HEAD)
  popd 2>&1 > /dev/null

  if [[ $LATEST != $SHA1 ]]; then
    echo updating dnn model
    rm -rf silk-dnn
  fi
fi

if [[ ! -d silk-dnn ]]; then
  git clone git@github.com:silklabs/silk-dnn.git silk-dnn
  pushd silk-dnn 2>&1 > /dev/null
  git checkout $SHA1

  # Assemble tiny-yolo model file
  pushd models/tiny-yolo 2>&1 > /dev/null
  make
  popd 2>&1 > /dev/null

  # Assemble tiny-coco model file
  pushd models/tiny-coco 2>&1 > /dev/null
  make
  popd 2>&1 > /dev/null

  popd 2>&1 > /dev/null
fi

