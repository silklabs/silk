#!/bin/bash -e

SHA1=e34ce71aa0ee04e6dcca25a0d99cee083a3135c0

if [[ -d silk-dnn ]]; then
  pushd silk-dnn 2>&1 > /dev/null
  LATEST=$(git rev-parse HEAD)
  popd 2>&1 > /dev/null

  if [[ $LATEST != $SHA1 ]]; then
    echo updating dnn model
    rm -rf silk-dnn
  fi
fi

if [[ ! -d silk-dnn ]]; then
  git clone git@github.com:silklabs/silk-dnn.git silk-dnn
  pushd silk-dnn 2>&1 > /dev/null
  git checkout $SHA1
  popd
fi
