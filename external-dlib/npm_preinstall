#!/bin/bash -ex

HEAD=v18.18

if [[ ! -d dlib ]]; then
  git clone --depth 1 git@github.com:davisking/dlib.git -b $HEAD dlib
fi

if [[ ! -f dlib/.patched ]]; then
  cd dlib/
  git am --abort || true
  git reset --hard $HEAD
  git clean -dfx
  for p in ../patch/*; do
    git am $p
  done
  cd ..
  touch dlib/.patched
fi

exit 0
