#!/bin/bash -ex


while true; do
  echo $$ >> lock
  OWNER=$(head -n1 lock)
  if [[ "$OWNER" == "$$" ]]; then
    break;
  fi
  echo $0: Waiting for lock...
  sleep 1s
done

HEAD=v18.18

if [[ ! -d dlib ]]; then
  git clone --depth 1 git@github.com:davisking/dlib.git -b $HEAD dlib
fi

if [[ ! -f dlib/.patched ]]; then
  cd dlib/
  git am --abort || true
  git reset --hard $HEAD
  git clean -dfx
  for p in ../patch/*; do
    git am $p
  done
  cd ..
  touch dlib/.patched
fi

if [[ ! -f shape_predictor_68_face_landmarks.dat ]]; then
  rm -f shape_predictor_68_face_landmarks.dat.bz2
  wget http://dlib.net/files/shape_predictor_68_face_landmarks.dat.bz2
  bzip2 -d shape_predictor_68_face_landmarks.dat.bz2
fi

function unlock() {
  echo "Removing lock file"
  rm -rf lock
}
trap unlock HUP INT QUIT TERM EXIT
exit 0
