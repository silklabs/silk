/* @flow */

type HeaderInit = {[key: string]: string};

declare export class Headers {
  constructor(headers?: HeaderInit): void;
  append(name: string, value: string): void;
  delete(name: string): void;
  get(name: string): string;
  has(name: string): bool;
  set(name: string, value: string): void;
}

declare export class Response {
  url: string;
  status: number;
  statusText: string;
  headers: Headers;
  ok: bool;

  json(): Promise<Object>;
  text(): Promise<string>;
}

export type RequestBody = Buffer | string | Object;

export type FetchOptions = {
  method: string;
  // Fetch will take an object literal here as well, but we will only
  // allow a Headers object.
  headers?: Headers,
  body?: Buffer | string | Object;
}

declare export default (
  url: string,
  options?: FetchOptions,
) => Promise<Response>;
