/**
 * Override Flow's definition for node's child_process module to fix the
 * return type of ChildProcess.prototype.send.
 *
 * See https://github.com/facebook/flow/pull/1867 for the upstream fix.
 *
 * @flow
 * @providesModule child_process
 */

import EventEmitter from 'events';
import type {Readable, Writable} from 'stream';

type ExecOpts = {
  cwd?: string;
  env?: Object;
  encoding?: string;
  shell?: string;
  timeout?: number;
  maxBuffer?: number;
  killSignal?: string;
  uid?: number;
  gid?: number;
};

type ExecCallback = (error: ?Error, stdout: Buffer, stderr: Buffer) => void;

type ExecSyncOpts = {
  cwd?: string;
  input?: string | Buffer;
  stdio?: Array<any>;
  env?: Object;
  uid?: number;
  gid?: number;
  timeout?: number;
  killSignal?: string;
  maxBuffer?: number;
  encoding?: string;
};

type ExecFileOpts = {
  cwd?: string;
  env?: Object;
  encoding?: string;
  timeout?: number;
  maxBuffer?: number;
  killSignal?: string;
  uid?: number;
  gid?: number;
};

type ExecFileCallback = (error: ?Error, stdout: Buffer, stderr: Buffer) => void;

type ForkOpts = {
  cwd?: string;
  env?: Object;
  execPath?: string;
  execArgv?: Array<string>;
  silent?: boolean;
  uid?: number;
  gid?: number;
};

export type Handle = any; // TODO

type SpawnOpts = {
  cwd?: string;
  env?: Object;
  stdio?: string | Array<any>;
  detached?: boolean;
  uid?: number;
  gid?: number;
};

type SpawnRet = {
  pid: number;
  output: Array<any>;
  stdout: Buffer | string;
  stderr: Buffer | string;
  status: number;
  signal: string;
  error: Error;
};

declare export class ChildProcess extends EventEmitter {
  stdin: Writable;
  stdout: Readable;
  stderr: Readable;
  pid: number;
  connected: boolean;

  disconnect(): void;
  kill(signal?: string): void;

  // Flow defined the return type as `void` here.
  send(message: Object, sendHandle?: Handle): boolean;
}

declare export function exec(
  command: string,
  optionsOrCallback?: ExecOpts | ExecCallback,
  callback?: ExecCallback
): ChildProcess;

declare export function execSync(
  command: string,
  options: {encoding: buffer$NonBufferEncoding} & ExecSyncOpts
): string;

declare export function execSync(
  command: string,
  options?: ExecSyncOpts
): Buffer;

declare export function execFile(
  file: string,
  argsOrOptionsOrCallback?:
    Array<string> | ExecFileOpts | ExecFileCallback,
  optionsOrCallback?: ExecFileOpts | ExecFileCallback,
  callback?: ExecFileCallback
): ChildProcess;

declare export function execFileSync(
  command: string,
  argsOrOptions?: Array<string> | ExecFileOpts,
  options?: ExecFileOpts
): Buffer | string;

declare export function fork(
  modulePath: string,
  argsOrOptions?: Array<string> | ForkOpts,
  options?: ForkOpts
): ChildProcess;

declare export function spawn(
  command: string,
  argsOrOptions?: Array<string> | SpawnOpts,
  options?: SpawnOpts
): ChildProcess;

declare export function spawnSync(
  command: string,
  argsOrOptions?: Array<string> | SpawnOpts,
  options?: SpawnOpts
): SpawnRet;
