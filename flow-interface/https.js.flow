/**
 * @flow
 * @providesModule https
 */

declare export class Server extends tls$Server {
  listen(
    port: number,
    hostname?: string,
    backlog?: number,
    callback?: Function
  ): Server;
  listen(path: string, callback?: Function): Server;
  listen(handle: Object, callback?: Function): Server;
  close(callback?: Function): Server;
  setTimeout(msecs: number, callback: Function): Server;
  timeout: number;
};

declare export class ClientRequest extends http$ClientRequest {
};

declare export class IncomingMessage extends http$IncomingMessage {
};

declare export function createServer(
  options: Object,
  secureConnectionListener?: function
): Server;
declare export function request(
  options: Object | string,
  callback?: (response: IncomingMessage) => void
): ClientRequest;
declare export function get(
  options: Object | string,
  callback?: (response: IncomingMessage) => void
): ClientRequest;
