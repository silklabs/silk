/**
 * For some reason, Flow has a problem parsing the mp4box module in node_modules,
 * so we'll provide a Flow interface definition here instead.
 *
 * @providesModule mp4box
 * @flow
 */

type MP4Info = any;

declare export class MP4Box {
  onError: (error: Error) => any;
  onReady: (info: MP4Info) => any;

  appendBuffer(data: ArrayBuffer): void;
  flush(): void;
}
