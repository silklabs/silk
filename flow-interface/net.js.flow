/**
 * Sadly we need to replicate Flow's definitions for node's 'net' module here.
 * Otherwise things like the `Server` type aren't importable from it, for
 * whatever reason.
 *
 * @flow
 * @providesModule net
 */

declare export class Server extends net$Server {}
declare export class Socket extends net$Socket {}

declare export function isIP(input: string): number;
declare export function isIPv4(input: string): boolean;
declare export function isIPv6(input: string): boolean;


declare type connectionListener = (socket: Socket) => any;

declare export function createServer(
  options?: {
    allowHalfOpen?: boolean,
    pauseOnConnect?: boolean,
  } | connectionListener,
  connectionListener?: connectionListener,
): Server;


declare type connectListener = () => any;

declare export function connect(
  pathOrPortOrOptions:  string | number | net$connectOptions,
  hostOrConnectListener?: string | connectListener,
  connectListener?: connectListener,
): Socket;

declare export function createConnection(
  pathOrPortOrOptions:  string | number | net$connectOptions,
  hostOrConnectListener?: string | connectListener,
   connectListener?: connectListener,
): Socket;
