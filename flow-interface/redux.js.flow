/**
 * Flow interface for redux.
 *
 * @flow
 * @providesModule redux
 */

export interface Action {
  type: string | Symbol;
};

export interface State {
};

export type Reducer<S: State> = (state: S, action: Action) => S;

export interface ReducersMapObject {
  [key: string]: Reducer<State>;
};

declare export function combineReducers<S>(
  reducers: ReducersMapObject
): Reducer<S>;

export type Dispatch<S: State> = (action: Action) => Action;
export type Unsubscribe = () => void;

export type Store<S: State> = {
  dispatch: Dispatch<S>;
  getState(): S;
  subscribe(listener: () => void): Unsubscribe;
  replaceReducer(nextReducer: Reducer<S>): void;
};

export type StoreCreator<S: State> = (
  reducer: Reducer<S>,
  initialOrEnhancer?: S | StoreEnhancer<S>,
  enhancer?: StoreEnhancer<S>
) => Store<S>;

export type StoreEnhancer<S: Object> = (
  next: StoreEnhancerStoreCreator<S>
) => StoreEnhancerStoreCreator<S>;

export type GenericStoreEnhancer<S: Object> = (
  next: StoreEnhancerStoreCreator<S>
) => StoreEnhancerStoreCreator<S>;

export type StoreEnhancerStoreCreator<S: Object> = (
  reducer: Reducer<S>,
  initialState: S
) => Store<S>;

declare export var createStore: StoreCreator<State>;

export interface MiddlewareAPI<S> {
  dispatch: Dispatch<S>;
  getState(): S;
};

export type Middleware<S: Object, api: MiddlewareAPI<S>> = (
  next: Dispatch<S>
) => Dispatch<S>;

declare export function applyMiddleware(
  ...middlewares: Array<Middleware<Object, MiddlewareAPI<Object>>>
): GenericStoreEnhancer<Object>;

export type ActionCreator<A: Action> = (
  ...args: Array<any>
) => A;

export interface ActionCreatorsMapObject {
  [key: string]: ActionCreator<Action>;
};

declare export function bindActionCreators<A: ActionCreator<Action>>(
  actionCreator: A,
  dispatch: Dispatch<State>
): A;

declare export function bindActionCreators<
  A: ActionCreator<Action>,
  B: ActionCreator<Action>
>(
  actionCreator: A,
  dispatch: Dispatch<State>
): B;

declare export function bindActionCreators<
  M: ActionCreatorsMapObject,
  N: ActionCreatorsMapObject
>(
  actionCreators: M,
  dispatch: Dispatch<State>
): N;

declare export function compose<R>(
  a: R,
  ...args: Array<any>
): R;

declare export function compose<A, R>(
  f1: (b: A) => R,
  f2: (...args: Array<any>) => A
): (...args: Array<any>) => R;

declare export function compose<A, B, R>(
  f1: (b: B) => R,
  f2: (a: A) => B,
  f3: (...args: Array<any>) => A
): (...args: Array<any>) => R;

declare export function compose<A, B, C, R>(
  f1: (b: C) => R,
  f2: (a: B) => C,
  f3: (a: A) => B,
  f4: (...args: Array<any>) => A
): (...args: Array<any>) => R;

declare export function compose<R>(
  f1: (a: any) => R,
  ...funcs: Array<Function>
): (...args: Array<any>) => R;
