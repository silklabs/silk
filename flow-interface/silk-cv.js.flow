/**
 * @providesModule silk-cv
 * @flow
 */

import type { Matrix } from 'opencv';

/**
 * Type representing a rectangle
 *
 * @property x x co-ordinate of the rectangle
 * @property y y co-ordinate of the rectangle
 * @property width width of the rectangle
 * @property height height of the rectangle
 */
type Rect = {
  x: number;
  y: number;
  width: number;
  height: number;
};

type Options = {
  drawPoints?: bool;
};

type FrameResults = {
  confidence: number;
  angle: number;
  size: {
    width: number;
    height: number;
  };
  boundingRect: Rect;
};

declare export class Cmt {
  constructor(
    trainingFrame: Matrix,
    objectRect: Rect,
    initializedCallback: Function,
    options?: Options
  ): void;

  nextFrame(
    frame: Matrix,
    processedCallback: (err: ?Error, results: ?FrameResults) => void,
  ): void;

  busy(): bool;
};

export type SubtractorCallbackType = (motion: Matrix) => void;

declare export class Mog2Subtractor {
  constructor(history: number, varThreshold: number): void;
  getBackground(mat: Matrix): void;
  apply(image: Matrix, mat: Matrix, cb: SubtractorCallbackType): void;
}
