/**
 * @flow
 * @providesModule sonos
 */

import EventEmitter from 'events';

type QueryOptions = {
  start?: number;
  total?: number;
};

type QueryResult = {
  returned: string;
  total: string;
  items: Array<{title: string; uri: string;}>
};

type QueryCallback = (error: ?Error, result: ?QueryResult) => any;

export type Track = {
  title?: string;
  artist?: string;
  album?: string;
  albumArtURI?: string;
  position?: number;
  duration?: number;
  albumArtURL?: string;
}

export type State =
    'stopped'
  | 'playing'
  | 'paused'
  | 'transitioning'
  | 'no_media'
  ;

declare export class Sonos {
  constructor(host: string, port: string): void;

  pause(callback: (error: ?Error, paused: boolean) => any): void;
  play(uri: string, callback: (error: ?Error, playing: boolean) => any): void;
  stop(callback: (error: ?Error, stopped: boolean) => any): void;
  next(callback: (error: ?Error, movedToNext: boolean) => any): void;
  previous(callback: (error: ?Error, movedToPrevious: boolean) => any): void;
  queueNext(uri: string, callback: (error: ?Error, queued: boolean) => any): void;
  queue(uri: string, position: number, callback: (error: ?Error, queued: boolean) => any): void;
  flush(callback: (error: ?Error, flushed: boolean) => any): void;

  getMusicLibrary(search: string, options: ?QueryOptions, ): void;
  currentTrack(callback: (error: ?Error, track: Track) => any): void;
  currentTrack(callback: (error: ?Error, state: State) => any): void;
  getVolume(callback: (error: ?Error, volume: number) => any): void;
  getMuted(callback: (error: ?Error, muted: boolean) => any): void;

  setVolume(volume: number, callback: (error: ?Error, muted: boolean) => any): void;
  setMuted(muted: boolean, callback: (error: ?Error, muted: boolean) => any): void;

}

declare export class Search extends EventEmitter {
  destroy(callback: (() => any)): void;
}
declare export function search(
  listener?: (device: Sonos, model: string) => any
): Search;
