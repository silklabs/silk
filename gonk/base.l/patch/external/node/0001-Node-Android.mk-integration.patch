From 3f19eebcae8d86695e8e30c7118dbf8be713c7d7 Mon Sep 17 00:00:00 2001
From: Chris Jones <chris@silklabs.com>
Date: Sat, 16 May 2015 22:38:54 -0700
Subject: [PATCH] Node Android.mk integration

---
 Android.mk                   | 53 ++++++++++++++++++++++++++++++++++++++++++++
 deps/v8/build/toolchain.gypi |  2 +-
 src/stream_wrap.h            |  2 +-
 3 files changed, 55 insertions(+), 2 deletions(-)
 create mode 100644 Android.mk

diff --git a/Android.mk b/Android.mk
new file mode 100644
index 0000000..c9590af
--- /dev/null
+++ b/Android.mk
@@ -0,0 +1,53 @@
+LOCAL_PATH := $(call my-dir)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := node
+LOCAL_MODULE_CLASS := EXECUTABLE
+LOCAL_MODULE_TAGS := optional debug
+LOCAL_MODULE_PATH := $(TARGET_OUT)/bin
+LOCAL_PREBUILT_MODULE_FILE := $(LOCAL_PATH)/out/Release/node
+include $(BUILD_PREBUILT)
+
+node_CC := $(abspath $(TARGET_CC))
+node_CXX := $(abspath $(TARGET_CXX))
+node_AR := $(abspath $(TARGET_AR))
+node_RANLIB := $(abspath $(TARGET_RANLIB))
+node_LINK := $(abspath $(TARGET_CXX))
+node_CFLAGS := $(TARGET_GLOBAL_CFLAGS) $(addprefix -isystem ,$(abspath . $(TARGET_C_INCLUDES)))
+node_CXXFLAGS := $(TARGET_GLOBAL_CPPFLAGS) -DV8_ANDROID_LOG_STDOUT $(addprefix -isystem ,$(abspath $(LOCAL_PATH)/../stlport/stlport $(LOCAL_PATH)/../../bionic))
+node_LDFLAGS := $(TARGET_GLOBAL_LDFLAGS) -pie -B$(abspath $(PRODUCT_OUT)/obj/lib) -L$(abspath $(PRODUCT_OUT)/system/lib) -lstlport
+
+node_BUILD_DIR := $(abspath $(PRODUCT_OUT)/node-Release)
+
+with_node_build_env = \
+	(export CC="$(node_CC)" CXX="$(node_CXX)" AR="$(node_AR)" RANLIB="$(node_RANLIB)" LINK="$(node_LINK)" \
+        CFLAGS="$(node_CFLAGS)" \
+        CXXFLAGS="$(node_CFLAGS) $(node_CXXFLAGS)" \
+        LDFLAGS="$(node_LDFLAGS)"; \
+	$(1))
+
+in_local_dir = \
+	cd $(1) && \
+	$(2) && \
+	cd $(TOPDIR)
+
+ifeq ($(strip $(SHOW_COMMANDS)),)
+verbose=''
+else
+verbose=1
+endif
+
+$(LOCAL_PATH)/out/Release/node: $(LOCAL_PATH)/configure \
+  $(TARGET_CRTBEGIN_DYNAMIC_O) \
+  $(TARGET_CRTEND_O) \
+  $(addprefix $(PRODUCT_OUT)/obj/lib/,libc.so libdl.so liblog.so libstlport.so)
+	@echo Building: $@
+	$(hide) rm -f $(dir $<)config.mk
+	$(hide) rm -rf $(dir $<)out
+	$(hide) rm -rf $(node_BUILD_DIR)
+	$(hide) mkdir -p $(node_BUILD_DIR)
+	$(hide) ln -s $(node_BUILD_DIR) $(dir $<)out
+	$(hide) $(call with_node_build_env,$(call in_local_dir,$(dir $<),./configure --prefix=/ --without-snapshot --without-npm --dest-cpu=arm --dest-os=android))
+	$(hide) mv $(dir $<)config.mk $(dir $<)out
+	$(hide) ln -s $(abspath $(dir $<)out/config.mk) $(dir $<)config.mk
+	$(hide) $(call with_node_build_env,make -j16 -C $(dir $<) V=$(verbose))
diff --git a/deps/v8/build/toolchain.gypi b/deps/v8/build/toolchain.gypi
index 1d47360..f46f5ca 100644
--- a/deps/v8/build/toolchain.gypi
+++ b/deps/v8/build/toolchain.gypi
@@ -477,7 +477,7 @@
         },
       }],
       ['(OS=="linux" or OS=="freebsd"  or OS=="openbsd" or OS=="solaris" \
-         or OS=="netbsd" or OS=="mac" or OS=="android" or OS=="qnx") and \
+         or OS=="netbsd" or OS=="mac" or OS=="qnx") and \
         (v8_target_arch=="arm" or v8_target_arch=="ia32" or \
          v8_target_arch=="x87" or v8_target_arch=="mips" or \
          v8_target_arch=="mipsel")', {
diff --git a/src/stream_wrap.h b/src/stream_wrap.h
index d993663..ef3891d 100644
--- a/src/stream_wrap.h
+++ b/src/stream_wrap.h
@@ -74,7 +74,7 @@ class WriteWrap: public ReqWrap<uv_write_t> {
  private:
   // People should not be using the non-placement new and delete operator on a
   // WriteWrap. Ensure this never happens.
-  void* operator new(size_t size) { assert(0); }
+  void* operator new(size_t size) { assert(0); return 0; }
   void operator delete(void* ptr) { assert(0); }
 
   StreamWrap* const wrap_;
-- 
1.9.1

