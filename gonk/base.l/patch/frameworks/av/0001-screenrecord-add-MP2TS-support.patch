From 18a8419a9a21815d0ebb060e9397018adb047c8c Mon Sep 17 00:00:00 2001
From: Chris Jones <chris@silklabs.com>
Date: Tue, 16 Jun 2015 21:18:46 -0700
Subject: [PATCH 1/4] screenrecord: add MP2TS support

---
 cmds/screenrecord/screenrecord.cpp     | 7 ++++++-
 include/media/stagefright/MediaMuxer.h | 1 +
 media/libstagefright/MediaMuxer.cpp    | 3 +++
 3 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/cmds/screenrecord/screenrecord.cpp b/cmds/screenrecord/screenrecord.cpp
index 02df1d2..7a0b873 100644
--- a/cmds/screenrecord/screenrecord.cpp
+++ b/cmds/screenrecord/screenrecord.cpp
@@ -66,7 +66,7 @@ static const char* kMimeTypeAvc = "video/avc";
 static bool gVerbose = false;           // chatty on stdout
 static bool gRotate = false;            // rotate 90 degrees
 static enum {
-    FORMAT_MP4, FORMAT_H264, FORMAT_FRAMES, FORMAT_RAW_FRAMES
+    FORMAT_MP4, FORMAT_H264, FORMAT_MP2TS, FORMAT_FRAMES, FORMAT_RAW_FRAMES
 } gOutputFormat = FORMAT_MP4;           // data format for output
 static bool gSizeSpecified = false;     // was size explicitly requested?
 static bool gWantInfoScreen = false;    // do we want initial info screen?
@@ -643,6 +643,9 @@ static status_t recordScreen(const char* fileName) {
             }
             break;
         }
+        case FORMAT_MP2TS:
+            muxer = new MediaMuxer(fileName, MediaMuxer::OUTPUT_FORMAT_MPEG2TS);
+            break;
         case FORMAT_H264:
         case FORMAT_FRAMES:
         case FORMAT_RAW_FRAMES: {
@@ -951,6 +954,8 @@ int main(int argc, char* const argv[]) {
                 gOutputFormat = FORMAT_MP4;
             } else if (strcmp(optarg, "h264") == 0) {
                 gOutputFormat = FORMAT_H264;
+            } else if (strcmp(optarg, "mp2ts") == 0) {
+                gOutputFormat = FORMAT_MP2TS;
             } else if (strcmp(optarg, "frames") == 0) {
                 gOutputFormat = FORMAT_FRAMES;
             } else if (strcmp(optarg, "raw-frames") == 0) {
diff --git a/include/media/stagefright/MediaMuxer.h b/include/media/stagefright/MediaMuxer.h
index bbe4303..ffc4e7c 100644
--- a/include/media/stagefright/MediaMuxer.h
+++ b/include/media/stagefright/MediaMuxer.h
@@ -45,6 +45,7 @@ public:
     enum OutputFormat {
         OUTPUT_FORMAT_MPEG_4 = 0,
         OUTPUT_FORMAT_WEBM   = 1,
+        OUTPUT_FORMAT_MPEG2TS = 2,
         OUTPUT_FORMAT_LIST_END // must be last - used to validate format type
     };
 
diff --git a/media/libstagefright/MediaMuxer.cpp b/media/libstagefright/MediaMuxer.cpp
index c7c6f34..26a95cb 100644
--- a/media/libstagefright/MediaMuxer.cpp
+++ b/media/libstagefright/MediaMuxer.cpp
@@ -34,6 +34,7 @@
 #include <media/stagefright/MediaSource.h>
 #include <media/stagefright/MetaData.h>
 #include <media/stagefright/MPEG4Writer.h>
+#include <media/stagefright/MPEG2TSWriter.h>
 #include <media/stagefright/Utils.h>
 
 namespace android {
@@ -45,6 +46,8 @@ MediaMuxer::MediaMuxer(const char *path, OutputFormat format)
         mWriter = new MPEG4Writer(path);
     } else if (format == OUTPUT_FORMAT_WEBM) {
         mWriter = new WebmWriter(path);
+    } else if (format == OUTPUT_FORMAT_MPEG2TS) {
+        mWriter = new MPEG2TSWriter(path);
     }
 
     if (mWriter != NULL) {
-- 
