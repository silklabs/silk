From 9c951725ac5f79d078becd3658a1b2e48b95d90a Mon Sep 17 00:00:00 2001
From: Chris Jones <chris@silklabs.com>
Date: Tue, 16 Jun 2015 21:26:20 -0700
Subject: [PATCH 1/3] screenrecord: add ability output to stdout

---
 cmds/screenrecord/screenrecord.cpp  | 25 ++++++++++++++++++++++---
 media/libstagefright/MediaMuxer.cpp |  2 ++
 2 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/cmds/screenrecord/screenrecord.cpp b/cmds/screenrecord/screenrecord.cpp
index 7a0b873..31dcb08 100644
--- a/cmds/screenrecord/screenrecord.cpp
+++ b/cmds/screenrecord/screenrecord.cpp
@@ -631,20 +631,37 @@ static status_t recordScreen(const char* fileName) {
         return err;
     }
 
+    int fd = -1;
+    if (strcmp(fileName, "-") == 0) {
+      if (gVerbose) {
+        fprintf(stderr, "ERROR: verbose output and '-' not compatible");
+        abort();
+      }
+      fd = 1;
+    }
+
     sp<MediaMuxer> muxer = NULL;
     FILE* rawFp = NULL;
     switch (gOutputFormat) {
         case FORMAT_MP4: {
             // Configure muxer.  We have to wait for the CSD blob from the encoder
             // before we can start it.
-            muxer = new MediaMuxer(fileName, MediaMuxer::OUTPUT_FORMAT_MPEG_4);
+            if (fd >= 0) {
+              muxer = new MediaMuxer(fd, MediaMuxer::OUTPUT_FORMAT_MPEG_4);
+            } else {
+              muxer = new MediaMuxer(fileName, MediaMuxer::OUTPUT_FORMAT_MPEG_4);
+            }
             if (gRotate) {
                 muxer->setOrientationHint(90);  // TODO: does this do anything?
             }
             break;
         }
         case FORMAT_MP2TS:
-            muxer = new MediaMuxer(fileName, MediaMuxer::OUTPUT_FORMAT_MPEG2TS);
+            if (fd >= 0) {
+              muxer = new MediaMuxer(fd, MediaMuxer::OUTPUT_FORMAT_MPEG2TS);
+            } else {
+              muxer = new MediaMuxer(fileName, MediaMuxer::OUTPUT_FORMAT_MPEG2TS);
+            }
             break;
         case FORMAT_H264:
         case FORMAT_FRAMES:
@@ -979,7 +996,8 @@ int main(int argc, char* const argv[]) {
     }
 
     const char* fileName = argv[optind];
-    if (gOutputFormat == FORMAT_MP4) {
+    if (gOutputFormat == FORMAT_MP4 || gOutputFormat == FORMAT_MP2TS) {
+      if (0 != strcmp(fileName, "-")) {
         // MediaMuxer tries to create the file in the constructor, but we don't
         // learn about the failure until muxer.start(), which returns a generic
         // error code without logging anything.  We attempt to create the file
@@ -990,6 +1008,7 @@ int main(int argc, char* const argv[]) {
             return 1;
         }
         close(fd);
+      }
     }
 
     status_t err = recordScreen(fileName);
diff --git a/media/libstagefright/MediaMuxer.cpp b/media/libstagefright/MediaMuxer.cpp
index 26a95cb..42100eb 100644
--- a/media/libstagefright/MediaMuxer.cpp
+++ b/media/libstagefright/MediaMuxer.cpp
@@ -63,6 +63,8 @@ MediaMuxer::MediaMuxer(int fd, OutputFormat format)
         mWriter = new MPEG4Writer(fd);
     } else if (format == OUTPUT_FORMAT_WEBM) {
         mWriter = new WebmWriter(fd);
+    } else if (format == OUTPUT_FORMAT_MPEG2TS) {
+        mWriter = new MPEG2TSWriter(fd);
     }
 
     if (mWriter != NULL) {
-- 
