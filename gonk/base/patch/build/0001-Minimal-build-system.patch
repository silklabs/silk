diff --git a/core/empty.mk b/core/empty.mk
new file mode 100644
index 0000000..e69de29
diff --git a/core/main.mk b/core/main.mk
index 9d6e233..e8af6e8 100644
--- a/core/main.mk
+++ b/core/main.mk
@@ -9,6 +9,9 @@ else
 SHELL := /bin/bash
 endif
 
+# Prevent a host dependency on clang
+export WITHOUT_LIBCOMPILER_RT=1
+
 # this turns off the suffix rules built into make
 .SUFFIXES:
 
@@ -61,14 +64,21 @@ TOPDIR :=
 BUILD_SYSTEM := $(TOPDIR)build/core
 
 # This is the default target.  It must be the first declared target.
-.PHONY: droid
-DEFAULT_GOAL := droid
+.PHONY: gonk_modules
+DEFAULT_GOAL := gonk_modules
 $(DEFAULT_GOAL):
 
 # Used to force goals to build.  Only use for conditionally defined goals.
 .PHONY: FORCE
 FORCE:
 
+# Inhibit the installation of base system libraries that are already present on
+# the target device
+DISABLED_USER_MODULES := libc libstdc++ libm libdl tzdata  # bionic/
+DISABLED_USER_MODULES += liblog libcutils                  # system/core/
+DISABLED_USER_MODULES += libstlport                        # external/stlport
+
+
 # These goals don't need to collect and include Android.mks/CleanSpec.mks
 # in the source tree.
 dont_bother_goals := clean clobber dataclean installclean \
@@ -117,7 +127,7 @@ $(warning ************************************************************)
 $(warning You are building on a case-insensitive filesystem.)
 $(warning Please move your source tree to a case-sensitive filesystem.)
 $(warning ************************************************************)
-$(error Case-insensitive filesystems not supported)
+$(warning Case-insensitive filesystems not supported)
 endif
 endif
 
@@ -164,7 +174,7 @@ $(info $(space))
 $(info Please follow the machine setup instructions at)
 $(info $(space)$(space)$(space)$(space)https://source.android.com/source/initializing.html)
 $(info ************************************************************)
-$(error stop)
+#$(error stop)
 endif
 
 # Check for the current JDK.
@@ -188,7 +198,7 @@ $(info ************************************************************)
 $(info You asked for an OpenJDK 7 build but your version is)
 $(info $(java_version_str).)
 $(info ************************************************************)
-$(error stop)
+#$(error stop)
 endif # java version is not OpenJdk
 else # if requires_openjdk
 ifneq ($(shell echo '$(java_version_str)' | grep -i openjdk),)
@@ -199,7 +209,7 @@ $(info You use OpenJDK but only Sun/Oracle JDK is supported.)
 $(info Please follow the machine setup instructions at)
 $(info $(space)$(space)$(space)$(space)https://source.android.com/source/download.html)
 $(info ************************************************************)
-$(error stop)
+#$(error stop)
 endif # java version is not Sun Oracle JDK
 endif # if requires_openjdk
 
@@ -215,7 +225,7 @@ $(info $(space))
 $(info Please follow the machine setup instructions at)
 $(info $(space)$(space)$(space)$(space)https://source.android.com/source/download.html)
 $(info ************************************************************)
-$(error stop)
+#$(error stop)
 endif
 
 
@@ -1071,3 +1081,67 @@ showcommands:
 .PHONY: nothing
 nothing:
 	@echo Successfully read the makefiles.
+
+
+ifdef GONK
+#
+# Device shared objects may be used for linking against by placing them
+# in prebuilts/device/$(TARGET_PRODUCT), alleviating the need to build them from
+# source.
+#
+DEVICE_PREBUILTS := $(notdir $(wildcard prebuilts/device/$(GONK)/$(TARGET_PRODUCT)/*.so))
+
+# Copy the shared object into the expected location
+$(addprefix $(TARGET_OUT_INTERMEDIATE_LIBRARIES)/,$(DEVICE_PREBUILTS)): $(TARGET_OUT_INTERMEDIATE_LIBRARIES)/%.so: prebuilts/device/$(GONK)/$(TARGET_PRODUCT)/%.so
+	@echo Gonk Prebuilt: $@
+	$(hide) mkdir -p $(@D)
+	$(hide) cp -a $< $@
+
+# Forge an export_includes file to keep the rest of the build happy
+$(foreach p,$(DEVICE_PREBUILTS:.so=), \
+  $(TARGET_OUT_INTERMEDIATES)/SHARED_LIBRARIES/$(p)_intermediates/export_includes) : $(TARGET_OUT_INTERMEDIATES)/SHARED_LIBRARIES/%_intermediates/export_includes:
+	@echo Gonk Phony export_includes: $@
+	$(hide) mkdir -p $(@D)
+	$(hide) touch $@
+
+endif
+
+#
+# All the base system modules
+#
+# This list was generated by uncommenting the following command with no
+# additional modules in the workspace:
+#
+#   $(error $(sort $(ALL_MODULES)))
+#
+ALL_MODULES_BASE := \
+  PowerTestHelper acp android-support-test antlr apicheck asm-4.0 atree \
+  bionic-benchmarks bionic-unit-tests bionic-unit-tests-static busybox \
+  check_prereq com.android.uiautomator.platform.common commons-cli-1.2 \
+  cpufeatures ddmlib-prebuilt espresso-core fortify1-tests-clang \
+  fortify1-tests-gcc fortify2-tests-clang fortify2-tests-gcc fs_config \
+  fs_get_stats gdbserver groovy-all-1.7.0 icu4j json-prebuilt jython kxml2-2.3.0 \
+  layoutlib_api-prebuilt libBionicStandardTests libBionicTests libbfd libc \
+  libc_aeabi libc_bionic libc_common libc_cxa libc_dns libc_freebsd libc_gdtoa \
+  libc_malloc libc_malloc_debug_leak libc_malloc_debug_qemu libc_netbsd \
+  libc_nomalloc libc_openbsd libc_stack_protector libc_syscalls libc_tzcode \
+  libdl libdlext_test libdlext_test_fd libdlext_test_fd_zipaligned \
+  libdlext_test_norelro libhost_32 libiberty libintl libm libstdc++ libstlport \
+  libstlport_static libtest_atexit libtest_check_order \
+  libtest_check_order_1_left libtest_check_order_2_right libtest_check_order_3_c \
+  libtest_check_order_a libtest_check_order_b libtest_check_order_d \
+  libtest_dlsym_weak_func libtest_relo_check_dt_needed_order \
+  libtest_relo_check_dt_needed_order_1 libtest_relo_check_dt_needed_order_2 \
+  libtest_simple libtest_with_dependency libtest_with_dependency_loop \
+  libtest_with_dependency_loop_a libtest_with_dependency_loop_b \
+  libtest_with_dependency_loop_b_tmp libtest_with_dependency_loop_c linker \
+  linker-unit-tests ninepatch-prebuilt no-elf-hash-table-library rgb2565 \
+  sdk-common tools-common-prebuilt tradefed-prebuilt tzdata ub-janktesthelper \
+  ub-uiautomator verity_key zipalign tst_str_parms liblog-benchmarks
+
+GONK_MODULES:=$(filter-out $(ALL_MODULES_BASE),$(ALL_MODULES))
+
+ifneq (,$(strip $(GONK_MODULES)))
+gonk_modules: $(GONK_MODULES)
+endif
+
