From 05dda79f6b1082885c867cee0f3aa2eaaac001a2 Mon Sep 17 00:00:00 2001
From: Michael Vines <mvines@silklabs.com>
Date: Tue, 11 Aug 2015 16:05:52 -0700
Subject: [PATCH] Android.mk integration

---
 Android.mk   | 6 ++++++
 package.json | 6 ++++--
 2 files changed, 10 insertions(+), 2 deletions(-)
 create mode 100644 Android.mk

diff --git a/Android.mk b/Android.mk
new file mode 100644
index 0000000..40174ba
--- /dev/null
+++ b/Android.mk
@@ -0,0 +1,6 @@
+LOCAL_PATH:= $(call my-dir)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE_TAGS := optional
+LOCAL_NODE_MODULE_TYPE := file
+include $(BUILD_NODE_MODULE)
diff --git a/package.json b/package.json
index ec885d9..29e594f 100644
--- a/package.json
+++ b/package.json
@@ -2,7 +2,7 @@
   "name": "bleno",
   "version": "0.1.13",
   "description": "A node.js module for implementing BLE (Bluetooth low energy) peripherals",
-  "main": "index.js",
+  "main": "dist/index.js",
   "engines": {
     "node": ">=0.8"
   },
@@ -12,6 +12,7 @@
     "linux"
   ],
   "scripts": {
+    "postinstall": "mkdir -p dist/ ; browserify index.js --node --ignore-missing --standalone __ignored --outfile dist/index.js",
     "pretest": "jshint *.js lib/. test/. examples/.",
     "test": "mocha -R spec test/*.js"
   },
@@ -29,13 +30,14 @@
   "author": "Sandeep Mistry",
   "license": "MIT",
   "readmeFilename": "README.md",
-  "devDependencies": {
+  "__devDependencies": {
     "jshint": "~2.3.0",
     "should": "~2.0.2",
     "mocha": "~1.14.0",
     "node-blink1": "~0.1.1"
   },
   "dependencies": {
+    "browserify": "^10.2.1",
     "debug": "2.2.0"
   }
 }
-- 
1.9.1

