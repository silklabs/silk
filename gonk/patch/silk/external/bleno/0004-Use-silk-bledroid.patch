From 033c576fa91d15db00d2afc67aaa5b6e0b629ce6 Mon Sep 17 00:00:00 2001
From: Ben Turner <bent@silklabs.com>
Date: Fri, 21 Aug 2015 09:28:59 -0400
Subject: [PATCH] Use silk-bledroid

---
 Android.mk              |   1 +
 lib/android/bindings.js | 206 ++----------------------------------------------
 2 files changed, 8 insertions(+), 199 deletions(-)

diff --git a/Android.mk b/Android.mk
index 40174ba..cb2d54e 100644
--- a/Android.mk
+++ b/Android.mk
@@ -3,4 +3,5 @@ LOCAL_PATH:= $(call my-dir)
 include $(CLEAR_VARS)
 LOCAL_MODULE_TAGS := optional
 LOCAL_NODE_MODULE_TYPE := file
+LOCAL_MODULE_PATH := $(TARGET_OUT)/silk/node_modules
 include $(BUILD_NODE_MODULE)
diff --git a/lib/android/bindings.js b/lib/android/bindings.js
index 773268f..6a53c6d 100644
--- a/lib/android/bindings.js
+++ b/lib/android/bindings.js
@@ -1,182 +1,11 @@
 /* -*- Mode: js2; tab-width: 2; indent-tabs-mode: nil; js2-basic-offset: 2 -*- */
 /* vim: set shiftwidth=2 tabstop=2 autoindent cindent expandtab: */
 
-var debug = require('debug')('bleno:bindings');
-
+var debug = require('debug')('silk-bleno');
 var events = require('events');
 var util = require('util');
-var net = require('net');
-
-const BLE_SOCKET_NAME = '/dev/socket/bledroid';
-const BLE_COMMAND_NAME = 'BleCommand';
-
-
-var Bledroid = function() {
-  this._ready = false;
-  this._init();
-};
-
-util.inherits(Bledroid, events.EventEmitter);
-
-Bledroid.prototype._init = function(hadError) {
-  debug('connecting to ' + BLE_SOCKET_NAME + ' socket');
-  var self = this;
-  this._socket = net.createConnection(BLE_SOCKET_NAME, function () {
-    debug('connected to ' + BLE_SOCKET_NAME + ' socket');
-    self._ready = true;
-    self._buffer = '';
-    self.command('clientReady');
-  });
-  this._socket.on('data', this.onData.bind(this));
-  this._socket.on('error', function(err) {
-    self._restart('bledroid error, reason=' + err);
-  });
-  this._socket.on('close', function(hadError) {
-    if (!hadError) {
-      self._restart('bledroid close');
-    }
-  });
-};
-
-Bledroid.prototype._restart = function(why) {
-  if (this._socket) {
-    this._ready = false;
-    this._socket = null;
-
-    debug('bledroid restart: ' + why);
-    setTimeout(this._init.bind(this), 1000);
-    return;
-  }
-  debug('bledroid restart pending (ignored ' + why + ')');
-};
-
-Bledroid.prototype.onData = function(data) {
-  debug('received data: ' + data.toString());
-  this._buffer += data.toString();
-
-  var nullByte;
-  while ((nullByte = this._buffer.indexOf('\0')) !== -1) {
-    var line = this._buffer.substring(0, nullByte);
-    this._buffer = this._buffer.substring(nullByte + 1);
-
-    var found;
-
-    if ((found = line.match(/^([\d]*) (.*)/))) {
-      var code = found[1];
-      line = found[2];
-    }
-
-    if ((found = line.match(/^!adapterState (.*)/))) {
-      var adapterState = found[1];
-
-      debug('adapterState = ' + adapterState);
-      this.emit('stateChange', adapterState);
-    } else if ((found = line.match(/^!address (.*)/))) {
-      var adapterAddress = found[1].toLowerCase();
-
-      debug('adapterAddress = ' + adapterAddress);
-      this.emit('addressChange', adapterAddress);
-    } else if ((found = line.match(/^!listen (0|1) (.*)/))) {
-      var state = found[1];
-      var error = parseInt(found[2]);
 
-      debug('listen = ' + state + ' (error = ' + error + ')');
-      if (state == '1') {
-        debug('advertisingStart');
-        this.emit('advertisingStart', error);
-      } else {
-        debug('advertisingStop');
-        this.emit('advertisingStop');
-      }
-    } else if ((found = line.match(/^!rssiUpdate (-\d+)/))) {
-      var rssi = parseInt(found[1]);
-
-      debug('rssiUpdate = ' + rssi);
-      this.emit('rssiUpdate', rssi);
-    } else if ((found = line.match(/^!accept (.*)/))) {
-      var clientAddress = found[1].toLowerCase();
-
-      debug('accept = ' + clientAddress);
-      this.emit('accept', clientAddress);
-    } else if ((found = line.match(/^!disconnect (.*)/))) {
-      var clientAddress = found[1].toLowerCase();
-
-      debug('disconnect = ' + clientAddress);
-      this.emit('disconnect', clientAddress);
-    } else if ((found = line.match(/^!mtuChange (.*)/))) {
-      var mtu = parseInt(found[1]);
-
-      debug('mtu = ' + mtu);
-      this.emit('mtuChange', mtu);
-    } else if ((found = line.match(/^!primaryServiceHandle (.*)/))) {
-      var handle = parseInt(found[1]);
-      debug('primaryServiceHandle = ' + handle);
-      this.emit('primaryServiceHandle', handle);
-    } else if ((found = line.match(/^!attributeHandle (-?.*)/))) {
-      var handle = parseInt(found[1]);
-      if (handle <= 0) {
-        handle = false;
-      }
-      debug('attributeHandle = ' + handle);
-      this.emit('attributeHandle', handle);
-    } else if ((found = line.match(/^!servicesSet (.*)/))) {
-      var error = parseInt(found[1]);
-
-      debug('servicesSet = ' + error);
-      this.emit('servicesSet', error);
-    } else if ((found = line.match(/^!servicesDelete (.*)/))) {
-      var error = parseInt(found[1]);
-
-      debug('servicesDelete = ' + error);
-      this.emit('servicesDelete', error);
-    } else if ((found = line.match(/^!readAttribute (\d+) (\d+) (\d+) (\d+) (\d+)/))) {
-      var handle = parseInt(found[1]);
-      var connId = parseInt(found[2]);
-      var transId = parseInt(found[3]);
-      var offset = parseInt(found[4]);
-      var isLong = parseInt(found[5]); // TODO: What is this????
-
-      debug('readAttribute = ' + handle + ' ' + connId + ' ' + transId + ' ' + offset);
-      this.emit('readAttribute', handle, connId, transId, offset);
-    } else if ((found = line.match(/^!writeAttribute (\d+) (\d+) (\d+) (\d+) (\d+) ([0-9a-fA-F]*)/))) {
-      var handle = parseInt(found[1]);
-      var connId = parseInt(found[2]);
-      var transId = parseInt(found[3]);
-      var needResponse = parseInt(found[4]) === 1;
-      var offset = parseInt(found[5]);
-      var hexdata = found[6];
-
-      var data = [];
-      while (hexdata.length >= 2) {
-        data.push(parseInt(hexdata.substring(0, 2), 16));
-        hexdata = hexdata.substring(2);
-      }
-      data = new Buffer(data);
-
-      debug('writeAttribute = ' + handle + ' ' + connId + ' ' + transId +
-        ' ' + needResponse + ' ' + offset + ' ' + data);
-      this.emit('writeAttribute', handle, connId, transId, needResponse, offset, data);
-    } else if ((found = line.match(/^unknownCommand (.*)/))) {
-      var cmd = found[1];
-      console.log('Error: Unknown bledroid command ' + cmd);
-    }
-  }
-};
-
-Bledroid.prototype.command = function(cmd) {
-  if (!this._ready) {
-    debug('bledroid not ready, ignoring the command');
-    return;
-  }
-
-  // bledroid socket expects the command data in the following format
-  var event = BLE_COMMAND_NAME + ' ' + '\"' + cmd + '\"' + '\0';
-
-  this._socket.write(event);
-  debug('bledroid << ' + event);
-};
-
-// -----------------------------------------------------------------------------
+var makeBledroidConnection = require('silk-bledroid');
 
 var BlenoBindings = function() {};
 util.inherits(BlenoBindings, events.EventEmitter);
@@ -184,14 +13,14 @@ util.inherits(BlenoBindings, events.EventEmitter);
 var blenoBindings = new BlenoBindings();
 
 blenoBindings.init = function() {
-  this._bledroid = new Bledroid();
+  this._bledroid = makeBledroidConnection();
   this._bledroid.on('stateChange', this.onStateChange.bind(this));
   this._bledroid.on('addressChange', this.onAddressChange.bind(this));
   this._bledroid.on('advertisingStart', this.onAdvertisingStart.bind(this));
   this._bledroid.on('advertisingStop', this.onAdvertisingStop.bind(this));
   this._bledroid.on('rssiUpdate', this.onRssiUpdate.bind(this));
-  this._bledroid.on('accept', this.onAccept.bind(this));
-  this._bledroid.on('disconnect', this.onDisconnect.bind(this));
+  this._bledroid.on('serverConnect', this.onAccept.bind(this));
+  this._bledroid.on('serverDisconnect', this.onDisconnect.bind(this));
   this._bledroid.on('mtuChange', this.onMtuChange.bind(this));
   this._bledroid.on('primaryServiceHandle', this.onPrimaryServiceHandle.bind(this));
   this._bledroid.on('attributeHandle', this.onAttributeHandle.bind(this));
@@ -301,7 +130,7 @@ blenoBindings.onDisconnect = function(clientAddress) {
   this.emit('disconnect', clientAddress);
 };
 
-blenoBindings.onRssiUpdate = function(rssi) {
+blenoBindings.onRssiUpdate = function(address, rssi, status) {
   this.emit('rssiUpdate', rssi);
 };
 
@@ -309,27 +138,6 @@ blenoBindings.onMtuChange = function(mtu) {
   this.emit('mtuChange', mtu);
 };
 
-
-// TODO: Why does *ONLY* characteristic UUID need to be reversed?  This feels like a
-// bug somewhere else in the system...
-var uuid_rev = function(u)
-{
-  switch (u.length) {
-  case 4:
-    return u;
-  case 32:
-    r = '';
-    for (var i = 0; i < u.length; i += 2) {
-      r = u.substring(i,i+2) + r;
-    }
-    return r;
-  default:
-    console.log('Error: Unsupported uuid length: ' + u);
-    return u;
-  }
-}
-
-
 blenoBindings._addNextServiceAttribute = function() {
   this._currentAttribute = null;
 
@@ -395,7 +203,7 @@ blenoBindings._addNextServiceAttribute = function() {
     }
     this._currentAttribute = characteristic;
     this._bledroid.command('addCharacteristic ' + this._serviceHandle + ' ' +
-      uuid_rev(characteristic.uuid) + ' ' + properties + ' ' + permissions);
+      characteristic.uuid + ' ' + properties + ' ' + permissions);
     break;
 
   case 'descriptor':
-- 
2.5.0

