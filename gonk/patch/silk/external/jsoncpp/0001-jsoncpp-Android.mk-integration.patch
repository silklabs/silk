From 913fad799510a88fbb692655fb5648dbe2b5bf0a Mon Sep 17 00:00:00 2001
From: Anshul Jain <anshul@silklabs.com>
Date: Wed, 22 Jul 2015 22:43:49 -0700
Subject: [PATCH 1/2] jsoncpp Android.mk integration

---
 Android.mk | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)
 create mode 100644 Android.mk

diff --git a/Android.mk b/Android.mk
new file mode 100644
index 0000000..af3ddb7
--- /dev/null
+++ b/Android.mk
@@ -0,0 +1,17 @@
+LOCAL_PATH := $(call my-dir)
+
+include $(CLEAR_VARS)
+
+FILE_LIST := $(wildcard $(LOCAL_PATH)/src/lib_json/*.cpp)
+
+LOCAL_MODULE := libjsoncpp
+LOCAL_SRC_FILES := $(FILE_LIST:$(LOCAL_PATH)/%=%)
+LOCAL_C_INCLUDES += $(LOCAL_PATH)/include
+LOCAL_MODULE_TAGS := optional
+
+LOCAL_CFLAGS += -Wall -Wextra -Werror
+LOCAL_CFLAGS += -Wno-unused-parameter
+
+include external/stlport/libstlport.mk
+
+include $(BUILD_SHARED_LIBRARY)
-- 
