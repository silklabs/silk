From ab8446e6b39bf5686a8ffc77e21db8ba34d775c0 Mon Sep 17 00:00:00 2001
From: Michael Vines <mvines@silklabs.com>
Date: Mon, 10 Aug 2015 15:06:39 -0700
Subject: [PATCH] Androidify

---
 Android.mk                 |  7 +++++++
 binding.gyp                | 14 +-------------
 examples/car-detection.js  | 12 +++++-------
 examples/face-detection.js | 10 +++++-----
 lib/opencv.js              |  2 +-
 package.json               | 26 +++++++++-----------------
 6 files changed, 28 insertions(+), 43 deletions(-)
 create mode 100644 Android.mk

diff --git a/Android.mk b/Android.mk
new file mode 100644
index 0000000..76f0224
--- /dev/null
+++ b/Android.mk
@@ -0,0 +1,7 @@
+LOCAL_PATH:= $(call my-dir)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE_TAGS := optional
+LOCAL_NODE_MODULE_TYPE := file
+include external/opencv2/opencv.mk
+include $(BUILD_NODE_MODULE)
diff --git a/binding.gyp b/binding.gyp
index 97ccd40..4b8d9a9 100755
--- a/binding.gyp
+++ b/binding.gyp
@@ -23,12 +23,11 @@
       ],
 
       "libraries": [
-        "<!@(pkg-config --libs opencv)"
+        '<!(echo $Android_mk__LIBRARIES)'
       ],
       # For windows
 
       "include_dirs": [
-        "<!@(pkg-config --cflags opencv)",
         "<!(node -e \"require('nan')\")"
       ],
 
@@ -68,16 +67,5 @@
           }
         }]
     ]
-  },
-    {
-      "target_name": "action_after_build",
-      "type": "none",
-      "dependencies": [ "<(module_name)" ],
-      "copies": [
-      {
-        "files": [ "<(PRODUCT_DIR)/<(module_name).node" ],
-        "destination": "<(module_path)"
-      }
-      ]
     }]
 }
diff --git a/examples/car-detection.js b/examples/car-detection.js
index df296d6..883b795 100644
--- a/examples/car-detection.js
+++ b/examples/car-detection.js
@@ -1,13 +1,12 @@
-/* For some reason the cascade file is broken on linux :(
 
 
-var cv = require('../lib/opencv');
+var cv = require('opencv');
 
-cv.readImage("./files/car1.jpg", function(err, im){
+cv.readImage("/data/car1.jpg", function(err, im){
   if (err) throw err;
   if (im.width() < 1 || im.height() < 1) throw new Error('Image has no size');
 
-  im.detectObject("../data/hogcascade_cars_sideview.xml", {}, function(err, cars){
+  im.detectObject("/data/hogcascade_cars_sideview.xml", {}, function(err, cars){
     if (err) throw err;
 
     for (var i=0; i < cars.length; i++){
@@ -15,8 +14,7 @@ cv.readImage("./files/car1.jpg", function(err, im){
       im.rectangle([x.x, x.y], [x.width, x.height]);
     }
 
-    im.save('./tmp/car-detection.jpg');
-    console.log('Image saved to ./tmp/car-detection.jpg');
+    im.save('/cache/car-detection.jpg');
+    console.log('Image saved to /cache/car-detection.jpg');
   });
 });
-*/
diff --git a/examples/face-detection.js b/examples/face-detection.js
index 0cc5fee..2d73b48 100755
--- a/examples/face-detection.js
+++ b/examples/face-detection.js
@@ -1,10 +1,10 @@
-var cv = require('../lib/opencv');
+var cv = require('opencv');
 
-cv.readImage("./files/mona.png", function(err, im){
+cv.readImage("/data/face.jpg", function(err, im){
   if (err) throw err;
   if (im.width() < 1 || im.height() < 1) throw new Error('Image has no size');
 
-  im.detectObject("../data/haarcascade_frontalface_alt.xml", {}, function(err, faces){
+  im.detectObject("/data/haarcascade_frontalface_alt.xml", {}, function(err, faces){
     if (err) throw err;
 
     for (var i = 0; i < faces.length; i++){
@@ -12,7 +12,7 @@ cv.readImage("./files/mona.png", function(err, im){
       im.ellipse(face.x + face.width / 2, face.y + face.height / 2, face.width / 2, face.height / 2);
     }
 
-    im.save('./tmp/face-detection.png');
-    console.log('Image saved to ./tmp/face-detection.png');
+    im.save('/cache/face-detection.png');
+    console.log('Image saved to /cache/face-detection.png');
   });
 });
diff --git a/lib/opencv.js b/lib/opencv.js
index dc043a0..f746093 100755
--- a/lib/opencv.js
+++ b/lib/opencv.js
@@ -3,7 +3,7 @@ var Stream = require('stream').Stream
   , util = require('util')
   , path = require('path');
 
-var cv = module.exports = require('./bindings');
+var cv = module.exports = require('build/opencv.node');
 
 var Matrix = cv.Matrix
   , VideoCapture = cv.VideoCapture
diff --git a/package.json b/package.json
index f74011b..21b7cdd 100644
--- a/package.json
+++ b/package.json
@@ -2,26 +2,24 @@
   "name": "opencv",
   "description": "Node Bindings to OpenCV",
   "author": "Peter Braden <peterbraden@peterbraden.co.uk>",
+  "os": [
+    "android"
+  ],
   "dependencies": {
+    "browserify": "^10.2.1",
     "buffers": "0.1.1",
-    "nan": "^1.7.0",
-    "node-pre-gyp": "^0.6.4"
+    "nan": "^1.7.0"
   },
   "version": "3.0.1",
-  "devDependencies": {
+  "__devDependencies": {
     "tape": "^3.0.0",
     "aws-sdk": "~2.1.20",
     "glob": "^5.0.3",
     "request": "^2.44.0"
   },
-  "bundledDependencies": [
-    "node-pre-gyp"
-  ],
   "license": "MIT",
   "scripts": {
-    "build": "node-gyp build",
-    "test": "node test/unit.js",
-    "install": "node-pre-gyp install --fallback-to-build"
+    "postinstall": "mkdir -p dist/ ; browserify lib/opencv.js --node --ignore-missing --standalone __ignored --outfile dist/index.js"
   },
   "keywords": [
     "opencv",
@@ -29,7 +27,7 @@
     "vision",
     "quadrocopter"
   ],
-  "main": "./lib/opencv",
+  "main": "dist/index.js",
   "repository": {
     "type": "git",
     "url": "https://github.com/peterbraden/node-opencv.git"
@@ -37,11 +35,5 @@
   "engines": {
     "node": ">=0.10"
   },
-  "binary": {
-    "module_name": "opencv",
-    "module_path": "./build/{module_name}/v{version}/{configuration}/{node_abi}-{platform}-{arch}/",
-    "remote_path": "./{module_name}/v{version}/{configuration}/",
-    "package_name": "{node_abi}-{platform}-{arch}.tar.gz",
-    "host": "https://node-opencv.s3.amazonaws.com"
-  }
+  "gypfile": true
 }
