From acbb340f92e9a5a47b754e7563895ee626d8e23b Mon Sep 17 00:00:00 2001
From: Chris Jones <chris@silklabs.com>
Date: Sat, 16 May 2015 22:38:54 -0700
Subject: [PATCH] Android.mk

---
 Android.mk | 53 +++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 53 insertions(+)
 create mode 100644 Android.mk

diff --git a/Android.mk b/Android.mk
new file mode 100644
index 0000000..b7c8259
--- /dev/null
+++ b/Android.mk
@@ -0,0 +1,53 @@
+LOCAL_PATH := $(call my-dir)
+
+LOCAL_NODE_ENGINE=$(notdir $(LOCAL_PATH))
+
+ifneq ($(NODE_ENGINE),$(LOCAL_NODE_ENGINE))
+$(info Not building '$(LOCAL_NODE_ENGINE)' as NODE_ENGINE=$(NODE_ENGINE))
+else
+include $(CLEAR_VARS)
+LOCAL_MODULE := $(LOCAL_NODE_ENGINE)
+LOCAL_MODULE_CLASS := EXECUTABLES
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_PATH := $(TARGET_OUT)/bin
+LOCAL_STRIP_MODULE := true
+node_BUILD_DIR := $(ANDROID_BUILD_TOP)/$(PRODUCT_OUT)/obj/$(LOCAL_MODULE_CLASS)/$(LOCAL_MODULE)_intermediates
+LOCAL_PREBUILT_MODULE_FILE := $(node_BUILD_DIR)/Release/$(LOCAL_MODULE)
+include external/stlport/libstlport.mk
+include $(BUILD_PREBUILT)
+
+LOCAL_CFLAGS := \
+  $(addprefix -isystem ,$(abspath . $(LOCAL_C_INCLUDES) $(TARGET_C_INCLUDES))) \
+  $(TARGET_GLOBAL_CFLAGS)
+
+LOCAL_CPPFLAGS := -DV8_ANDROID_LOG_STDOUT $(TARGET_GLOBAL_CPPFLAGS)
+
+LOCAL_LDFLAGS := $(TARGET_GLOBAL_LDFLAGS) -pie \
+  -B$(abspath $(TARGET_OUT_INTERMEDIATE_LIBRARIES)) \
+  -L$(abspath $(TARGET_OUT_INTERMEDIATE_LIBRARIES))  \
+  $(subst lib,-l,$(LOCAL_SHARED_LIBRARIES))
+
+$(LOCAL_PREBUILT_MODULE_FILE): export CC := $(abspath $(TARGET_CC))
+$(LOCAL_PREBUILT_MODULE_FILE): export CXX := $(abspath $(TARGET_CXX))
+$(LOCAL_PREBUILT_MODULE_FILE): export CXX := $(abspath $(TARGET_CXX))
+$(LOCAL_PREBUILT_MODULE_FILE): export AR := $(abspath $(TARGET_AR))
+$(LOCAL_PREBUILT_MODULE_FILE): export RANLIB := $(abspath $(TARGET_RANLIB))
+$(LOCAL_PREBUILT_MODULE_FILE): export LINK := $(abspath $(TARGET_CXX))
+$(LOCAL_PREBUILT_MODULE_FILE): export CFLAGS := $(LOCAL_CFLAGS)
+$(LOCAL_PREBUILT_MODULE_FILE): export CXXFLAGS := $(LOCAL_CFLAGS) $(LOCAL_CPPFLAGS)
+$(LOCAL_PREBUILT_MODULE_FILE): export LDFLAGS := $(LOCAL_LDFLAGS)
+$(LOCAL_PREBUILT_MODULE_FILE): node_BUILD_DIR := $(node_BUILD_DIR)
+
+$(LOCAL_PREBUILT_MODULE_FILE): $(LOCAL_PATH)/configure $(LOCAL_PATH)/Android.mk \
+  $(TARGET_CRTBEGIN_DYNAMIC_O) $(TARGET_CRTEND_O) \
+  $(addprefix $(TARGET_OUT_INTERMEDIATE_LIBRARIES)/, \
+      libc.so libdl.so liblog.so $(addsuffix .so,$(LOCAL_SHARED_LIBRARIES)))
+	@echo Building: $@
+	$(hide) rm -rf $(@D) $(<D)/{config.gypi,config.mk,icu_config.gypi,node,out}
+	$(hide) mkdir -p $(node_BUILD_DIR)
+	$(hide) ln -s $(node_BUILD_DIR) $(<D)/out
+	$(hide) cd $(<D) && ./configure --prefix=/ \
+    --without-snapshot --without-npm --dest-cpu=arm --dest-os=android
+	$(hide) cd $(<D) && $(MAKE) V=$(if $(SHOW_COMMANDS),1)
+
+endif
-- 
