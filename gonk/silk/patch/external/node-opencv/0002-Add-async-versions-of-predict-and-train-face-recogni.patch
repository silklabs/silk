@@ -212,13 +259,15 @@ NAN_METHOD(FaceRecognizerWrap::UpdateSync) {
 NAN_METHOD(FaceRecognizerWrap::PredictSync) {
   SETUP_FUNCTION(FaceRecognizerWrap)
 
+  if (info.Length() < 1) {
