From: Michael Vines <mvines@silklabs.com>
Date: Fri, 7 Aug 2015 12:00:23 -0700
Subject: [PATCH] Android.mk

---
 Android.mk                   | 97 ++++++++++++++++++++++++++++++++++++++++++++
 apps/Android.mk              |  1 +
 apps/haartraining/Android.mk | 16 ++++++++
 apps/traincascade/Android.mk | 19 +++++++++
 opencv.mk                    | 38 +++++++++++++++++
 5 files changed, 171 insertions(+)
 create mode 100644 Android.mk
 create mode 100644 apps/Android.mk
 create mode 100644 apps/haartraining/Android.mk
 create mode 100644 apps/traincascade/Android.mk
 create mode 100644 opencv.mk

diff --git a/Android.mk b/Android.mk
new file mode 100644
index 0000000..5dc84f4
--- /dev/null
+++ b/Android.mk
@@ -0,0 +1,97 @@
+LOCAL_PATH:= $(call my-dir)
+
+include $(CLEAR_VARS)
+
+LOCAL_MODULE := libopencv_core
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_CLASS := STATIC_LIBRARIES
+LOCAL_MODULE_SUFFIX := .a
+LOCAL_UNINSTALLABLE_MODULE := true
+LOCAL_CUSTOM_BUILT_MODULE := true
+LOCAL_32_BIT_ONLY := true
+
+include $(LOCAL_PATH)/opencv.mk
+LOCAL_EXPORT_C_INCLUDE_DIRS := \
+  $(LOCAL_PATH)/include \
+  $(LOCAL_PATH)/include/opencv \
+  $(foreach m,$(OPENCV_MODULE_NAMES),$(LOCAL_PATH)/modules/$(m)/include)
+
+include $(BUILD_PREBUILT)
+
+define __FAKE_OPENCV_NOTICE_RULES
+  .PHONY: NOTICE-TARGET-$(LOCAL_MODULE_CLASS)-$(1)
+  NOTICE-TARGET-$(LOCAL_MODULE_CLASS)-$(1):
+
+endef
+
+__FAKE_OPENCV_NOTICE_TARGETS := \
+$(foreach l, $(filter-out $(LOCAL_MODULE),$(OPENCV_MODULES)) $(OPENCV_3RDPARTY_COMPONENTS), \
+   $(eval $(call __FAKE_OPENCV_NOTICE_RULES,$(l))) \
+ )
+__FAKE_OPENCV_EXPORT_INCLUDES = $(foreach l, $(filter-out $(LOCAL_MODULE),$(OPENCV_MODULES)) $(OPENCV_3RDPARTY_COMPONENTS), \
+  $(dir $(intermediates))$(l)_intermediates/export_includes)
+
+__FAKE_OPENCV_MODULES_A = $(foreach l, $(filter-out $(LOCAL_MODULE),$(OPENCV_MODULES)), \
+  $(dir $(intermediates))$(l)_intermediates/$(l).a)
+
+__FAKE_OPENCV_3RDPARTY_COMPONENTS_A = $(foreach l, $(OPENCV_3RDPARTY_COMPONENTS), \
+  $(dir $(intermediates))$(l)_intermediates/$(l).a)
+
+$(__FAKE_OPENCV_EXPORT_INCLUDES):
+	@echo Stub export_includes: $@
+	$(hide) mkdir -p $(@D)
+	$(hide) touch $@
+
+
+# If the 2nd arch exists assume it's 32bit and select it
+ifdef TARGET_2ND_ARCH
+#$(error DD $(TARGET_2ND_ARCH) - $(TARGET_$(TARGET_2ND_ARCH_VAR_PREFIX)CPU_ABI))
+LOCAL_2ND_ARCH_VAR_PREFIX := $(TARGET_2ND_ARCH_VAR_PREFIX)
+endif
+
+$(__FAKE_OPENCV_3RDPARTY_COMPONENTS_A): LOCAL_2ND_ARCH_VAR_PREFIX := $(LOCAL_2ND_ARCH_VAR_PREFIX)
+$(__FAKE_OPENCV_3RDPARTY_COMPONENTS_A):
+	@echo Symlink: $@
+	$(hide) mkdir -p $(@D)
+	$(hide) ln -sf ../libopencv_core_intermediates/install/sdk/native/3rdparty/libs/$(TARGET_$(LOCAL_2ND_ARCH_VAR_PREFIX)CPU_ABI)/$(subst libopencv_,lib,$(notdir $@)) $@
+
+$(__FAKE_OPENCV_MODULES_A): LOCAL_2ND_ARCH_VAR_PREFIX := $(LOCAL_2ND_ARCH_VAR_PREFIX)
+$(__FAKE_OPENCV_MODULES_A):
+	@echo Symlink: $@
+	$(hide) mkdir -p $(@D)
+	$(hide) ln -sf ../libopencv_core_intermediates/install/sdk/native/libs/$(TARGET_$(LOCAL_2ND_ARCH_VAR_PREFIX)CPU_ABI)/$(notdir $@) $@
+
+OPENCV_MAKEFILE := $(dir $(LOCAL_BUILT_MODULE))/Makefile
+$(OPENCV_MAKEFILE): LOCAL_PATH := $(abspath $(LOCAL_PATH))
+$(OPENCV_MAKEFILE): $(LOCAL_PATH)/Android.mk
+	@echo Configure: $@
+	$(hide) mkdir -p $(@D)
+	cd $(@D) && cmake \
+ -DCMAKE_TOOLCHAIN_FILE=$(LOCAL_PATH)/platforms/android/android.toolchain.cmake \
+ -DCMAKE_BUILD_TYPE=RelWithDebInfo \
+ -DBUILD_TESTS=false \
+ -DWITH_TIFF=false \
+ -DBUILD_ANDROID_EXAMPLES=false \
+ -DWITH_OPENEXR=false \
+ -DBUILD_PERF_TESTS=false \
+ -DBUILD_opencv_java=false \
+ -DANDROID_TOOLCHAIN_NAME=arm-linux-androideabi-4.8 \
+ -DANDROID_ABI="armeabi-v7a with NEON" \
+ -DANDROID_NATIVE_API_LEVEL=19 \
+ -DNDK_CCACHE=$(abspath $(CC_WRAPPER)) \
+ -DANDROID_NDK=$(abspath prebuilts/ndk/current) \
+ -DANDROID_NDK_LAYOUT=ANDROID \
+ -DWITH_TBB=true \
+ $(LOCAL_PATH)
+
+$(LOCAL_BUILT_MODULE): LOCAL_2ND_ARCH_VAR_PREFIX := $(LOCAL_2ND_ARCH_VAR_PREFIX)
+$(LOCAL_BUILT_MODULE): $(OPENCV_MAKEFILE) \
+  $(__FAKE_OPENCV_EXPORT_INCLUDES) \
+  $(__FAKE_OPENCV_MODULES_A) $(__FAKE_OPENCV_3RDPARTY_COMPONENTS_A)
+	@echo Build: $@
+	$(hide) time $(MAKE) -C $(@D) install
+	$(hide) cp $(dir $@)install/sdk/native/libs/$(TARGET_$(LOCAL_2ND_ARCH_VAR_PREFIX)CPU_ABI)/$(notdir $@) $@
+
+LOCAL_2ND_ARCH_VAR_PREFIX :=
+
+include $(call all-makefiles-under,$(LOCAL_PATH))
