diff --git a/opencv.mk b/opencv.mk
new file mode 100644
index 0000000..ba22e54
--- /dev/null
+++ b/opencv.mk
@@ -0,0 +1,38 @@
+# Include from your Android.mk to link with OpenCV, after defining LOCAL_MODULE
+OPENCV_MODULE_NAMES := \
+  androidcamera \
+  core \
+  calib3d \
+  contrib \
+  features2d \
+  flann \
+  highgui \
+  imgproc \
+  legacy \
+  ml \
+  objdetect \
+  ocl \
+  photo \
+  stitching \
+  superres \
+  ts \
+  video \
+  videostab \
+
+OPENCV_3RDPARTY_COMPONENTS := \
+ libopencv_libjasper \
+ libopencv_libjpeg \
+ libopencv_libpng \
+ libopencv_tbb \
+
+OPENCV_MODULES := $(addprefix libopencv_,$(OPENCV_MODULE_NAMES))
+
+ifneq ($(LOCAL_MODULE),libopencv_core)
+LOCAL_CFLAGS += -Wno-non-virtual-dtor # Bug in include/opencv2/core/core.hpp?
+LOCAL_CFLAGS += -frtti -fexceptions
+LOCAL_NDK_STL_VARIANT := gnustl_static
+LOCAL_SDK_VERSION := 19
+LOCAL_32_BIT_ONLY := true
+LOCAL_STATIC_LIBRARIES += $(OPENCV_MODULES) $(OPENCV_3RDPARTY_COMPONENTS)
+LOCAL_SHARED_LIBRARIES += liblog libz
+endif
-- 
