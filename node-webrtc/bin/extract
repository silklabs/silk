#! /bin/bash -ex

. bin/setup

# Run our custom gyp generator to figure out which files to export.
export_gonk() {
  local host_os=$(uname | tr '[:upper:]' '[:lower:]')
  local gcc_bin=$PWD/../device/prebuilts/gcc/$host_os-x86/arm/arm-linux-androideabi-4.9/bin
  # TODO: This is a crazy hack and should mirror what is inside the Android.mk in
  # node-webrtc. Ideally we could load this from a common location.
  local generator=$(realpath $PWD/../gyp)/dump_dependency_json.py
  ln -sf $PWD $WEBRTC/src/third_party/node-webrtc

  GYP_GENERATORS=$generator $WEBRTC/src/webrtc/build/gyp_webrtc \
    -DOS=android \
    -Dclang=1 \
    -D_toolset=true \
    -Drtc_use_h264=1 \
    -Duse_openh264=1 \
    -Dinclude_opus=1 \
    -Dbuild_libvpx=1 \
    -Denable_protobuf=0 \
    -Ddesktop_capture_supported=0 \
    -Dinclude_tests=0 \
    -Dchromium_code=0 \
    -Dbuild_with_chromium=0 \
    -Dandroid_toolchain=$gcc_bin \
    $WEBRTC/src/third_party/node-webrtc/binding.gyp \
    -R node-webrtc \
    --no-parallel

  # Remove the symlink to node-webrtc so we don't export it.
  rm $WEBRTC/src/third_party/node-webrtc
  ./bin/copy $PWD/files.json $WEBRTC/src $SILK_WEBRTC
  rm $PWD/files.json
}

export_host() {
  host_os=$1
  # TODO: This is a crazy hack and should mirror what is inside the Android.mk in
  # node-webrtc. Ideally we could load this from a common location.
  local generator=$(realpath $PWD/../gyp)/dump_dependency_json.py
  ln -sf $PWD $WEBRTC/src/third_party/node-webrtc

  # Download correct clang version ...
  $WEBRTC/src/chromium/src/tools/clang/scripts/update.py

  GYP_GENERATORS=$generator $WEBRTC/src/webrtc/build/gyp_webrtc \
    -DOS=$host_os \
    -Dclang=1 \
    -Denable_protobuf=0 \
    -Drtc_use_h264=1 \
    -Duse_openh264=1 \
    -Ddesktop_capture_supported=0 \
    -Dinclude_tests=0 \
    -Dchromium_code=0 \
    -Dbuild_with_chromium=0 \
    -Dbuild_libvpx=1 \
    -Dbuild_libyuv=1 \
    $WEBRTC/src/third_party/node-webrtc/binding.gyp \
    -R node-webrtc

  # Remove the symlink to node-webrtc so we don't export it.
  rm $WEBRTC/src/third_party/node-webrtc
  ./bin/copy $PWD/files.json $WEBRTC/src $SILK_WEBRTC
  rm $PWD/files.json
}

if [ ! -d $WEBRTC ];
then
  ./bin/update
fi

if [ -z $1 ];
then
  echo "You must pass a release version pick one of:"
  ./bin/list_releases
  exit 1
fi

webrtc_branch="branch-heads/$1"
silk_branch="release-$1"

echo "WebRTC Branch: $webrtc_branch"
echo "Silk Branch: $silk_branch"

if [ ! -d $SILK_WEBRTC ];
then
  git clone $SILK_WEBRTC_SRC $SILK_WEBRTC
fi

# Create a new branch with no history.
git -C $SILK_WEBRTC checkout --orphan $silk_branch
git -C $WEBRTC/src checkout $webrtc_branch
export_gonk
