#! /bin/bash -e

# Script to clone and update the local webrtc checkout :

. bin/setup
tree=$WEBRTC

ensure_bin() {
  local bin=$1
  local err=$2

  if ! which>/dev/null $1
  then
    echo "$1 cannot be found in path: $err"
    exit 1
  fi
}

ensure_bin fetch "See https://webrtc.org/native-code/development/prerequisite-sw/"
ensure_bin gclient "See https://webrtc.org/native-code/development/prerequisite-sw/"


# Ensure we fetch dependencies for android ...
export GYP_DEFINES="OS=android"

if [ ! -d $tree ];
then
  echo "Doing initial clone of webrtc this will take a VERY long time"
  mkdir -p $tree
  pushd $tree
  fetch --nohooks webrtc
  gclient sync --with_branch_heads
  echo "Completed initial clone"
  popd
  ./bin/list_releases
else
  pushd $tree
  gclient sync --with_branch_heads --nohooks
  popd
  ./bin/list_releases
fi
