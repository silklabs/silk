{
  'variables': {
    'configuration%': 'Release',
    # This is normally added by node-gyp but we need to manually specify it
    # since we are using chromium gyp...
    'node_root_dir%': '/usr/local',
    'node_webrtc_root_dir%': './',
    'module_name': 'node-webrtc',
    '_target_name': 'node-webrtc',
    'module_path': 'build/',
    'standalone_static_library': '1',
  },
  'targets': [
    {
      'target_name': 'node-webrtc',
      'product_extension': 'node',
      'product_prefix': '',
      'type': 'shared_library',
      # Node modules rely on various symbols being provided at runtime so we
      # need to explicitly disable the checks for undefined symbols.
      'aosp_build_settings': {
        'LOCAL_ALLOW_UNDEFINED_SYMBOLS': 'true',
        'LOCAL_MODULE_PATH': '$(TARGET_OUT_SILK_NODE_MODULES)',
         # LOCAL_INSTALLED_MODULE_STEM requires a slash to be part of the value.
        'LOCAL_INSTALLED_MODULE_STEM': './node-webrtc.node',
        'LOCAL_MODULE_SUFFIX': '.node'
      },
      'dependencies': [
        '<(DEPTH)/webrtc/api/api.gyp:libjingle_peerconnection',
        '<(DEPTH)/webrtc/p2p/p2p.gyp:rtc_p2p',
        '<(DEPTH)/webrtc/system_wrappers/system_wrappers.gyp:field_trial_default',
        '<(DEPTH)/webrtc/base/base.gyp:rtc_base',
        '<(DEPTH)/webrtc/base/base.gyp:rtc_base_approved',
        '<(DEPTH)/chromium/src/third_party/usrsctp/usrsctp.gyp:usrsctplib',
        '<(DEPTH)/third_party/boringssl/boringssl.gyp:boringssl',
        'node-webrtc-js',
      ],
      'variables': {
        'webrtc_root%': '<(DEPTH)/build-staging/',
        'libwebrtc_out%': '<(DEPTH)/out/$(BUILDTYPE)/obj',
      },
      'cflags!': [
        '-pthread',
        '-fno-exceptions',
        '-fno-strict-aliasing',
        '-Werror',
        '-Wno-unused-parameter',
        '-Wno-missing-field-initializers',
        '-Wextra',
        '-Wno-unused-local-typedefs',
        '-Wno-uninitialized',
        '-Wno-unused-variable',
        '-Wno-unused-but-set-variable',
        '-pipe',
        '-fno-ident',
        '-fdata-sections',
        '-ffunction-sections',
        '-fPIC',
        '-fpermissive',
      ],
      'xcode_settings': {
        'OTHER_LDFLAGS': [
           '-undefined dynamic_lookup'
        ],
        'OTHER_CFLAGS': [
          '-std=gnu++0x',
          '-Wno-c++0x-extensions',
          '-Wno-c++11-extensions',
          '-Wno-error'
        ]
      },
      'defines': [
        # We do not use node-gyp so we need to define this ourselves...
        'NODE_GYP_MODULE_NAME=node-webrtc',
        'BUILDING_NODE_EXTENSION',
#        'TRACING',
        'LARGEFILE_SOURCE',
        '_FILE_OFFSET_BITS=64',
        'WEBRTC_TARGET_PC',
        'WEBRTC_LINUX',
        'WEBRTC_THREAD_RR',
        'EXPAT_RELATIVE_PATH',
        'GTEST_RELATIVE_PATH',
        'JSONCPP_RELATIVE_PATH',
        'WEBRTC_RELATIVE_PATH',
        'POSIX',
        '__STDC_FORMAT_MACROS',
        'DYNAMIC_ANNOTATIONS_ENABLED=0',
        'WEBRTC_POSIX=1'
      ],
      'include_dirs': [
          "<(DEPTH)/../../",
          "<(node_webrtc_root_dir)/node_modules/nan",
          '<(node_root_dir)/include/node',
          '<(node_root_dir)/src',
          '<(node_root_dir)/deps/uv/include',
          '<(node_root_dir)/deps/v8/include'
       ],
      'link_settings': {
        'conditions': [
          ['OS=="mac"', {
            'libraries': [
              '-framework AppKit',
              '-framework QTKit',
            ]
          }],
          ['OS=="android"', {
            'ldflags': [
              '-Wl,--unresolved-symbols=ignore-all',
            ]
          }]
        ],
      },
      'sources': [
        'src/binding.cc',
        'src/create-offer-observer.cc',
        'src/create-answer-observer.cc',
        'src/set-local-description-observer.cc',
        'src/set-remote-description-observer.cc',
        'src/peerconnection.cc',
        'src/datachannel.cc',
        'src/rtcstatsreport.cc',
        'src/rtcstatsresponse.cc',
        'src/stats-observer.cc'
      ]
    },
    {
      'target_name': 'node-webrtc-js',
      'type': 'none',
      'variables': {
        'node_webrtc_dest%': 'node-webrtc.js'
      },
      'actions': [{
        'action_name': 'browserify',
        'inputs': [],
        'outputs': ['<(node_webrtc_dest)'],
        'action': [
          './node_modules/.bin/browserify',
          '.',
          '--node',
          '-d',
          '--standalone',
          '__ignored',
          '--ignore-missing',
          '--outfile',
          '<@(_outputs)'
        ]
      }]
    },
    {
      'target_name': 'action_after_build',
      'type': 'none',
      'dependencies': ['node-webrtc'],
      'copies': [{
        'files': ['<(PRODUCT_DIR)/<(module_name).node'],
        'destination': '<(module_path)'
      }]
    }
  ]
}
