#! /bin/bash -e
shopt -s nullglob

if [ -d modified ];
then
  echo "The modified directory already exists!"
  echo "If you want to create a clean state remove it and start over."
  exit 1
fi

# Download npm modules (shrinkwrap should be used in original)
cd original
npm install
cd -

patches=( patches/* )

# Apply the hacks!
cd original
for patch in "${patches[@]}"
do
  patch -N -p1 --input ../$patch --no-backup-if-mismatch -s || echo "We think $patch is applied already..."
done
cd -


# Copy original -> modified where we apply new changes:
cp -r original modified
