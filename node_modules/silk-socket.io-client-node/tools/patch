#! /bin/bash -vex

# Show the initial diff
./tools/diff || echo

## Helper to create patches!
patch=$1

if [ "$patch" == "" ];
then
  echo "Interactively creating a patch: "
  read -p "Patch name: (000-your-patch.patch): " patch


  if [ "$patch" == "" ];
  then
    echo "No patch name aborting..."
    exit 1
  fi
fi


./tools/diff > patches/$patch || echo ;

# Apply the patch to original:
cd original
patch -p1 --input ../patches/$patch
