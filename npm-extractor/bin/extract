#!/usr/bin/env ../pub/babel-run/babel-node

import path from 'path';
import { ArgumentParser } from 'argparse';

import extract from '../extract';

const CORE = path.join(__dirname, '../..');

const parser = new ArgumentParser({
  prog: './bin/extractor',
  description: `
    This program is a helper to extract a subset of our node_modules from a CORE
    checkout without hitting npm.
  `
});

parser.addArgument(
  ['modules'],
  {
    help: `Comma separated list of modules to extract`,
    type: (input) => {
      return input.split(',');
    },
  }
);

parser.addArgument(
  ['output'],
  {
    help: 'Directory in which to output the extracted modules',
    type: (input) => {
      return path.resolve(input);
    }
  }
);

async function main() {
  const args = parser.parseArgs();
  await extract(CORE, args.modules, args.output)
}

main().catch((err) => {
  setTimeout(() => {
    throw err;
  });
});
