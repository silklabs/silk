#! /bin/bash -e

if [[ "$V" == "1" ]]; then
  set -x
fi

if [[ "$DISABLE_NODE_MODULES_CACHE" == "1" ]]; then
  echo Found DISABLE_NODE_MODULES_CACHE=1 in environment. Ignoring cache.
  exit 0
fi

# Resolve to realpath....
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$( cd -P "$( dirname "$SOURCE" )" && pwd )"

$ROOT/tools/node_modules_cache/bin/bootstrap
$ROOT/tools/node_modules_cache/bin/cli \
  download \
  $PWD

exit 0
