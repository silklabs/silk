{
  "name": "silk-webapp",
  "version": "0.0.1",
  "description": "Silk web app",
  "scripts": {
    "preinstall": "./bin/preinstall",
    "postinstall": "webpack --progress",
    "start-server": "babel-node --harmony server/main.js production",
    "start": "webpack-dev-server --progress --hot --inline --watch-poll --watch-aggregate-timeout 300",
    "lint": "eslint src",
    "test": "npm run-script lint"
  },
  "license": "proprietary",
  "dependencies": {
    "ansi_up": "^1.3.0",
    "babel": "^5.8.9",
    "babel-core": "^5.8.23",
    "babel-eslint": "~3.1.15",
    "babel-loader": "^5.3.2",
    "babel-runtime": "^5.8.20",
    "babelify": "^6.1.3",
    "debug": "^2.2.0",
    "eslint": "^0.22.1",
    "eslint-plugin-react": "^3.3.1",
    "event-to-promise": "^0.4.0",
    "express": "^4.12.3",
    "json-loader": "^0.5.2",
    "localforage": "^1.2.10",
    "lodash.merge": "^3.3.2",
    "ms": "^0.7.1",
    "pbkdf2": "^3.0.4",
    "react": "^0.13.3",
    "react-bootstrap": "^0.25.1",
    "react-iframe": "^0.0.2",
    "react-router": "^1.0.0-rc1",
    "script-loader": "^0.6.1",
    "silk-api-react-native": "git@github.com:silklabs/silk-api-react-native.git#master",
    "socket.io-client": "^1.3.6",
    "text-encoding": "^0.5.2",
    "webpack": "^1.12.1",
    "whatwg-fetch": "^0.9.0"
  },
  "engines": {
    "node": ">=0.12.x"
  },
  "engineStrict": true,
  "eslintConfig": {
    "parser": "babel-eslint",
    "plugins": [
      "react"
    ],
    "globals": {
      "document": true,
      "suite": true,
      "test": true,
      "setup": true,
      "teardown": true,
      "suiteSetup": true,
      "suiteTeardown": true
    },
    "rules": {
      "strict": false,
      "brace-style": 2,
      "no-shadow": 0,
      "no-debugger": 1,
      "default-case": 2,
      "comma-dangle": [1, "always-multiline"],
      "indent": [2, 2],
      "no-underscore-dangle": 0,
      "no-use-before-define": 0,
      "no-unused-expressions": 0,
      "no-unused-vars": [2, {"vars": "all", "args": "none"}],
      "quotes": [2, "single", "avoid-escape"],
      "yoda": 0,
      "react/jsx-closing-bracket-location": [1, {"selfClosing": "tag-aligned", "nonEmpty": "after-props"}],
      "react/jsx-indent-props": [2, 2],
      "react/jsx-quotes": [2, "double"]
    },
    "env": {
      "browser": true,
      "node": true,
      "es6": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:silklabs/silk-webapp.git"
  },
  "keywords": [
    "iot"
  ],
  "private": true,
  "devDependencies": {
    "webpack-dev-server": "^1.10.1",
    "webpack-hot-middleware": "^2.0.0"
  }
}
