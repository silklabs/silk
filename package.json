{
  "name": "silk-server",
  "version": "1.0.0",
  "description": "Silk server and client API",
  "main": "dist/lib/main.js",
  "scripts": {
    "preinstall": "./bin/pre-install",
    "postinstall": "./bin/post-install",
    "build": "./build.sh",
    "lint": "eslint test src",
    "mocha": "DEBUG=silk-* mocha --timeout 5000 $(find test -name '*_test.js')",
    "start-server": "babel-node --harmony src/server/main.js production",
    "start-socketio": "babel-node --harmony src/socketio/main.js production",
    "start": "./bin/start.sh",
    "start-debug": "DEBUG=silk-*,-*:verbose npm start",
    "test": "npm run-script lint && npm run-script mocha"
  },
  "license": "proprietary",
  "dependencies": {
    "api-schema": "git@github.com:silklabs/api-schema.git#f23a9c7fd3cf68d4262cef1297543e26519a48af",
    "argparse": "^1.0.2",
    "aws-sdk-promise": "0.0.2",
    "babel": "^5.8.9",
    "babel-eslint": "~3.1.15",
    "babel-runtime": "^5.8.20",
    "babelify": "^6.1.3",
    "base64-js": "0.0.8",
    "base64url": "^1.0.4",
    "body-parser": "^1.12.2",
    "browserify": "^11.0.1",
    "debug": "^2.2.0",
    "elliptic": "^5.1.0",
    "eslint": "^0.22.1",
    "event-to-promise": "^0.3.3",
    "express": "^4.12.3",
    "hash.js": "^1.0.3",
    "joi": "^6.6.1",
    "js-base64": "^2.1.9",
    "jsonwebtoken": "git@github.com:silklabs/node-jsonwebtoken.git#12168fc568e299565b3824f79fc956890dcab87c",
    "localStorage": "^1.0.3",
    "lodash.merge": "^3.3.2",
    "mz": "^2.0.0",
    "node-fetch": "^1.3.2",
    "pbkdf2": "^3.0.4",
    "promise": "^6.1.0",
    "promised-mongo": "^1.2.0",
    "promised-temp": "^0.1.0",
    "range-parser": "^1.0.2",
    "scrypt": "^4.0.7",
    "socket.io": "^1.3.5",
    "socket.io-client": "^1.3.5",
    "superagent": "^1.2.0",
    "superagent-promise": "^0.2.0",
    "uuid": "^2.0.1"
  },
  "devDependencies": {
    "mkdirp": "^0.5.1",
    "mocha": "^2.2.5"
  },
  "engines": {
    "node": ">=0.12.x"
  },
  "engineStrict": true,
  "eslintConfig": {
    "parser": "babel-eslint",
    "globals": {
      "suite": true,
      "test": true,
      "setup": true,
      "teardown": true,
      "suiteSetup": true,
      "suiteTeardown": true
    },
    "rules": {
      "strict": false,
      "brace-style": 2,
      "no-shadow": 0,
      "no-debugger": 1,
      "default-case": 2,
      "comma-dangle": 0,
      "indent": [
        2,
        2
      ],
      "no-underscore-dangle": 0,
      "quotes": [
        2,
        "single",
        "avoid-escape"
      ],
      "yoda": 0
    },
    "env": {
      "node": true,
      "es6": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:silklabs/silk-server.git"
  },
  "keywords": [
    "iot"
  ],
  "private": true
}