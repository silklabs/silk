{
  "eslintConfig": {
    "env": {
      "es6": true,
      "node": true
    },
    "rules": {
      "yoda": 0,
      "quotes": [
        2,
        "single",
        "avoid-escape"
      ],
      "no-unused-vars": [
        2,
        {
          "args": "none",
          "vars": "all"
        }
      ],
      "no-unused-expressions": 0,
      "no-use-before-define": 0,
      "strict": 0,
      "brace-style": 2,
      "no-shadow": 0,
      "no-debugger": 1,
      "default-case": 2,
      "comma-dangle": 0,
      "indent": [
        2,
        2
      ],
      "no-underscore-dangle": 0
    },
    "globals": {},
    "plugins": [
      "react"
    ],
    "parser": "babel-eslint"
  },
  "devDependencies": {
    "webpack": "^1.12.1",
    "json-loader": "^0.5.2",
    "ios-deploy": "^1.7.0",
    "eslint-plugin-react": "^3.3.1",
    "eslint": "^0.22.1",
    "babel-loader": "^5.3.2",
    "babel-eslint": "~3.1.15",
    "babel-core": "^5.8.23"
  },
  "dependencies": {
    "uuid": "^2.0.1",
    "lodash.merge": "^3.3.2",
    "joi": "^5.1.0",
    "events": "^1.0.2",
    "deep-equal": "^1.0.1",
    "debug": "^2.2.0",
    "buffer": "^3.2.2",
    "babel-runtime": "^5.8.20",
    "art": "^0.10.0",
    "moment": "^2.10.3",
    "react-native": "^0.11.0",
    "react-native-button": "^1.2.0",
    "react-native-linear-gradient": "^0.3.2",
    "react-native-webpack-server": "git@github.com:silklabs/react-native-webpack-server.git#046a2f6a4353079e3376ebf340ec410986689144",
    "react-timer-mixin": "^0.13.2",
    "silk-api-react-native": "git@github.com:silklabs/silk-api-react-native.git#next",
    "socket.io-client-react-native": "git@github.com:silklabs/socket.io-client-react-native.git#3fcd84b345200ee9f3c03107412e33e72da19a4a"
  },
  "scripts": {
    "update": "./tools/update",
    "bundle": "react-native-webpack-server bundle --port 60050 --packagerPort 60051 --webpackPort 60052",
    "start": "react-native-webpack-server start --port 8081 --packagerPort 60045 --webpackPort 60046",
    "postinstall": "./tools/patch",
    "lint": "eslint ."
  },
  "private": true,
  "version": "0.0.1",
  "name": "Silk"
}
