{
  "name": "Silk",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "postinstall": "./tools/patch",
    "start": "react-native-webpack-server start --port 8081 --packagerPort 60045 --webpackPort 60046",
    "bundle": "react-native-webpack-server bundle --port 60050 --packagerPort 60051 --webpackPort 60052",
    "update": "./tools/update"
  },
  "dependencies": {
    "art": "^0.10.0",
    "babel-runtime": "^5.8.20",
    "buffer": "^3.2.2",
    "debug": "^2.2.0",
    "deep-equal": "^1.0.1",
    "events": "^1.0.2",
    "joi": "^5.1.0",
    "lodash.merge": "^3.3.2",
    "moment": "^2.10.3",
    "react-native": "^0.11.4",
    "react-native-button": "^1.2.0",
    "react-native-linear-gradient": "^0.3.2",
    "react-native-webpack-server": "0.5.1",
    "react-timer-mixin": "^0.13.2",
    "silk-api-react-native": "git@github.com:silklabs/silk-api-react-native.git#master",
    "socket.io-client-react-native": "git@github.com:silklabs/socket.io-client-react-native.git#3fcd84b345200ee9f3c03107412e33e72da19a4a",
    "uuid": "^2.0.1"
  },
  "devDependencies": {
    "babel-core": "^5.8.23",
    "babel-eslint": "~3.1.15",
    "babel-loader": "^5.3.2",
    "eslint": "^0.22.1",
    "eslint-plugin-react": "^3.4.2",
    "ios-deploy": "^1.7.0",
    "json-loader": "^0.5.2",
    "webpack": "^1.12.1"
  },
  "eslintConfig": {
    "parser": "babel-eslint",
    "plugins": [
      "react"
    ],
    "ecmaFeatures": {
      "jsx": true
    },
    "globals": {
    },
    "rules": {
      "strict": 0,
      "brace-style": 2,
      "no-shadow": 0,
      "no-debugger": 1,
      "default-case": 2,
      "comma-dangle": [1, "always-multiline"],
      "indent": [2, 2],
      "no-underscore-dangle": 0,
      "no-use-before-define": 0,
      "no-unused-expressions": 0,
      "no-unused-vars": [2, {"vars": "all", "args": "none"}],
      "quotes": [2, "single", "avoid-escape"],
      "yoda": 0,
      "react/jsx-closing-bracket-location": [1, {"selfClosing": "tag-aligned", "nonEmpty": "after-props"}],
      "react/jsx-indent-props": [2, 2],
      "react/jsx-quotes": [2, "double"]
    },
    "env": {
      "node": true,
      "es6": true
    }
  }
}
