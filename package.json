{
  "name": "silk-server",
  "version": "1.0.0",
  "description": "Silk server and client API",
  "main": "dist/lib/main.js",
  "scripts": {
    "postinstall": "./node_modules/.bin/grunt",
    "prepublish": "./node_modules/.bin/grunt",
    "start": "node dist/lib/main.js",
    "test": "./node_modules/.bin/grunt test"
  },
  "license": "proprietary",
  "dependencies": {
    "babel-eslint": "~3.1.15",
    "body-parser": "^1.12.2",
    "elliptic": "^3.0.3",
    "express": "^4.12.3",
    "eslint": "~0.22.1",
    "grunt": "^0.4.5",
    "grunt-babel": "^5.0.0",
    "grunt-browserify": "^3.8.0",
    "grunt-cli": "^0.1.13",
    "grunt-contrib-copy": "^0.8.0",
    "grunt-contrib-nodeunit": "^0.4.1",
    "grunt-eslint": "~14.0.0",
    "load-grunt-tasks": "^3.1.0",
    "localStorage": "^1.0.3",
    "promise": "^6.1.0",
    "request": "^2.53.0",
    "socket.io-client": "^1.3.5",
    "socket.io": "^1.3.5"
  },
  "engines": {
    "node": ">=0.12.x"
  },
  "engineStrict": true,
  "eslintConfig": {
    "parser": "babel-eslint",
    "rules": {
      "brace-style": 2,
      "no-debugger": 1,
      "default-case": 2,
      "comma-dangle": 0,
      "indent": [2, 2],
      "no-underscore-dangle": 0,
      "quotes": [
        2,
        "single",
        "avoid-escape"
      ],
      "yoda": 0
    },
    "env": {
      "node": true,
      "es6": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:silklabs/silk-server.git"
  },
  "keywords": [
    "iot"
  ],
  "private": true
}
