  "license": "proprietary",
  "dependencies": {
    "babel": "^5.8.9",
    "babel-core": "^5.8.23",
    "babel-eslint": "~3.1.15",
    "babel-loader": "^5.3.2",
    "babel-runtime": "^5.8.20",
    "babelify": "^6.1.3",
    "debug": "^2.2.0",
    "eslint": "^0.22.1",
    "event-to-promise": "^0.4.0",
    "express": "^4.12.3",
    "github-webhook-middleware": "0.0.2",
    "lodash.merge": "^3.3.2",
    "log": "git@github.com:silklabs/log.git#master",
