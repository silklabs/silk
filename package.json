{
  "name": "silk-core",
  "version": "0.15.2",
  "description": "Heroku shim and nothing more",
  "scripts": {
    "issue793": "find . -name .__silk_npm_lock -exec rm {} \\; -print",
    "preinstall": "./tools/heroku/deploy.sh",
    "reboot": "npm run zest ; npm run warmup",
    "warmup": "set -ex; source ./setup; for d in server sim webapp; do ( cd $d; npm install ); done",
    "zest": "./zest.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/silklabs/silk-core.git"
  },
  "engines": {
    "node": "^4.1.2",
    "npm": "^2.1.0"
  },
  "license": "proprietary",
  "private": true
}
