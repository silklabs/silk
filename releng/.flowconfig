[include]
lib/
../node_modules
../pub/node_modules

[ignore]
.*/node_modules/fbjs/.*
.*/node_modules/babel.*
.*/node_modules/json5/test.*
.*/node_modules/assert/.*
.*/node_modules/npm.*
.*/node_modules/read-package-tree/.*
.*/node_modules/config-chain/.*
.*/node_modules/registry-url/.*
.*/node_modules/bower-json/.*

.*/device/vendor/propsilk/.*
.*/device/vendor/silk/core/.*
.*/server/.*
.*/rtc/.*
.*/api/test/.*
.*/api-schema/.*
.*/azure-storage/.*
.*/pub/bsp-gonk/vendor/silk/.*

[options]
module.system=node
unsafe.enable_getters_and_setters=true
esproposal.class_instance_fields=ignore
esproposal.class_static_fields=ignore
suppress_comment= \\(.\\|\n\\)*\\$FlowFixMe

[version]
0.25.0
