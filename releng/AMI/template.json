{
    "variables": {
        "aws_access_key": "",
        "aws_secret_key": ""
    },
    "builders": [{
        "type": "amazon-ebs",
        "access_key": "{{user `aws_access_key`}}",
        "secret_key": "{{user `aws_secret_key`}}",
        "region": "us-east-1",
        "source_ami": "ami-2d39803a",
        "instance_type": "c3.8xlarge",
        "ssh_username": "ubuntu",
        "ami_name": "Silklabs gitlab runner {{timestamp}}"
    }],
    "provisioners": [{
        "type": "file",
        "source": "ssh",
        "destination": "/tmp/ssh"
    }, {
        "type": "file",
        "source": "etc/docker",
        "destination": "/tmp/docker"
    }, {
        "type": "file",
        "source": "etc/gitlab-register.conf",
        "destination": "/tmp/gitlab-register.conf"
    }, {
        "type": "file",
        "source": "etc/gitlab-unregister.conf",
        "destination": "/tmp/gitlab-unregister.conf"
    }, {
        "type": "file",
        "source": "etc/local",
        "destination": "/tmp/local"
    }, {
        "type": "file",
        "source": "scripts/install.sh",
        "destination": "/tmp/install.sh"
    }, {
        "type": "shell",
        "inline": [
          "chmod +x /tmp/install.sh",
          "sudo /tmp/install.sh"
        ]
    }]
}
