{
  "name": "releng",
  "version": "0.0.1",
  "description": "releng<3dev",
  "scripts": {
    "canceloldprs": "DEBUG=silk-*,-silk-*:debug babel-node lib/cancelOldPRs.js",
    "lint": "eslint lib",
    "flow": "flow check",
    "preinstall": "./bin/preinstall",
    "postinstall": "cd node_modules/eslint && npm i escope@3.2.0 && cd ../.. && webpack --progress",
    "start": "DEBUG=* babel-node lib/server/main.js production",
    "dev": "webpack-dev-server --host 0.0.0.0 --port 8000 --progress --hot --inline --watch-poll --watch-aggregate-timeout 300",
    "test": "npm run lint && npm run flow",
    "triggerbuilds": "DEBUG=silk-*,-silk-*:debug babel-node lib/trigger-builds.js",
    "issuemover": "DEBUG=silk-* babel-node lib/issue-mover.js",
    "upliftall": "DEBUG=silk-* babel-node lib/uplifter.js"
  },
  "license": "proprietary",
  "dependencies": {
    "babel": "^5.8.9",
    "babel-core": "^5.8.23",
    "babel-eslint": "~3.1.15",
    "babel-loader": "^5.3.2",
    "babel-runtime": "^5.8.20",
    "babelify": "^6.1.3",
    "body-parser": "~1.13.3",
    "debug": "^2.2.0",
    "eslint": "^0.22.1",
    "eslint-plugin-react": "~3.6.3",
    "event-to-promise": "^0.4.0",
    "express": "^4.12.3",
    "github-webhook-middleware": "0.0.2",
    "json-loader": "^0.5.4",
    "lodash.merge": "^3.3.2",
    "log": "../log",
    "node-localstorage": "^0.6.0",
    "octokat": "^0.4.14",
    "promise-callback": "^3.0.3",
    "react": "^0.14.3",
    "react-bootstrap": "^0.28.1",
    "react-dom": "^0.14.3",
    "react-router": "1.0.2",
    "request-promise": "^0.4.3",
    "script-loader": "^0.6.1",
    "silk-core-version": "file:../version",
    "silk-raygun": "file:../raygun",
    "sort-json": "^1.1.1",
    "source-map-support": "^0.3.2",
    "travis-ci": "^2.0.3",
    "webpack": "^1.12.1",
    "yamljs": "^0.2.4"
  },
  "devDependencies": {
    "flow-bin": "0.19.1",
    "webpack-dev-server": "^1.10.1",
    "webpack-hot-middleware": "^2.0.0"
  },
  "engines": {
    "node": "^4.1.2",
    "npm": "^2.1.0"
  },
  "engineStrict": true,
  "eslintConfig": {
    "env": {
      "browser": true,
      "es6": true,
      "node": true
    },
    "parser": "babel-eslint",
    "plugins": [
      "react"
    ],
    "rules": {
      "strict": false,
      "brace-style": 2,
      "no-shadow": 0,
      "no-debugger": 1,
      "default-case": 2,
      "comma-dangle": [
        1,
        "always-multiline"
      ],
      "camelcase": 0,
      "indent": [
        2,
        2
      ],
      "no-underscore-dangle": 0,
      "quotes": [
        2,
        "single",
        "avoid-escape"
      ],
      "react/jsx-closing-bracket-location": [
        1,
        {
          "nonEmpty": "after-props",
          "selfClosing": "tag-aligned"
        }
      ],
      "react/jsx-indent-props": [
        2,
        2
      ],
      "react/jsx-quotes": [
        2,
        "double"
      ],
      "no-unused-vars": [
        2,
        {
          "args": "none",
          "vars": "all"
        }
      ],
      "yoda": 0
    }
  },
  "private": true
}
