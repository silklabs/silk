#!/bin/bash
#
# Fetches pando app sdk release artifacts
#

LOCAL_PATH=$(readlink -f $(dirname $0))
SILK_CORE=$(readlink -f $LOCAL_PATH/../..)

source $SILK_CORE/pub/version/branch
echo BRANCH: $BRANCH

BUILDS="\
  kenzo-silkhub-$BRANCH-userdebug \
  pandohub-silkhub-$BRANCH-userdebug \
  kenzo-fuhuhub-$BRANCH-userdebug \
  pandohub-fuhuhub-$BRANCH-userdebug \
"
BUILD_URL_PREFIX=https://s3-us-west-2.amazonaws.com/silk-device

rm -rf $BRANCH
mkdir $BRANCH
cd $BRANCH
fail=
for BUILD in $BUILDS; do
  rm -f sha1
  wget --quiet -O sha1 $BUILD_URL_PREFIX/$BRANCH/$BUILD/last || true
  LATEST_SHA1=$(cat sha1)
  rm -f sha1
  if [[ -z $LATEST_SHA1 ]]; then
    echo Error: No build available for $BRANCH/$BUILD
    localfail="Error: No build available for $BRANCH/$BUILD"
    echo $localfail
    fail="$localfail $fail"
    continue
  fi
  echo -----------------------------------------------------------------------
  echo $BUILD - $LATEST_SHA1
  echo -----------------------------------------------------------------------
  wget -O $BUILD-${LATEST_SHA1:0:8}.tgz $BUILD_URL_PREFIX/$BRANCH/$BUILD/$LATEST_SHA1/$BUILD.tgz
done
cd ..

ls -l $BRANCH

if [[ -n "$fail" ]]; then
  echo $fail
  exit 1
fi

echo TODO: Upload dl/ to gdrive one day...
exit 0
