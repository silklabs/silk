#!/bin/bash -e
#
# Updates the internal device OTA location with the latest builds
#

LOCAL_PATH=$(readlink -f $(dirname $0))
SILK_CORE=$(readlink -f $LOCAL_PATH/../..)
KEYS_DIR=$(readlink -f $LOCAL_PATH/../gonk-signing/keys/)

cd $SILK_CORE
source setup
source pub/version/branch
echo BRANCH: $BRANCH

BUILD_URL_PREFIX=https://s3-us-west-2.amazonaws.com/silk-device
OTA_URL_PREFIX=http://update.silklabs.com/ota-internal
BUILDS="\
  mako-silk-$BRANCH-userdebug \
  kenzo-silk-$BRANCH-userdebug \
  kenzo-silkhub-$BRANCH-user \
  kenzo-silkhub-$BRANCH-userdebug \
  pandohub-silkhub-$BRANCH-userdebug \
  kenzo-fuhuhub-$BRANCH-userdebug \
  pandohub-fuhuhub-$BRANCH-userdebug \
"

if [[ -z $I_KNOW_WHAT_IM_DOING ]]; then
  echo "You don't know what you're doing."
  exit 1
fi

# Build necessary ota tools
cd bsp-gonk/
./sync kenzo gonkjs
source build/envsetup.sh
(
  cd build/
  git am $SILK_CORE/releng/gonk-signing/0001-Skip-fingerprint-check-when-AB-updates-are-enabled.patch
)
make -j4 otatools
which bsdiff
which imgdiff

for BUILD in $BUILDS; do

  if [[ $BUILD == pando* ]]; then
    echo Using Silk release key
    MAYBE_PACKAGE_KEY="--package_key $KEYS_DIR/releasekey"
  else
    echo Using stock AOSP key 
    MAYBE_PACKAGE_KEY=
  fi
    
  rm -rf \
    manifest.json \
    ota_dist \
    sha1 \
    latest_target_files.zip \
    prev_target_files.zip \
    prevprev_target_files.zip

  mkdir -p ota_dist

  wget -O sha1 $BUILD_URL_PREFIX/$BRANCH/$BUILD/last || true
  LATEST_SHA1=$(cat sha1)
  if [[ -z $LATEST_SHA1 ]]; then
    echo No build available for $BRANCH/$BUILD
    continue
  fi
  echo Latest build for $BRANCH/$BUILD is $LATEST_SHA1

  # OTA manifest header
  ota_manifest=ota_dist/${BUILD}.json
  echo Manifest: $ota_manifest
  {
    echo "{"
    echo "  \"${BUILD}\": {"
    echo "    \"info\": {"
    echo "      \"version\": \"$LATEST_SHA1\""
    echo "    }, "
  } >> $ota_manifest

  add_zip_to_otamanifest() {
    local zip="$1"
    local sha1="$2"

    local zip_size=`wc -c < "${zip}"`
    local zip_sha1=`openssl sha1 "${zip}" | sed 's/^.* //'`
    {
      echo "    \"$sha1\": {"
      echo "      \"version\": \"$LATEST_SHA1\"," # TODO: Remove this line on Sept 1st, 2016
      echo "      \"zip_url\": \"$OTA_URL_PREFIX/$(basename ${zip})\","
      echo "      \"zip_size\": \"$zip_size\","
      echo "      \"zip_sha1\": \"$zip_sha1\""
      echo "    }, "
    } >> $ota_manifest
  }

  #
  # Full OTA .zip
  #
  wget -O latest_target_files.zip $BUILD_URL_PREFIX/$BRANCH/$BUILD/$LATEST_SHA1/target_files.zip
  (
    set -x
    build/tools/releasetools/ota_from_target_files \
      --block \
      --verify \
      $MAYBE_PACKAGE_KEY \
      latest_target_files.zip \
      ota_dist/${BUILD}-full.zip
  )
  add_zip_to_otamanifest ota_dist/${BUILD}-full.zip "*"


  #
  # Maybe generate incremental OTA .zip from prev
  #
  rm -f sha1
  wget -O sha1 $BUILD_URL_PREFIX/$BRANCH/$BUILD/$LATEST_SHA1/last || true
  PREV_SHA1=$(cat sha1)
  if [[ -z $PREV_SHA1 ]]; then
    echo No previous build available for $BRANCH/$BUILD
  else
    echo Previous build for $BRANCH/$BUILD is $PREV_SHA1
    wget -O prev_target_files.zip $BUILD_URL_PREFIX/$BRANCH/$BUILD/$PREV_SHA1/target_files.zip
    (
      set -x
      build/tools/releasetools/ota_from_target_files \
        --block \
        --verify \
        $MAYBE_PACKAGE_KEY \
        --incremental_from prev_target_files.zip \
        latest_target_files.zip \
        ota_dist/${BUILD}-${PREV_SHA1}-inc.zip
    )
    add_zip_to_otamanifest ota_dist/${BUILD}-${PREV_SHA1}-inc.zip $PREV_SHA1
  fi

  #
  # Maybe generate incremental OTA .zip from prevprev
  #
  rm -f sha1
  wget -O sha1 $BUILD_URL_PREFIX/$BRANCH/$BUILD/$PREV_SHA1/last || true
  PREVPREV_SHA1=$(cat sha1)
  if [[ -z $PREVPREV_SHA1 ]]; then
    echo No previous previous build available for $BRANCH/$BUILD
  else
    echo Previous previous build for $BRANCH/$BUILD is $PREVPREV_SHA1
    wget -O prevprev_target_files.zip $BUILD_URL_PREFIX/$BRANCH/$BUILD/$PREVPREV_SHA1/target_files.zip
    (
      set -x
      build/tools/releasetools/ota_from_target_files \
        --block \
        --verify \
        $MAYBE_PACKAGE_KEY \
        --incremental_from prevprev_target_files.zip \
        latest_target_files.zip \
        ota_dist/${BUILD}-${PREVPREV_SHA1}-inc.zip
    )
    add_zip_to_otamanifest ota_dist/${BUILD}-${PREVPREV_SHA1}-inc.zip $PREVPREV_SHA1
  fi

  # OTA manifest footer
  echo "    \"\": null" >> $ota_manifest
  echo "  } " >> $ota_manifest
  echo "} " >> $ota_manifest

  # Maybe fetch previous OTA manifest
  wget -O manifest.json $OTA_URL_PREFIX/$BUILD.json || true
  touch $BUILD.json

  # Don't upload if manifest.json is unchanged
  if diff manifest.json $ota_manifest; then
    echo =================================================
    echo No change for $BRANCH/$BUILD, skipping ota upload
    echo =================================================
    continue
  fi

  if [[ $TRAVIS_PULL_REQUEST != false ]]; then
    echo TRAVIS_PULL_REQUEST = true, skipping OTA upload
    continue
  fi

  ../s3-artifacts/bin/upload \
      update.silklabs.com \
      ota-internal/ \
      $(readlink -f ota_dist) \
      --credentials update.silklabs.com_ota-internal \
      --noindex \
      --lossy \

done
