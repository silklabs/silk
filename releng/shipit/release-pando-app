#!/bin/bash -e
#
# Ships app parts of silk-core for the Pando project


# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
#
# DANGER ZONE - DANGER ZONE - DANGER ZONE - DANGER ZONE - DANGER ZONE
#
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
#
# List of silk-core top-level directories to ship
#
# BE MINDFUL ABOUT ADDING NEW DIRECTORIES TO THIS LIST
#
WHITELIST=$(cat <<-EOF
  LICENSE
  api
  api-schema
  app
  app-client
  app-config
  app-sdk
  app-sdk-example
  app-util
  async-utils
  azure-storage
  babeldeps
  ble-socket
  bsp-version
  cam
  config
  crypto
  fetch
  gradle
  http-client
  jsonwebtoken
  m2-local
  m2-remote
  mse-player
  node_modules
  npm_postinstall
  npm_preinstall
  onion
  pub
  raygun
  react-native-transformer
  react-native-webrtc
  redux
  rn-cli.config.js
  rtc
  silknpm.json
  streams
  utils
EOF
)
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!



if [[ ! -d .git ]]; then
  echo "Run from the root of the tree"
  exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo You have a dirty tree:
  git status --porcelain
  exit 1
fi

if [[ $(uname -s) != "Darwin" ]]; then
  echo Please run this script on OS X instead of $(uname -s)
  exit 1
fi

MAYBEDRYRUN=
if [[ $TRAVIS_PULL_REQUEST != false ]]; then
  MAYBEDRYRUN="--dry-run"
fi

source pub/version/branch
COMMIT=$(git rev-parse HEAD)
echo Shipping $COMMIT from $BRANCH

shopt -s nullglob
set -x

#
# Copy the latest code into the shipping git project.
# Git commit history is currently not preserved. :-/
#

pushd .
mkdir -p ../1/2/3/4/5
cd ../1/2/3/4/5       # Try to break anybody looking up relative paths
rm -rf ship
git clone git@github.com:silklabs/release-pando-app.git ship
cd ship
git checkout $BRANCH
git rm -rf --quiet *
popd

for dir in $WHITELIST; do
  rsync -ra --exclude "*.internal.*" $dir ../1/2/3/4/5/ship/
done
cd ../1/2/3/4/5/ship
echo '{"name": "release-pando-app"}' > package.json
git add *
if [[ -z "$(git status --porcelain | head -n1)" ]]; then
  echo No new changes to push.  Done
  exit 0
fi

git commit --quiet -m "https://github.com/silklabs/silk-core/commit/$COMMIT"

#
# Smoke test the iOS example app before shipping
#
# TODO: Reduce the duplication with app-sdk-example/ios/.travis.yml here...
#

app-sdk/install.sh
app/ios/travis/install

cd app-sdk-example
export CONFIGURATION=Debug
export PROJECT=SilkAppSDKExample
export RCT_NO_LAUNCH_PACKAGER=1
xcodebuild \
  -project ios/$PROJECT.xcodeproj \
  -scheme $PROJECT \
  -configuration $CONFIGURATION \
  -sdk iphonesimulator \
  build
cd ..

#
# Looks good, :shipit:
#
if [[ -z $I_KNOW_WHAT_IM_DOING ]]; then
  echo "You don't know what you're doing."
  exit 1
fi

git push $MAYBEDRYRUN origin $BRANCH
exit 0
