#!/bin/bash -e
#
# Ships app parts of silk-core for the Pando project


# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
#
# DANGER ZONE - DANGER ZONE - DANGER ZONE - DANGER ZONE - DANGER ZONE
#
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
#
# List of silk-core top-level directories to ship
#
# BE MINDFUL ABOUT ADDING NEW DIRECTORIES TO THIS LIST
#
WHITELIST=$(cat <<-EOF
  LICENSE
  app-sdk-example
  gradle
  m2-local
  m2-remote
EOF
)
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!



if [[ ! -d .git ]]; then
  echo "Run from the root of the tree"
  exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo You have a dirty tree:
  git status --porcelain
  exit 1
fi

if [[ $(uname -s) != "Darwin" ]]; then
  echo Please run this script on OS X instead of $(uname -s)
  exit 1
fi

source pub/version/branch
COMMIT=$(git rev-parse HEAD)
echo Shipping $COMMIT from $BRANCH

shopt -s nullglob
set -x

git branch -f shipit
git checkout shipit

#
# Set up tree for building the app SDK.
#
app-sdk/install.sh


#
# Produce binary artifacts for the Android SDK
#
# TODO: ideally this would be done in a separate build run before this one;
# generating artifacts for iOS and Android is easily parallelizable.
#

# For now we're building the Debug variant of the SDK (or at least the
# Debug variant of the bundle) to get better logs.
export SLK_SDK_BUILD_CONFIGURATION=Debug

# "Install" Android SDK so we can build Android binaries. This
# tarball was created by doing the following:
# 1. Download and extract https://dl.google.com/android/android-sdk_r24.4.1-macosx.zip
# 2. Run tools/android from the resulting directory
# 3. Select only the following packages to be installed:
#    - Android SDK Platform-tools 24.0.3
#    - Android SDK Build-tools 23.0.3
#    - SDK Platform 23rev3
#    - Android Support Repository rev38
#    - Google Repository 35
pushd ..
curl https://s3.amazonaws.com/silk-releng-us-east-1/master/build-tools/android-sdk-macosx-gms.tgz | tar xzf -
export ANDROID_HOME=$PWD/android-sdk-macosx
popd

# Build example app and its dependencies and dump build artifacts into
# local Maven2 repository.
pushd app-sdk-example/android
../../gradle/gradlew uploadArchives --info --refresh-dependencies --console=plain
popd

# Also dump the React Native artifacts in there
git mv node_modules/react-native/android/com/facebook m2-local/com/

# Check in the build artifacts into a local-only commit on silk-core
git add m2-local
git commit --quiet -m "Maven2 artifacts"


#
# Produce binary artifacts for the iOS SDK
#
# TODO: ideally this would be done in a separate build run before this one;
# generating artifacts for iOS and Android is easily parallelizable.
#

# Build SLKAppSDK.framework
app-sdk/ios/build_framework.sh

# Commit the resulting binary, as well as WebRTC.framework, in the
# iOS SDK example app project.
mv app-sdk/ios/build/$SLK_SDK_BUILD_CONFIGURATION-universal/SLKAppSDK.framework app-sdk-example/ios/
git add app-sdk-example/ios
git mv react-native-webrtc/ios/WebRTC.framework app-sdk-example/ios/
git commit --quiet -m "iOS artifacts"


#
# Clean the repo of all other build artifacts, we don't want to sync
# these over.
#

git clean -xffd


#
# Copy the latest code into the shipping git project.
# Git commit history is currently not preserved. :-/
#

pushd .
mkdir -p ../1/2/3/4/5
cd ../1/2/3/4/5       # Try to break anybody looking up relative paths
rm -rf ship
git clone git@github.com:silklabs/release-pando-app.git ship
cd ship
git checkout $BRANCH
git rm -rf --quiet *
popd

for dir in $WHITELIST; do
  rsync -ra --exclude "*.internal.*" $dir ../1/2/3/4/5/ship/
done
cd ../1/2/3/4/5/ship
git add *
if [[ -z "$(git status --porcelain | head -n1)" ]]; then
  echo No new changes to push.  Done
  exit 0
fi

git commit --quiet -m "https://github.com/silklabs/silk-core/commit/$COMMIT"


#
# Smoke test the Android SDK example app before shipping
#

pushd app-sdk-example/android
../../gradle/gradlew assembleDebug --info --refresh-dependencies --console=plain
popd


#
# Smoke test the iOS SDK example app before shipping
#

pushd app-sdk-example
export CONFIGURATION=Debug
export PROJECT=SilkAppSDKExample
export RCT_NO_LAUNCH_PACKAGER=1
xcodebuild \
  -project ios/$PROJECT.xcodeproj \
  -scheme $PROJECT \
  -configuration $CONFIGURATION \
  -sdk iphonesimulator \
  -destination "platform=iOS Simulator,name=iPhone 6" \
  build
popd


#
# Looks good, :shipit:
#
if [[ -z $I_KNOW_WHAT_IM_DOING ]]; then
  echo "You don't know what you're doing."
  exit 1
fi

if [[ $TRAVIS_PULL_REQUEST == false ]]; then
  git push origin $BRANCH
fi
exit 0
