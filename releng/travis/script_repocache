#!/bin/bash -e
#
# Run from releng/
#

if [[ -n $1 ]]; then
  GONK=$1
fi

if [[ -z $GONK ]]; then
  echo Error: GONK not specified
  echo
  echo "usage: $0 <GONK>"
  echo
  exit 1
fi

set -x
cd ..
npm run zest
if [[ -n "$GONK_REPO" ]]; then
  ( set -x; time git clone $GONK_REPO device/gonk/$GONK )
fi
make -C device repocache.$GONK

mkdir -p deploy/repocache
mv device/repocache*tgz deploy/repocache/
exit 0
