#!/bin/bash -e
#
# Must be run from the root directory of silk-core
#

if [[ -n $1 ]]; then
  GONK=$1
fi

if [[ -z $GONK ]]; then
  echo Error: GONK not specified
  echo
  echo "usage: $0 <GONK>"
  echo
  exit 1
fi

set -x
make -C device repocache.$GONK

mkdir -p deploy/repocache
mv device/repocache*tgz deploy/repocache
exit 0
