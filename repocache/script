#!/bin/bash
#
# Run from silk-core
#

set -e
GET_OFF_MY_LAWN=1
source setup

if [[ -n $1 ]]; then
  BOARD=$1
fi

if [[ -n $2 ]]; then
  PRODUCT=$2
fi

if [[ -z $PRODUCT ]]; then
  PRODUCT=silk
fi

if [[ -z $BOARD ]]; then
  echo Error: BOARD not specified
  echo
  echo "usage: $0 <BOARD> [<PRODUCT>]"
  echo
  exit 1
fi

set -x
if [[ -n "$BOARD_REPO" ]]; then
  ( set -x; time git clone $BOARD_REPO bsp-gonk/board/$BOARD )
fi

cd bsp-gonk/

# Helper to make a noise to avoid Travis from killing the job after 10 minutes of
# --quiet repo syncing
function keep_alive {
   while true; do
      echo "(Travis keep_alive)"
      sleep 30s
   done
}

keep_alive &
keep_alive_pid=$!
if [[ -n "$FULLHISTORY" ]]; then
  # --depth=1 fails for some CAF manifests.  FULLHISTORY is used as a workaround
  # to fetch the entire git history.  Don't use this lightly as it causes the
  # resulting .repo/ to be many gigabytes larger
  ./repocache buildfull $BOARD $PRODUCT
else
  ./repocache build $BOARD $PRODUCT
fi
set +e
kill $keep_alive_pid
wait $keep_alive_pid 2>/dev/null
set -e

cd ..

mkdir -p deploy/repocache
mv bsp-gonk/*tgz deploy/repocache/

source pub/version/branch
if [[ -z $BRANCH ]]; then
  echo BRANCH not defined, skipping upload
  exit 1
fi

./s3-artifacts/bin/upload \
  silk-releng-us-east-1 \
  $BRANCH \
  $(pwd)/deploy \
  --credentials temporary_artifacts \
  --lossy \
  --noindex \

exit 0
