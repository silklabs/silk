#!/bin/bash -e
#
# Run from silk-core
#

GET_OFF_MY_LAWN=1
source setup

if [[ -n $1 ]]; then
  GONK=$1
fi

if [[ -z $GONK ]]; then
  echo Error: GONK not specified
  echo
  echo "usage: $0 <GONK>"
  echo
  exit 1
fi

set -x
if [[ -n "$GONK_REPO" ]]; then
  ( set -x; time git clone $GONK_REPO bsp-gonk/board/$GONK )
fi

cd bsp-gonk/
./repocache build $GONK silk

# Helper to make a noise to avoid Travis from killing the job after 10 minutes of
# --quiet repo syncing
function keep_alive {
   while true; do
      echo "(Travis keep_alive)"
      sleep 30s
   done
}

keep_alive &
keep_alive_pid=$!
./repocache build $GONK silk

kill $keep_alive_pid
wait $keep_alive_pid 2>/dev/null

cd ..

mkdir -p deploy/repocache
mv bsp-gonk/*tgz deploy/repocache/
exit 0
