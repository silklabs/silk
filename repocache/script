#!/bin/bash -e
#
# Run from silk-core
#

GET_OFF_MY_LAWN=1
source setup

if [[ -n $1 ]]; then
  GONK=$1
fi

if [[ -z $GONK ]]; then
  echo Error: GONK not specified
  echo
  echo "usage: $0 <GONK>"
  echo
  exit 1
fi

set -x
if [[ -n "$GONK_REPO" ]]; then
  ( set -x; time git clone $GONK_REPO bsp-gonk/board/$GONK )
fi

cd bsp-gonk/
./repocache build $GONK
cd ..

mkdir -p deploy/repocache
mv bsp-gonk/*tgz deploy/repocache/
exit 0
