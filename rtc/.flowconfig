[include]
../api

[ignore]
.*/build/.*
.*/test/rntest/.*
.*/node_modules/api-schema/.*
.*/node_modules/aws-sdk-promise/.*
.*/node_modules/jsonwebtoken/.*
.*/node_modules/socket.io/.*
.*/node_modules/socket.io-client/.*
.*/node_modules/node-fetch/.*
.*/node_modules/babel*

.*/server/src/.*
.*/server/test/server/.*
.*/server/test/socketio/.*
.*/server/test/signaling/.*
.*/streams/test/.*
.*/azure-storage/test/.*

[libs]
../server/interface/mocha.js
../device/vendor/silk/core/interface/net.js


[options]
module.system=haste
esproposal.class_instance_fields=ignore
esproposal.class_static_fields=ignore
unsafe.enable_getters_and_setters=true
suppress_comment= \\(.\\|\n\\)*\\$FlowFixMe

[version]
0.25.0
