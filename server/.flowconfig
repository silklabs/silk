[ignore]
.*/build/.*
.*/test/rntest/.*
.*/tmp/.*
.*/node_modules/aws-sdk-promise/.*
.*/node_modules/jsonwebtoken/.*
.*/node_modules/socket.io/.*
.*/node_modules/socket.io-client/.*
.*/node_modules/node-fetch/.*
.*/node_modules/silk-api/node_modules/babel.*
.*/node_modules/babel.*
.*/node_modules/npm/.*
.*/node_modules/json5/.*
.*/node_modules/config-chain/.*
.*/node_modules/read-package-tree/.*
.*babel-eslint.*
.*api-schema.*

[include]
../node_modules

[libs]
interface

[options]
module.system=haste
esproposal.class_instance_fields=ignore
esproposal.class_static_fields=ignore
unsafe.enable_getters_and_setters=true
suppress_comment= \\(.\\|\n\\)*\\$FlowFixMe

[version]
0.26.0
