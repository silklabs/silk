  "devDependencies": {
    "dev-null": "^0.1.1",
    "flow-bin": "0.19.0",
    "mocha": "^2.2.5",
    "timekeeper": "0.0.5"
  },
  "engineStrict": true,
  "engines": {
    "node": "^4.1.2",
    "npm": "^2.1.0"
  },
  "keywords": [
    "iot"
  ],
  "license": "proprietary",
  "main": "dist/lib/main.js",
  "name": "silk-server",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:silklabs/silk-server.git"
  },
  "scripts": {
    "build": "./build.sh",
    "flow": "flow check",
    "lint": "eslint test src",
    "mocha": "DEBUG=silk-* mocha --timeout 5000 $(find test ! -path 'test/rntest/*' -name '*_test.js')",
    "postinstall": "cd node_modules/eslint && npm i escope@3.2.0 && cd ../.. && ./bin/post-install",
    "preinstall": "npm install babel",
    "pretest": "babel-node src/api_generate",
    "start": "./bin/start.sh",
    "start-debug": "DEBUG=silk-*,-*:verbose npm start",
    "start-server": "babel-node --harmony src/server/main.js production",
    "start-socketio": "babel-node --harmony src/socketio/main.js production",
    "test": "npm run-script lint && npm run-script flow && npm run-script mocha",
    "test-react-native-api": "./bin/test-react-native-api",
    "wwwdev": "./build/browser/build.sh -w"
  },
  "version": "1.0.0"
}
