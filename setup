SOURCE="${BASH_SOURCE[0]}"
if [ -z $SOURCE ];
then
  # zsh support....
  SOURCE=${(%):-%N}
fi

while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$( cd -P "$( dirname "$SOURCE" )" && pwd )"

export SILKRC=$ROOT/.silkrc
export PATH=$ROOT/cli:$PATH

for subdir in sdk cli-plugin-internal; do
  if [ ! -d $ROOT/$subdir/node_modules ]; then
    if [ -z $GET_OFF_MY_LAWN ]; then
      ( cd $ROOT/$subdir; npm install )
    else
      echo "Please run npm install inside of $subdir/ for full CLI"
    fi
  fi
done
