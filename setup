#
# Prepares the Silk command-line environment.
#
# |source| this file.
#

SOURCE="${BASH_SOURCE[0]}"
if [ -z $SOURCE ]; then
  # zsh support....
  SOURCE=${(%):-%N}
fi

while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$( cd -P "$( dirname "$SOURCE" )" && pwd )"

export SILKRC=$ROOT/.silkrc
export PATH=$ROOT/pub/cli:$ROOT/gradle:$PATH
# WARNING: REPOCACHE_URLPREFIX is duplicated in builds.js
export REPOCACHE_URLPREFIX=https://silk-releng-us-east-1.s3-external-1.amazonaws.com/master/repocache/
export FULL_SERVICE=1
export PATH=$ROOT/node_modules/.bin:$PATH
# So npm init uses our custom init tooling ...
export npm_config_init_module=$ROOT/npminit.js

$ROOT/tools/version_checks.sh
