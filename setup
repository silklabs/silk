#
# Prepares the Silk command-line environment.
#
# |source| this file.
#

SOURCE="${BASH_SOURCE[0]}"
if [ -z $SOURCE ]; then
  # zsh support....
  SOURCE=${(%):-%N}
fi

while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$( cd -P "$( dirname "$SOURCE" )" && pwd )"

export SILKRC=$ROOT/.silkrc
export PATH=$ROOT/cli:$PATH

# silk-caffe hack the find patches
export SILK_CAFFE_PATCH_TREE=$ROOT/device/gonk/silk/patch/external

for subdir in sdk cli-plugin-internal; do
  if [ ! -d $ROOT/$subdir/node_modules ]; then
    if [ -z $GET_OFF_MY_LAWN ]; then
      ( cd $ROOT/$subdir; npm install )
    else
      echo "Please run npm install inside of $subdir/ for full CLI"
    fi
  fi
done

if [ $(uname) == "Darwin" ]; then
  # Following packages are needed by caffe module
  brew install -vd snappy leveldb gflags glog szip lmdb
  brew install hdf5

  brew install -vd openblas
  brew link --force --overwrite openblas

  BOOST="$(brew list -1 | grep -i "^boost\$" || true)"
  if [[ -z $BOOST ]]; then
    brew install boost
  fi
fi

