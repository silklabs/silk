#!/bin/bash -ex

cd $(dirname $0)/../..

node_resolve() {
  local pkg=$1
  pkg=$(node -p "require.resolve('$pkg/package.json');")
  dirname $pkg
}

node_resolve silk-gonk-version

mkdir -p system/node_modules
cp -f $(node_resolve silk-gonk-version)/gonk_version.js system/node_modules/base_version.js

mkdir -p system/silk/bin
rm -f system/silk/bin/node
ln -sf $(which node) system/silk/bin/node

mkdir -p dev/socket

# Default system properties
system/bin/setprop ro.silk.bt.hw.enabled false
system/bin/setprop ro.debuggable 1

# Silk system properties (TODO: merge with /device/product/silk/build.prop)
system/bin/setprop persist.silk.main silk-device-core
system/bin/setprop persist.silk.extensions \*

# TODO: Move these things out of device/vendor/silk/init for better sharing
echo "#!/bin/bash" > system/silk/bin/silk-init
cat ../pub/bsp-gonk/vendor/silk/init/silk-init >> system/silk/bin/silk-init
chmod +x system/silk/bin/silk-init

echo "#!/bin/bash" > system/silk/bin/dash
cat ../bsp-gonk/vendor/propsilk/dash/dash >> system/silk/bin/dash
chmod +x system/silk/bin/dash
