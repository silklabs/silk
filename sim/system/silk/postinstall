#!/bin/bash -ex

cd $(dirname $0)/../..

mkdir -p system/node_modules
cp -f system/silk/node_modules/silk-device/lib/base_version.js system/node_modules/

mkdir -p system/silk/bin
ln -sf $(which node) system/silk/bin/node

# Default system properties
system/bin/setprop persist.silk.debug "silk-*,-silk-*:debug"
system/bin/setprop persist.silk.debug.colors true
system/bin/setprop persist.silk.extensions "*,-oksilk,-cmt,-detectcat"
system/bin/setprop ro.silk.update.manifest_url "https://silk-device.s3.amazonaws.com/{channel}/latest/{device}_ota.json"
system/bin/setprop ro.silk.update.poll_hours 3
system/bin/setprop ro.silk.bt.hw.enabled false

# TODO: Move these things out of device/vendor/gonk/init for better sharing
for cmd in dash silk-core; do
  simcmd=system/silk/bin/$cmd
  echo "#!/bin/bash" > $simcmd
  cat ../device/vendor/silk/gonk/init/$cmd >> $simcmd
  chmod +x $simcmd
done

system/silk/ext/install
