#!/bin/bash -ex

cd $(dirname $0)/../..

mkdir -p system/node_modules
cp -f system/silk/node_modules/silk-device/lib/base_version.js system/node_modules/

mkdir -p system/silk/bin
rm -f system/silk/bin/node
ln -sf $(which node) system/silk/bin/node

# Default system properties
system/bin/setprop ro.silk.bt.hw.enabled false
ln -sf ../device/vendor/silk/gonk/core/silk-props.json system/silk/silk-props.json

# TODO: Move these things out of device/vendor/gonk/init for better sharing
echo "#!/bin/bash" > system/silk/bin/silk-init
cat ../device/vendor/silk/gonk/init/silk-init >> system/silk/bin/silk-init
chmod +x system/silk/bin/silk-init

echo "#!/bin/bash" > system/silk/bin/dash
cat ../device/vendor/silk/gonk/dash/dash >> system/silk/bin/dash
chmod +x system/silk/bin/dash
# END TODO

system/silk/ext/install
