#!/bin/bash -ex

cd $(dirname $0)/../..

mkdir -p system/node_modules
cp -f system/silk/node_modules/silk-device-main/lib/base_version.js system/node_modules/

mkdir -p system/silk/bin
rm -f system/silk/bin/node
ln -sf $(which node) system/silk/bin/node

# Default system properties
system/bin/setprop ro.silk.bt.hw.enabled false
system/bin/setprop ro.debuggable 1
ln -f ../device/vendor/silk/core/silk-props.json system/silk/silk-props.json
ln -f ../pub/bsp-gonk/vendor/silk/gonk/init/silk-init.js system/silk/silk-init.js

# TODO: Move these things out of device/vendor/gonk/init for better sharing
echo "#!/bin/bash" > system/silk/bin/silk-init
cat ../pub/bsp-gonk/vendor/silk/gonk/init/silk-init >> system/silk/bin/silk-init
chmod +x system/silk/bin/silk-init

echo "#!/bin/bash" > system/silk/bin/dash
cat ../bsp-gonk/vendor/propsilk/dash/dash >> system/silk/bin/dash
chmod +x system/silk/bin/dash
# END TODO

system/silk/ext/install
