LOCAL_PATH=$(dirname $0)

# Assume that a device is already running and stable, so just perform a quick
# check to ensure it's reachable
adb="timeout -s KILL 10s adb"
$adb wait-for-device

echo "<<<<<<<<<<<<<< Restarting all silk services >>>>>>>>>>>>>>"
$adb shell stop
$adb shell start
$LOCAL_PATH/devicecheck

echo "<<<<<<<<<<<<<< Restarting just the silk process >>>>>>>>>>>>>>"
$adb shell stop silk
$adb shell start silk
$LOCAL_PATH/devicecheck

echo "<<<<<<<<<<<<<< Restarting just the capture process >>>>>>>>>>>>>>"
$adb shell stop capture
$adb shell start capture
# TODO: Need a way to validate the silk process has re-established contact with
#       capture. For now just sleep for a while to permit time for something to
#       maybe crash
sleep 5

exit 0
