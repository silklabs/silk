TEST_DIR=/system/silk/silk-test
MOCHA_ARGS="--ui tdd"
MOCHA_ARGS="$MOCHA_ARGS --reporter spec"
MOCHA_ARGS="$MOCHA_ARGS --harmony"

result=$(adb shell silk $TEST_DIR/node_modules/mocha/bin/mocha $MOCHA_ARGS $TEST_DIR/dist/lib/test)
echo "$result"

resultCode=$(echo "$result" | grep -Eo "(\d*) failing"| cut -d" " -f1)
echo "result code: $resultCode"
echo
echo "**************"
if [[ (-n $resultCode) && ($resultCode -ne 0) ]]; then
  echo Tests failed
else
  echo Tests completed successfully
fi;
echo "**************"
