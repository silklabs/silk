#! /usr/bin/env node

/**
This is a little hack program to read config.local.json to decide if xcode
should run react-native bundle or not.
*/

// XXX: Default config.json ?
var config = {
  "react-native": { type: "bundle" }
};

try {
  var config = require('../config.local.json')
} catch(e) {}

// For the purpose of the build process we treat "bundle" with a "local" field
// as "local".

var type = config['react-native'].type;
if (type === 'bundle' && config['react-native'].local) {
  type = 'local';
}
process.stdout.write(type);
