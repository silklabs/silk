[include]
src/
../../node_modules/
../../pub/node_modules/

[ignore]
.*/node_modules/babel.*
.*/node_modules/eslint.*
.*/node_modules/fbjs/.*
.*/node_modules/config-chain/.*
.*/node_modules/read-package-tree/.*
.*/node_modules/npm.*
.*/node_modules/registry-url/.*
.*/node_modules/bower-json/.*

.*/api/test/.*
.*/server/test/.*
.*/device/vendor/propsilk/silk-cv/interface/.*

[libs]
../../flow-interface

[options]
unsafe.enable_getters_and_setters=true
module.system=haste
esproposal.class_instance_fields=ignore
esproposal.class_static_fields=ignore
suppress_comment= \\(.\\|\n\\)*\\$FlowFixMe
suppress_comment= \\(.\\|\n\\)*\\$FlowWTF

[version]
0.26.0
