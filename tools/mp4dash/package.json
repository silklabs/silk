{
  "name": "silk-mp4dash",
  "description": "Tools to generate mp4 dash videos",
  "version": "0.0.1",
  "license": "proprietary",
  "scripts": {
    "postinstall": "../npm/postinstall.js",
    "flow": "flow check",
    "lint": "eslint src",
    "test": "npm run lint && npm run flow",
    "start": "DEBUG=silk-* ../../babel-run/babel-node ./src/server.js",
    "cat": "DEBUG=silk-* ../../babel-run/babel-node ./src/file_writer.js cat",
    "file": "DEBUG=silk-* ../../babel-run/babel-node ./src/file_writer.js cat",
    "segments": "DEBUG=silk-* ../../babel-run/babel-node ./src/file_writer.js segments",
    "combine": "DEBUG=silk-* ../../babel-run/babel-node ./src/m4s_combinator.js"
  },
  "silkDependencies": {
    "eslint-config-silk": "/eslint",
    "silk-api": "/api",
    "silk-babeldeps": "/babeldeps",
    "silk-cam": "/cam",
    "silk-flow-bin": "/flow-bin",
    "silk-log": "/log"
  },
  "dependencies": {
    "babel-eslint": "5.0.0",
    "eslint": "1.10.3",
    "fs-extra": "0.26.5",
    "mz": "2.0.0",
    "socket.io-client": "1.4.5"
  },
  "eslintConfig": {
    "extends": "eslint-config-silk"
  }
}
