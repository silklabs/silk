{
  "name": "silk-mp4dash",
  "description": "Tools to generate mp4 dash videos",
  "version": "0.0.1",
  "license": "proprietary",
  "scripts": {
    "postinstall": "../npm/postinstall.js",
    "flow": "flow check",
    "lint": "eslint src",
    "check": "npm run lint && npm run flow",
    "test": "npm run check",
    "start": "DEBUG=silk-* babel-node --presets ./node_modules/babel-preset-es2015,./babel-preset-stage-0 --plugins ./node_modules/babel-plugin-syntax-flow,./node_modules/babel-plugin-transform-flow-strip-types --only /src/**,/node_modules/silk-api/src/** -- ./src/server.js",
    "cat": "DEBUG=silk-* babel-node --presets ./node_modules/babel-preset-es2015,./babel-preset-stage-0 --plugins ./node_modules/babel-plugin-syntax-flow,./node_modules/babel-plugin-transform-flow-strip-types --only /src/**,/node_modules/silk-api/src/** -- ./src/file_writer.js cat",
    "segments": "DEBUG=silk-* babel-node --presets ./node_modules/babel-preset-es2015,./babel-preset-stage-0 --plugins ./node_modules/babel-plugin-syntax-flow,./node_modules/babel-plugin-transform-flow-strip-types --only /src/**,/node_modules/silk-api/src/** -- ./src/file_writer.js segments",
    "file": "DEBUG=silk-* babel-node --presets ./node_modules/babel-preset-es2015,./babel-preset-stage-0 --plugins ./node_modules/babel-plugin-syntax-flow,./node_modules/babel-plugin-transform-flow-strip-types --only /src/**,/node_modules/silk-api/src/** -- ./src/file_writer.js cat",
    "combine": "DEBUG=silk-* babel-node --presets ./node_modules/babel-preset-es2015,./babel-preset-stage-0 --plugins ./node_modules/babel-plugin-syntax-flow,./node_modules/babel-plugin-transform-flow-strip-types --only /src/**,/node_modules/silk-api/src/** -- ./src/m4s_combinator.js"
  },
  "silkDependencies": {
    "eslint-config-silk": "/eslint",
    "silk-api": "/api",
    "silk-flow-bin": "/flow-bin",
    "silk-log": "/log"
  },
  "dependencies": {
    "babel-cli": "6.3.13",
    "babel-core": "6.3.13",
    "babel-eslint": "5.0.0beta9",
    "babel-plugin-syntax-flow": "6.3.13",
    "babel-plugin-transform-flow-strip-types": "6.3.13",
    "babel-preset-es2015": "6.3.13",
    "babel-preset-stage-0": "6.3.13",
    "eslint": "1.10.3",
    "fs-extra": "0.26.5",
    "mz": "2.0.0",
    "socket.io-client": "1.4.5"
  },
  "eslintConfig": {
    "extends": "eslint-config-silk"
  }
}
