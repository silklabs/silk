{
  "name": "silk-mp4dash",
  "description": "Tools to generate mp4 dash videos",
  "version": "0.0.1",
  "license": "proprietary",
  "scripts": {
    "postinstall": "../../npm_postinstall",
    "lint": "eslint src",
    "test": "npm run lint",
    "start": "DEBUG=silk-* ../../pub/babel-run/babel-node ./src/server.js",
    "cat": "DEBUG=silk-* ../../pub/babel-run/babel-node ./src/file_writer.js cat",
    "file": "DEBUG=silk-* ../../pub/babel-run/babel-node ./src/file_writer.js cat",
    "segments": "DEBUG=silk-* ../../pub/babel-run/babel-node ./src/file_writer.js segments",
    "combine": "DEBUG=silk-* ../../pub/babel-run/babel-node ./src/m4s_combinator.js"
  },
  "symlinkDependencies": {
    "eslint-config-silk": "/pub/eslint-config",
    "silk-api": "/api",
    "silk-babeldeps": "/babeldeps",
    "silk-cam": "/cam",
    "silk-log": "/pub/log"
  },
  "dependencies": {
    "babel-eslint": "6.1.0",
    "eslint": "2.13.1",
    "eslint-plugin-flowtype": "2.18.1",
    "fs-extra": "0.26.5",
    "mz": "2.4.0",
    "socket.io-client": "1.4.6"
  },
  "eslintConfig": {
    "extends": "eslint-config-silk"
  }
}