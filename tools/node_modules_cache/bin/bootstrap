#! /bin/bash -e

if [[ "$V" == "1" ]]; then
  set -x
fi

ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

current_hash=$(cat $ROOT/../hash)
installed_hash=""
cache_path=$ROOT/../node_modules/.node_modules_cache.json

if [[ -f "$cache_path" ]]; then
  installed_hash=$(node -p -e "require('$cache_path').hash")
fi

bootstrap() {
  rm -rf $ROOT/../node_modules
  # Use faster simpler "install" action to bootstrap ourselves... We don't need
  # anything more complex since we don't need to run our our on lifecycle hooks.
  url=$(cat $ROOT/../bootstrap_url)
  cd $ROOT/../
  $ROOT/../../../cli-metrics/submit node_modules_cache_boostrap -- \
    "curl -L '$url' | tar -xz"
  cd -
}

if [[ "$installed_hash" != "$current_hash" ]];
then
  bootstrap
fi
