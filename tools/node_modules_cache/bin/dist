#! /usr/bin/env ./node_modules/.bin/babel-node

/**
 * This module deals with uploading a copy of the current node_module_cache
 * tools. This is so we can use node_modules to build the script but not check
 * them in or depend on npm in development.
 */

import path from 'path';
import fs from 'fs';

import cli from '../src/';
import computeHash from '../src/compute_hash';
import pkg from '../package.json';
import cloudfrontUrl from '../src/cloudfront_url'


const HASH_FILE = path.join(__dirname, '..', 'hash');
const BOOTSTRAP_URL = path.join(__dirname, '..', 'bootstrap_url');

async function main() {
  console.log('Creating bundle...');
  await cli('upload', path.join(__dirname, '..'));
  let hash = computeHash(pkg);
  console.log('Writing out current hash to', HASH_FILE);
  fs.writeFileSync(HASH_FILE, hash);
  console.log('Writing out boostrap script', BOOTSTRAP_URL);

  // CloudFront allows signing into the far future... So we sign for the next 15
  // years or so...
  let url = cloudfrontUrl(hash, new Date(2030, 1));
  fs.writeFileSync(BOOTSTRAP_URL, url);
}

main().catch((err) => {
  setTimeout(() => {
    throw err;
  });
});
