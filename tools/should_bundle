#! /usr/bin/env node

/**
This is a little hack program to read config.local.json to decide if xcode
should run react-native bundle or not.
*/

// XXX: Default config.json ?
var config = {
  "react-native": { type: "bundle" }
};

try {
  var config = require('../config.local.json')
} catch(e) {}

if (!config['react-native'] || config["react-native"].type === "bundle") {
  process.exit(0);
} else {
  process.exit(1);
}
