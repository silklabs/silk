#!/bin/bash -e

if [[ -n $1 ]]; then
  GONK=$1
fi

if [[ -z $GONK ]]; then
  echo Error: GONK not specified
  echo
  echo "usage: $0 <GONK>"
  echo
  exit 1
fi

set -x
rm -rf silk-device
git clone ssh://git@github.com/silklabs/silk-device.git
make -C silk-device repocache.$GONK

mkdir -p deploy/repocache
mv silk-device/repocache*tgz deploy/repocache
exit 0
