{
  "name": "silk-core",
  "version": "0.0.1",
  "description": "The common control software on each silk node",
  "main": "dist/lib/main.js",
  "scripts": {
    "install": "node_modules/.bin/grunt && echo '[browserify]' && node_modules/.bin/browserify --node --ignore-missing dist/lib/main.js -o core.js",
    "start": "node dist/lib/main.js"
  },
  "dependencies": {
    "silk-alog": "file:modules/alog",
    "bleno": "file:modules/bleno",
    "debug": "2.2.0",
    "silk-gc1": "file:modules/gc1",
    "silk-movie": "file:modules/movie",
    "mz": "2.0.0",
    "node-hue-api": "1.0.5",
    "ntp-client": "0.5.3",
    "request": "2.58.0",
    "silk-api": "file:modules/silk-api/dist/api",
    "socket.io-client": "^1.3.5",
    "validator": "3.41.2"
  },
  "devDependencies": {
    "babel-eslint": "~3.1.15",
    "browserify": "^10.2.1",
    "eslint": "~0.22.1",
    "grunt": "^0.4.5",
    "grunt-babel": "^5.0.0",
    "grunt-cli": "^0.1.13",
    "grunt-eslint": "~14.0.0",
    "load-grunt-tasks": "^3.1.0"
  },
  "eslintConfig": {
    "parser": "babel-eslint",
    "rules": {
      "brace-style": 2,
      "no-debugger": 1,
      "default-case": 2,
      "comma-dangle": 0,
      "indent": [2, 2],
      "no-underscore-dangle": 0,
      "quotes": [
        2,
        "single",
        "avoid-escape"
      ],
      "yoda": 0
    },
    "env": {
      "node": true,
      "es6": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:silklabs/silk-device.git"
  },
  "keywords": [
    "iot"
  ],
  "engines": {
    "node" : "0.12.2"
  },
  "private": true
}
