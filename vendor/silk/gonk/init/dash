#!/system/bin/sh
#
# Brief system state dashboard.
#

echo -n "   Date: "; date
uptime
echo -n "  Build: "; getprop ro.build.fingerprint
echo

echo Battery:
echo "\tCapacity: $(cat /sys/class/power_supply/battery/capacity)%"
echo "\tStatus: $(cat /sys/class/power_supply/battery/status) $(cat /sys/class/power_supply/battery/charge_type)"
echo "\tCurrent (Now): $(cat /sys/class/power_supply/battery/current_now)uA"
echo "\tUSB Max Current: $(cat /sys/class/power_supply/usb/current_max)mA"
echo

echo CPU Info:
cd /sys/devices/system/cpu/
for cpu in cpu[0-8]; do
  online=$(cat $cpu/online)
  if [ $online == 1 ]; then
    currfreq=$(cat $cpu/cpufreq/scaling_cur_freq 2> /dev/null || echo ?)
    maxfreq=$(cat $cpu/cpufreq/scaling_max_freq 2> /dev/null || echo ?)
    echo "\t$cpu: $currfreq KHz (max: $maxfreq KHz)"
  else
    echo "\t$cpu: offline"
  fi
done
echo

echo Thermal Info:
cd /sys/class/thermal/
for zone in thermal_zone*; do
  type=$(cat $zone/type)
  temp=$(cat $zone/temp)
  mode=$(cat $zone/mode 2> /dev/null || echo enabled)
  if [ $mode == enabled ]; then
    if [ $temp -gt 200 ]; then
      echo "\t$type: $temp m°C"
    else
      echo "\t$type: $temp °C"
    fi
  fi
done
echo

echo System Properties:
getprop | grep ro.silk
getprop | grep persist.silk
echo

df
echo
