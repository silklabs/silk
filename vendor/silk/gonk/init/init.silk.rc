
on init
    # Forge a module at the root as a fallback if node-bindings fails to locate
    # the root directory of a module
    symlink /system/silk/build build
    write /package.json {}

service gonksched /system/bin/gonksched
    class main
    user root

service fakeappops /system/bin/fakeappops
    class main
    user root

service silk /system/bin/silk
    class main
    user root

service volume /system/bin/volume
    class main
    user audio
    group audio
    oneshot

service wpad /system/bin/wpad
    class main
    user system
    group wifi system
    socket wpad stream 0600 root root

