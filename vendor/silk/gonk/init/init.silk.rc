on init
    # Can't augment existing env vars, so set everything here
    export PATH /sbin:/vendor/bin:/system/sbin:/system/bin:/system/xbin:/system/silk/bin
    export LD_LIBRARY_PATH /system/lib:/system/silk/lib
    export NODE_PATH /system/silk/node_modules

service gonksched /system/silk/bin/gonksched
    class main
    user root

service fakeappops /system/silk/bin/fakeappops
    class main
    user root

service silk /system/silk/bin/silk
    class main
    user root
    # The bledroid and silk-sensors services are useless without the
    # silk service, so we don't bother keeping them running reliably
    # on their own.  The capture service, on the other hand, must be
    # strictly more stable than silk, so we ensure that either silk or
    # capture can die and the other can recover gracefully.
    onrestart restart bledroid
    onrestart restart silk-sensors

service volume /system/silk/bin/volume
    class main
    user audio
    group audio
    oneshot

service wpad /system/silk/bin/wpad
    class main
    user system
    group wifi system
    socket wpad stream 0600 root root

service bledroid /system/silk/bin/bledroid
    class main
    user bluetooth
    group net_bt_stack
    socket bledroid stream 0600 root root

service silk-sensors /system/silk/bin/silk-sensors
    class main
    user root
    group root
    socket sensors stream 0600 root root

service capture /system/silk/bin/capture
    class main
    user graphics
    group camera
    socket capturectl stream 0600 root root
    socket captured stream 0600 root root

