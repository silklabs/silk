service gonksched /system/bin/gonksched
    class main
    user root

service fakeappops /system/bin/fakeappops
    class main
    user root

service silk /system/bin/silk
    class main
    user root

service volume /system/bin/volume
    class main
    user audio
    group audio
    oneshot

service wpad /system/bin/wpad
    class main
    user system
    group wifi system
    socket wpad stream 0600 root root

service bledroid /system/bin/bledroid
    class main
    user bluetooth
    group net_bt_stack
    socket bledroid stream 0600 root root

service silk-sensors /system/bin/silk-sensors
    class main
    user root
    group root
    socket sensors stream 0600 root root

service capture /system/bin/capture
    class main
    user graphics
    group camera
    socket capturectl stream 0600 root root
    socket captured stream 0600 root root
