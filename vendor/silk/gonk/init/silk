#!/system/bin/sh

export NODE_ENV="production"
export DEBUG=$(getprop persist.silk.debug)
export DEBUG_COLORS=$(getprop persist.silk.debug.colors)

NODE=/system/silk/bin/node
if [ ! -x $NODE ]; then
  NODE=/system/silk/bin/iojs
  if [ ! -x $NODE ]; then
    log -p i -t silk-init Node engine not found.
    exit 1
  fi
fi

NODE_ARGS="--harmony"
if [ "$1" = "--debug-brk" ]; then
  NODE_ARGS="$NODE_ARGS $1"
  shift
fi

if [ "$(getprop ro.debuggable)" = "1" ]; then
  NODE_ARGS="$NODE_ARGS --debug"
fi

if [ -z $1 ]; then
  log -p i -t silk-init Starting Silk services

  # Feign sys.boot_completed for the benefit of other Gonk components that
  # listen on it.
  setprop sys.boot_completed 1

  export LOGWRAPPER=
  if [ $PPID -eq 1 ]; then
    LOGWRAPPER=logwrapper
  fi

  exec $LOGWRAPPER $NODE $NODE_ARGS /system/silk/core.js
  exit 1
fi

exec $NODE $NODE_ARGS "$@"
