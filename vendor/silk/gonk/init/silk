#!/system/bin/sh

export NODE_ENV="production"
export DEBUG=$(getprop persist.silk.debug)
export DEBUG_COLORS=$(getprop persist.silk.debug.colors)
export UV_THREADPOOL_SIZE=32

info() {
  log -p i -t silk-init $@
}

NODE=/system/silk/bin/node
if [ ! -x $NODE ]; then
  info Node engine not found.
  exit 1
fi

if [ "$(getprop ro.debuggable)" == "1" ]; then
  if [ "$(getprop persist.silk.coredump)" == "1" ]; then
    if [ ! -d /data/core ]; then
      mkdir /data/core
      chmod 0733 /data/core
      chown root:root /data/core
    fi
    echo "/data/core/%e.%p.%t.core" > /proc/sys/kernel/core_pattern
    echo "1" > /proc/sys/fs/suid_dumpable
    prlimit $BASHPID 4 -1 -1 # RLIMIT_CORE = 4

    info Core dump enabled
  fi
fi

NODE_ARGS="--harmony"
if [ "$1" = "--debug-brk" ]; then
  NODE_ARGS="$NODE_ARGS $1"
  shift
fi

if [ -z $1 ]; then
  info Starting Silk services

  if [ "$(getprop ro.debuggable)" = "1" ]; then
    NODE_ARGS="$NODE_ARGS --debug"
  fi

  # Feign sys.boot_completed for the benefit of other Gonk components that
  # listen on it.
  setprop sys.boot_completed 1

  export LOGWRAPPER=
  if [ $PPID -eq 1 ]; then
    LOGWRAPPER="logwrapper -d"
  fi

  exec $LOGWRAPPER $NODE $NODE_ARGS /system/silk/core.js
  exit 1
fi

exec $NODE $NODE_ARGS "$@"
