{
  "parser": "babel-eslint",
  "rules": {
    "brace-style": 2,
    "no-debugger": 1,
    "default-case": 2,
    "comma-dangle": 0,
    "indent": [
      2,
      2
    ],
    "no-underscore-dangle": 0,
    "strict": false,
    "quotes": [
      2,
      "single",
      "avoid-escape"
    ],
    "yoda": 0
  },
  "env": {
    "node": true,
    "es6": true
  }
}

