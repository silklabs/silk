{
  "parser": "babel-eslint",
  "globals": {
    "suite": true,
    "test": true,
    "setup": true,
    "teardown": true,
    "suiteSetup": true,
    "suiteTeardown": true,
    "it": true,
    "describe": true,
  },
  "rules": {
    "brace-style": 2,
    "no-debugger": 1,
    "default-case": 2,
    "comma-dangle": 0,
    "indent": [
      2,
      2
    ],
    "no-underscore-dangle": 0,
    "strict": false,
    "quotes": [
      2,
      "single",
      "avoid-escape"
    ],
    "yoda": 0
  },
  "env": {
    "node": true,
    "es6": true
  }
}

