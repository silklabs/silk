set -e
__readlink() {
  if [ $(uname) = Darwin ]; then
    # Can't assume GNU readlink is available
    if [ -h $1 ]; then
      readlink $1;
    else
      echo $1
    fi
  else
    readlink -f $1
  fi
}
LOCAL_PATH=$(dirname $(__readlink $0))

if [[ ! -d $LOCAL_PATH/tools/debugger/node_modules ]]; then
  echo Installing debugger.  Your estimated wait time is 5 minutes...
  ( set -ex; cd $LOCAL_PATH/tools/debugger; time npm install --loglevel http )
fi

exec $LOCAL_PATH/tools/debugger/debugger $@
