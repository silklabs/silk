#!/bin/bash

if [[ -f dist/index.json ]]; then
  exit 0;
fi

mkdir -p dist
cat > dist/index.json <<-EOF
	{
	  "branch": "$(source branch; echo $BRANCH)",
	  "buildtime": "$(node -p "Date.now()")",
	  "semver": "$(node -p "require('./package.json').version")",
	  "sha": "$(git rev-parse HEAD)"
	}
EOF
