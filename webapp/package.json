{
  "dependencies": {
    "Chart.StackedBar.js": "git@github.com:Regaddi/Chart.StackedBar.js.git#63eb91092266ac16a20bda28cc9ba5c80415513d",
    "ansi_up": "^1.3.0",
    "babel": "^5.8.9",
    "babel-core": "^5.8.23",
    "babel-eslint": "~3.1.15",
    "babel-loader": "^5.3.2",
    "babel-runtime": "^5.8.20",
    "babelify": "^6.1.3",
    "chart.js": "^1.0.2",
    "debug": "^2.2.0",
    "eslint": "^0.22.1",
    "eslint-plugin-react": "~3.6.3",
    "event-to-promise": "^0.4.0",
    "express": "^4.12.3",
    "json-loader": "^0.5.2",
    "localforage": "^1.2.10",
    "lodash.merge": "^3.3.2",
    "log": "../log",
    "ms": "^0.7.1",
    "pbkdf2": "^3.0.4",
    "react": "^0.13.3",
    "react-bootstrap": "^0.25.1",
    "react-chartjs": "^0.6.0",
    "react-iframe": "^0.0.2",
    "react-router": "^1.0.0-rc1",
    "script-loader": "^0.6.1",
    "silk-api": "git@github.com:silklabs/silk-api-node.git#master",
    "sjcl": "^1.0.3",
    "socket.io-client": "^1.3.6",
    "source-map-support": "^0.3.2",
    "text-encoding": "^0.5.2",
    "webpack": "^1.12.1",
    "whatwg-fetch": "^0.9.0"
  },
  "description": "Silk web app",
  "devDependencies": {
    "webpack-dev-server": "^1.10.1",
    "webpack-hot-middleware": "^2.0.0"
  },
  "engineStrict": true,
  "engines": {
    "node": "^4.1.2",
    "npm": "^2.1.0"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es6": true,
      "node": true
    },
    "globals": {
      "MediaSource": true,
      "document": true,
      "setup": true,
      "suite": true,
      "suiteSetup": true,
      "suiteTeardown": true,
      "teardown": true,
      "test": true
    },
    "parser": "babel-eslint",
    "plugins": [
      "react"
    ],
    "rules": {
      "brace-style": 2,
      "comma-dangle": [
        1,
        "always-multiline"
      ],
      "default-case": 2,
      "indent": [
        2,
        2
      ],
      "no-debugger": 1,
      "no-shadow": 0,
      "no-underscore-dangle": 0,
      "no-unused-expressions": 0,
      "no-unused-vars": [
        2,
        {
          "args": "none",
          "vars": "all"
        }
      ],
      "no-use-before-define": 0,
      "quotes": [
        2,
        "single",
        "avoid-escape"
      ],
      "react/jsx-closing-bracket-location": [
        1,
        {
          "nonEmpty": "after-props",
          "selfClosing": "tag-aligned"
        }
      ],
      "react/jsx-indent-props": [
        2,
        2
      ],
      "react/jsx-quotes": [
        2,
        "double"
      ],
      "strict": false,
      "yoda": 0
    }
  },
  "keywords": [
    "iot"
  ],
  "license": "proprietary",
  "name": "silk-webapp",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:silklabs/silk-webapp.git"
  },
  "scripts": {
    "lint": "eslint src",
    "postinstall": "cd node_modules/eslint && npm i escope@3.2.0 && cd ../.. && ./tools/patch && webpack --progress",
    "start": "webpack-dev-server --host 0.0.0.0 --port 8080 --progress --hot --inline --watch-poll --watch-aggregate-timeout 300",
    "start-server": "babel-node --harmony server/main.js production",
    "test": "npm run-script lint"
  },
  "version": "0.0.1"
}
